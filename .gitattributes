# rexglue codegen rewrites the manifest with LF endings on every run.
*.manifest.toml text eol=lf

*.sh text eol=lf
# The runtime patches are applied with git apply.
patches/rexglue-sdk/* text eol=lf
patches/trg-launcher/* text eol=lf

# Linux packaging runs on Linux; line endings must stay LF.
packaging/linux/* text eol=lf
patches/appimage-runtime/* text eol=lf
patches/**/*.patch -whitespace
src/updater/third_party/** -whitespace
