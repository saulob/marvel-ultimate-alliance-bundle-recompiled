+// Xenos float16 as in rex::float_to_xenos_half: no denormals, truncated, saturated at 0x47FFE000.
+static void emit_float16_lane(BuilderContext& ctx, const std::string& dst, size_t dstIdx,
+                              const std::string& src, size_t srcIdx) {
+  ctx.println("\t{}.u32 = {}.u32[{}] & 0x7FFFFFFF;", ctx.temp(), src, srcIdx);
+  ctx.println(
+      "\t{}.u16[{}] = uint16_t((({}.u32 >= 0x47FFE000u) ? 0x7FFFu : (({}.u32 < 0x38800000u) ? 0u : "
+      "((({}.u32 + 0xC8000000u) >> 13) & 0x7FFFu))) | (({}.u32[{}] & 0x80000000u) >> 16));",
+      dst, dstIdx, ctx.temp(), ctx.temp(), ctx.temp(), src, srcIdx);
+}
