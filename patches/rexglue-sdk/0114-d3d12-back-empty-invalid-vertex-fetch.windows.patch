Adapted from TheSimpsonsGameRecomp 09f4da27 (the D3D12 vfetch_request_size hunk; its invalid-fetch classifier is replaced by the fetch constant type, since gpu_allow_invalid_fetch_constants admits exactly the invalid-type constants): a size-0 vertex fetch of an admitted invalid constant still makes the shader read at its address (0 for an absent optional stream), which tiled shared memory does not back, so 4 KB there are requested. Reading unmapped tiles is undefined on Tiled Resources Tier 1 and hung AMD GPUs in that game.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 1369e5d..77920d5 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2852,11 +2852,17 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
                       vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1);
           return false;
       }
-      if (!shared_memory_->RequestRange(vfetch_constant.address << 2, vfetch_constant.size << 2)) {
+      uint32_t vfetch_request_size = vfetch_constant.size << 2;
+      if (!vfetch_request_size && vfetch_constant.type == xenos::FetchConstantType::kInvalidVertex) {
+        // An absent optional stream the shader may still read, at guest address 0, where tiled
+        // shared memory has nothing mapped (undefined on Tiled Resources Tier 1: GPU hangs).
+        vfetch_request_size = 4096;
+      }
+      if (!shared_memory_->RequestRange(vfetch_constant.address << 2, vfetch_request_size)) {
         REXGPU_ERROR(
             "Failed to request vertex buffer at 0x{:08X} (size {}) in the "
             "shared memory",
-            vfetch_constant.address << 2, vfetch_constant.size << 2);
+            vfetch_constant.address << 2, vfetch_request_size);
         return false;
       }
       vertex_buffers_resident[vfetch_index >> 6] |= vfetch_bit;
