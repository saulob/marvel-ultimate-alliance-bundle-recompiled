-enum class Bottleneck { kUnknown, kCommandProcessor, kGpu, kSynchronization, kMixed };
+enum class Bottleneck { kUnknown, kCommandProcessor, kGpu, kSynchronization, kGuestThread, kMixed };
+
+constexpr std::array<rex::perf::CounterId, 4> kGuestFrameCounters = {
+    rex::perf::CounterId::kGuestUpdateNs, rex::perf::CounterId::kGuestUpdates,
+    rex::perf::CounterId::kGuestLimiterWaitNs, rex::perf::CounterId::kGuestFenceWaitNs};
+
+std::array<int64_t, 4> ReadGuestFrameTotals() {
+  std::array<int64_t, 4> totals{};
+  for (size_t i = 0; i < totals.size(); ++i) {
+    totals[i] = rex::perf::GetCounter(kGuestFrameCounters[i]);
+  }
+  return totals;
+}
+
+// Per swap, from the title's host code; absent when it publishes no world updates.
+struct GuestFrame {
+  bool available = false;
+  double updates_per_swap = 0.0;
+  double update_ms = 0.0;
+  double limiter_wait_ms = 0.0;
+  double fence_wait_ms = 0.0;
+};
 
