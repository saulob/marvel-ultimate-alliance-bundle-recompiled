+std::string GuestFrameText(const GuestFrame& guest, double swaps_per_second) {
+  if (!guest.available) {
+    return "world update n/a";
+  }
+  return fmt::format("world update {:.2f} ms ({:.0f}/s) | limiter wait {:.2f} ms | guest fence wait {:.2f} ms",
+                     guest.update_ms, guest.updates_per_swap * swaps_per_second, guest.limiter_wait_ms,
+                     guest.fence_wait_ms);
+}
