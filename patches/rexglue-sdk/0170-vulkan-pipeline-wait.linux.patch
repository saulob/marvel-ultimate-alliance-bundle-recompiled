+bool VulkanPipelineCache::WaitForPipeline(void* handle, int64_t& budget_us) const {
+  const Pipeline* pipeline = reinterpret_cast<const Pipeline*>(handle);
+  const auto start = std::chrono::steady_clock::now();
+  auto spent_us = [&] {
+    return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                                 start)
+        .count();
+  };
+  // A placeholder stays until the real pipeline replaces it, or until its creation fails.
+  while (pipeline->is_placeholder.load(std::memory_order_acquire)) {
+    if (pipeline->pipeline.load(std::memory_order_acquire) == VK_NULL_HANDLE ||
+        spent_us() >= budget_us) {
+      budget_us = std::max(budget_us - spent_us(), int64_t(0));
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::microseconds(100));
+  }
+  budget_us = std::max(budget_us - spent_us(), int64_t(0));
+  return pipeline->pipeline.load(std::memory_order_acquire) != VK_NULL_HANDLE;
+}
