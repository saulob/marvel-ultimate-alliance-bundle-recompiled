+// The player's choice for this program in the Windows graphics settings: 1 power saving, 2 high
+// performance, 0 if none.
+uint32_t GetUserGpuPreference() {
+  wchar_t path[1024];
+  DWORD path_length = GetModuleFileNameW(nullptr, path, DWORD(std::size(path)));
+  if (!path_length || path_length >= std::size(path)) {
+    return 0;
+  }
+  wchar_t value[256];
+  DWORD value_size = sizeof(value);
+  if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\DirectX\\UserGpuPreferences", path,
+                   RRF_RT_REG_SZ, nullptr, value, &value_size) != ERROR_SUCCESS) {
+    return 0;
+  }
+  const wchar_t* preference = wcsstr(value, L"GpuPreference=");
+  return preference ? uint32_t(wcstoul(preference + 14, nullptr, 10)) : 0;
+}
+
