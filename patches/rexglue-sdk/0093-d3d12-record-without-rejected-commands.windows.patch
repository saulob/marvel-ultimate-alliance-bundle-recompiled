+bool D3D12CommandProcessor::RecordWithoutRejectedCommands(
+    ID3D12CommandAllocator* command_allocator, DeferredCommandList& commands, uint64_t submission,
+    HRESULT close_result) {
+  constexpr size_t kMaxRejectedCommands = 16;
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  std::vector<size_t> rejected;
+  auto record = [&](size_t command_limit,
+                    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList>& list) -> bool {
+    command_allocator->Reset();
+    if (FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, command_allocator,
+                                         nullptr, IID_PPV_ARGS(&list)))) {
+      return false;
+    }
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList1> list_1;
+    list.As(&list_1);
+    commands.Execute(list.Get(), list_1.Get(), command_limit, &rejected);
+    return SUCCEEDED(list->Close());
+  };
+  auto closes = [&](size_t command_limit) {
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> list;
+    return record(command_limit, list);
+  };
+
+  const size_t command_count = commands.GetCommandCount();
+  bool found = true;
+  while (!closes(command_count)) {
+    if (rejected.size() == kMaxRejectedCommands) {
+      found = false;
+      break;
+    }
+    // The shortest prefix that doesn't close ends with the next rejected call.
+    size_t closing = rejected.empty() ? 0 : rejected.back() + 1;
+    size_t failing = command_count;
+    while (failing - closing > 1) {
+      const size_t middle = closing + (failing - closing) / 2;
+      (closes(middle) ? closing : failing) = middle;
+    }
+    rejected.push_back(failing - 1);
+  }
+
+  static std::atomic<uint32_t> rejections{0};
+  const uint32_t rejection = rejections.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (rejection <= 4 || (rejection & (rejection - 1)) == 0) {
+    REXGPU_ERROR(
+        "D3D12 submission {}: the command list failed to close (HRESULT 0x{:08X}, {} time(s) so "
+        "far), {}",
+        submission, static_cast<unsigned>(close_result), rejection,
+        found ? "recorded again without the calls the runtime rejected:"
+              : "more calls were rejected than searched for, the submission is dropped:");
+    for (size_t index : rejected) {
+      REXGPU_ERROR("  command {} of {}:{}", index, command_count, commands.DescribeCommand(index));
+    }
+  }
+
+  // The failed list can't be reset again, so a new one takes its place.
+  Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> list;
+  bool recorded = found && record(SIZE_MAX, list);
+  if (!recorded) {
+    list.Reset();
+    if (FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, command_allocator,
+                                         nullptr, IID_PPV_ARGS(&list)))) {
+      REXGPU_ERROR("D3D12 submission {}: failed to create a new command list", submission);
+      return false;
+    }
+    list->Close();
+  }
+  list->SetName(L"Xenos submission");
+  ui::d3d12::util::ReleaseAndNull(command_list_1_);
+  ui::d3d12::util::ReleaseAndNull(command_list_);
+  command_list_ = list.Detach();
+  command_list_->QueryInterface(IID_PPV_ARGS(&command_list_1_));
+  return recorded;
+}
