+size_t DeferredCommandList::GetCommandCount() const {
+  size_t count = 0;
+  for (size_t offset = 0; offset + kCommandHeaderSizeElements <= command_stream_.size(); ++count) {
+    const CommandHeader& header =
+        *reinterpret_cast<const CommandHeader*>(command_stream_.data() + offset);
+    offset += kCommandHeaderSizeElements + header.arguments_size_elements;
+  }
+  return count;
+}
+
+std::string DeferredCommandList::DescribeCommand(size_t index) const {
+  size_t offset = 0;
+  for (size_t i = 0; i < index && offset + kCommandHeaderSizeElements <= command_stream_.size();
+       ++i) {
+    const CommandHeader& header =
+        *reinterpret_cast<const CommandHeader*>(command_stream_.data() + offset);
+    offset += kCommandHeaderSizeElements + header.arguments_size_elements;
+  }
+  if (offset + kCommandHeaderSizeElements > command_stream_.size()) {
+    return "(no such command)";
+  }
+  return DescribeEntries({command_stream_.data() + offset});
+}
