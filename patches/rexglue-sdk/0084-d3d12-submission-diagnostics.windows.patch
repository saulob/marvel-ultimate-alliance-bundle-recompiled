+const char* CommandName(size_t command) {
+  static const char* const kNames[] = {
+      "ClearDSV",         "ClearRTV",         "ClearUAVUint",     "CopyBufferRegion",
+      "CopyResource",     "CopyTexture",      "CopyTextureRegion", "Dispatch",
+      "DrawIndexed",      "Draw",             "BeginQuery",       "EndQuery",
+      "ResolveQueryData", "SetIndexBuffer",   "SetTopology",      "SetVertexBuffers",
+      "SetBlendFactor",   "SetRenderTargets", "SetStencilRef",    "ResourceBarrier",
+      "SetScissor",       "SetViewport",      "SetComputeRoot32", "SetGraphicsRoot32",
+      "SetComputeCBV",    "SetGraphicsCBV",   "SetComputeTable",  "SetGraphicsTable",
+      "SetComputeSRV",    "SetGraphicsSRV",   "SetComputeRootSig", "SetGraphicsRootSig",
+      "SetComputeUAV",    "SetGraphicsUAV",   "SetDescriptorHeaps", "SetPipeline",
+      "SetPipelineHandle", "SetSamplePositions", "BeginMarker",   "EndMarker",
+      "Marker"};
+  return command < sizeof(kNames) / sizeof(kNames[0]) ? kNames[command] : "Unknown";
+}
+
+std::string ResourceText(ID3D12Resource* resource) {
+  if (!resource) {
+    return "null";
+  }
+  const D3D12_RESOURCE_DESC desc = resource->GetDesc();
+  char text[160];
+  std::snprintf(text, sizeof(text), "%s %llux%ux%u mips %u fmt %u flags 0x%X",
+                desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER ? "buffer" : "texture",
+                static_cast<unsigned long long>(desc.Width), desc.Height, desc.DepthOrArraySize,
+                desc.MipLevels, unsigned(desc.Format), unsigned(desc.Flags));
+  return text;
+}
+
+std::string CopyLocationText(const D3D12_TEXTURE_COPY_LOCATION& location) {
+  char text[96];
+  if (location.Type == D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT) {
+    const D3D12_PLACED_SUBRESOURCE_FOOTPRINT& footprint = location.PlacedFootprint;
+    std::snprintf(text, sizeof(text), "[footprint +%llu %ux%ux%u pitch %u fmt %u]",
+                  static_cast<unsigned long long>(footprint.Offset), footprint.Footprint.Width,
+                  footprint.Footprint.Height, footprint.Footprint.Depth, footprint.Footprint.RowPitch,
+                  unsigned(footprint.Footprint.Format));
+  } else {
+    std::snprintf(text, sizeof(text), "[subresource %u]", location.SubresourceIndex);
+  }
+  return ResourceText(location.pResource) + " " + text;
+}
+
