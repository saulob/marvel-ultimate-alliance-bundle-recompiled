+// DEBUG_SAULO: closes and executes one submission. The recording errors the D3D12 runtime detects
+// make Close fail, and executing such a list removes the device with INVALID_CALL - so it is left
+// out, and logged with what it holds. A removal the queue reports right after the execute is logged
+// with the submission that raised it.
+void D3D12CommandProcessor::ExecuteSubmissionCommands(ID3D12CommandAllocator* command_allocator,
+                                                      DeferredCommandList& commands,
+                                                      uint64_t submission) {
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  command_allocator->Reset();
+  command_list_->Reset(command_allocator, nullptr);
+  commands.Execute(command_list_, command_list_1_);
+  const HRESULT close_result = command_list_->Close();
+  if (FAILED(close_result)) {
+    static std::atomic<uint32_t> close_failures{0};
+    const uint32_t failure = close_failures.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (failure == 1) {
+      REXGPU_ERROR(
+          "D3D12 submission {}: the command list failed to close (HRESULT 0x{:08X}) and was not "
+          "executed, {}",
+          submission, static_cast<unsigned>(close_result), commands.Describe(32));
+    } else if ((failure & (failure - 1)) == 0) {
+      REXGPU_ERROR("D3D12 submission {}: {} command lists failed to close so far (HRESULT 0x{:08X})",
+                   submission, failure, static_cast<unsigned>(close_result));
+    }
+    return;
+  }
+  ID3D12CommandList* execute_command_lists[] = {command_list_};
+  provider.GetDirectQueue()->ExecuteCommandLists(1, execute_command_lists);
+  const HRESULT removed_reason = provider.GetDevice()->GetDeviceRemovedReason();
+  if (FAILED(removed_reason) && !submission_rejection_logged_.exchange(true)) {
+    REXGPU_ERROR("D3D12 submission {} removed the device (HRESULT 0x{:08X}), {}", submission,
+                 static_cast<unsigned>(removed_reason), commands.Describe(32));
   }
 }
 
