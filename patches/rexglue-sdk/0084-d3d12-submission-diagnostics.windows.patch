+std::string DeferredCommandList::Describe(size_t tail_commands) const {
+  constexpr size_t kCommandCount = size_t(Command::kInsertDebugMarker) + 1;
+  uint32_t counts[kCommandCount] = {};
+  std::vector<const uintmax_t*> tail;
+  const uintmax_t* stream = command_stream_.data();
+  size_t stream_remaining = command_stream_.size();
+  size_t total = 0;
+  while (stream_remaining >= kCommandHeaderSizeElements) {
+    const CommandHeader& header = *reinterpret_cast<const CommandHeader*>(stream);
+    const size_t command = size_t(header.command);
+    if (command < kCommandCount) {
+      ++counts[command];
+    }
+    ++total;
+    if (tail_commands) {
+      if (tail.size() == tail_commands) {
+        tail.erase(tail.begin());
+      }
+      tail.push_back(stream);
+    }
+    const size_t size = kCommandHeaderSizeElements + header.arguments_size_elements;
+    if (size > stream_remaining) {
+      break;
+    }
+    stream += size;
+    stream_remaining -= size;
+  }
+  std::string text = std::to_string(total) + " commands:";
+  for (size_t i = 0; i < kCommandCount; ++i) {
+    if (counts[i]) {
+      text += std::string(" ") + CommandName(i) + "=" + std::to_string(counts[i]);
+    }
+  }
+  char buffer[256];
+  for (const uintmax_t* entry : tail) {
+    const CommandHeader& header = *reinterpret_cast<const CommandHeader*>(entry);
+    const void* arguments = entry + kCommandHeaderSizeElements;
+    text += std::string("\n  ") + CommandName(size_t(header.command));
+    switch (header.command) {
+      case Command::kD3DDispatch: {
+        auto& args = *static_cast<const D3DDispatchArguments*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " groups %u,%u,%u", args.thread_group_count_x,
+                      args.thread_group_count_y, args.thread_group_count_z);
+        text += buffer;
+      } break;
+      case Command::kD3DDrawInstanced: {
+        auto& args = *static_cast<const D3DDrawInstancedArguments*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " vertices %u instances %u", args.vertex_count_per_instance,
+                      args.instance_count);
+        text += buffer;
+      } break;
+      case Command::kD3DDrawIndexedInstanced: {
+        auto& args = *static_cast<const D3DDrawIndexedInstancedArguments*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " indices %u instances %u", args.index_count_per_instance,
+                      args.instance_count);
+        text += buffer;
+      } break;
+      case Command::kRSSetScissorRect: {
+        auto& rect = *static_cast<const D3D12_RECT*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " %ld,%ld to %ld,%ld", rect.left, rect.top, rect.right,
+                      rect.bottom);
+        text += buffer;
+      } break;
+      case Command::kRSSetViewport: {
+        auto& viewport = *static_cast<const D3D12_VIEWPORT*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " %g,%g size %gx%g depth %g..%g", viewport.TopLeftX,
+                      viewport.TopLeftY, viewport.Width, viewport.Height, viewport.MinDepth,
+                      viewport.MaxDepth);
+        text += buffer;
+      } break;
+      case Command::kD3DCopyBufferRegion: {
+        auto& args = *static_cast<const D3DCopyBufferRegionArguments*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " dst +%llu src +%llu bytes %llu dst ",
+                      static_cast<unsigned long long>(args.dst_offset),
+                      static_cast<unsigned long long>(args.src_offset),
+                      static_cast<unsigned long long>(args.num_bytes));
+        text += buffer + ResourceText(args.dst_buffer) + " src " + ResourceText(args.src_buffer);
+      } break;
+      case Command::kD3DCopyResource: {
+        auto& args = *static_cast<const D3DCopyResourceArguments*>(arguments);
+        text += " dst " + ResourceText(args.dst_resource) + " src " + ResourceText(args.src_resource);
+      } break;
+      case Command::kCopyTexture: {
+        auto& args = *static_cast<const CopyTextureArguments*>(arguments);
+        text += " dst " + CopyLocationText(args.dst) + " src " + CopyLocationText(args.src);
+      } break;
+      case Command::kD3DCopyTextureRegion: {
+        auto& args = *static_cast<const D3DCopyTextureRegionArguments*>(arguments);
+        std::snprintf(buffer, sizeof(buffer), " at %u,%u,%u box ", args.dst_x, args.dst_y, args.dst_z);
+        text += buffer;
+        if (args.has_src_box) {
+          std::snprintf(buffer, sizeof(buffer), "%u,%u,%u to %u,%u,%u", args.src_box.left, args.src_box.top,
+                        args.src_box.front, args.src_box.right, args.src_box.bottom, args.src_box.back);
+          text += buffer;
+        } else {
+          text += "none";
+        }
+        text += " dst " + CopyLocationText(args.dst) + " src " + CopyLocationText(args.src);
+      } break;
+      case Command::kD3DResourceBarrier: {
+        const UINT count = *static_cast<const UINT*>(arguments);
+        const auto* barriers = reinterpret_cast<const D3D12_RESOURCE_BARRIER*>(
+            reinterpret_cast<const uint8_t*>(arguments) +
+            rex::align(sizeof(UINT), alignof(D3D12_RESOURCE_BARRIER)));
+        text += " count " + std::to_string(count);
+        for (UINT i = 0; i < count && i < 4; ++i) {
+          const D3D12_RESOURCE_BARRIER& barrier = barriers[i];
+          if (barrier.Type == D3D12_RESOURCE_BARRIER_TYPE_TRANSITION) {
+            std::snprintf(buffer, sizeof(buffer), " [transition sub %u 0x%X->0x%X ", barrier.Transition.Subresource,
+                          unsigned(barrier.Transition.StateBefore), unsigned(barrier.Transition.StateAfter));
+            text += buffer + ResourceText(barrier.Transition.pResource) + "]";
+          } else if (barrier.Type == D3D12_RESOURCE_BARRIER_TYPE_ALIASING) {
+            text += " [aliasing " + ResourceText(barrier.Aliasing.pResourceBefore) + " -> " +
+                    ResourceText(barrier.Aliasing.pResourceAfter) + "]";
+          } else {
+            text += " [uav " + ResourceText(barrier.UAV.pResource) + "]";
+          }
+        }
+      } break;
+      default:
+        break;
+    }
+  }
+  return text;
+}
