+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+template <size_t N>
+Tally* FindSlot(std::array<KeyedTally, N>& slots, uint64_t key) {
+  const size_t start = size_t((key * 0x9E3779B97F4A7C15ull) >> 40) % N;
+  for (size_t i = 0; i < N; ++i) {
+    KeyedTally& slot = slots[(start + i) % N];
+    uint64_t current = slot.key.load(std::memory_order_relaxed);
+    if (current == 0 && slot.key.compare_exchange_strong(current, key, std::memory_order_relaxed)) {
+      return &slot;
+    }
+    if (current == key) {
+      return &slot;
+    }
+  }
+  return nullptr;
+}
+
+void NoteGuestSectionWait(GlobalLockHolder holder, uint64_t ns, uintptr_t site) {
+  perf::IncrementCounter(perf::CounterId::kGuestLockWaits);
+  perf::IncrementCounter(perf::CounterId::kGuestLockWaitNs, int64_t(ns));
+  g_waits_by_holder[size_t(holder)].Add(ns);
+  const size_t bucket = size_t(std::upper_bound(kWaitBucketLimitsNs.begin(), kWaitBucketLimitsNs.end(), ns) -
+                               kWaitBucketLimitsNs.begin());
+  g_wait_buckets[bucket].fetch_add(1, std::memory_order_relaxed);
+  if (Tally* thread = FindSlot(g_thread_waits, current_thread_system_id())) {
+    thread->Add(ns);
+  }
+  if (Tally* where = FindSlot(g_site_waits, site)) {
+    where->Add(ns);
+  }
+}
+
+// Counted while still holding the region: the waiters it kept out, and for a guest section where it was entered.
+void NoteRelease(GlobalLockHolder holder, uintptr_t site) {
+  const int32_t waiters = g_guest_waiters.load(std::memory_order_relaxed);
+  if (waiters <= 0) {
+    return;
+  }
+  g_blocking_holds[size_t(holder)].Add(uint64_t(waiters));
+  if (site) {
+    if (Tally* where = FindSlot(g_blocking_sites, site)) {
+      where->Add(uint64_t(waiters));
+    }
+  }
+}
+
+struct TopEntry {
+  std::string name;
+  uint64_t count = 0;
+  uint64_t ns = 0;
+};
+
+template <size_t N>
+std::vector<std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> TakeKeyed(std::array<KeyedTally, N>& slots,
+                                                                          bool forget_keys = false) {
+  std::vector<std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> taken;
+  for (KeyedTally& slot : slots) {
+    const uint64_t key = forget_keys ? slot.key.exchange(0, std::memory_order_relaxed)
+                                     : slot.key.load(std::memory_order_relaxed);
+    const auto totals = slot.Take();
+    if (key && totals.first) {
+      taken.push_back({key, totals});
+    }
+  }
+  return taken;
+}
+
+std::string TopText(std::vector<TopEntry> entries, size_t limit, double frames, bool times) {
+  std::sort(entries.begin(), entries.end(), [](const TopEntry& a, const TopEntry& b) { return a.ns > b.ns; });
+  std::string text;
+  for (size_t i = 0; i < std::min(limit, entries.size()); ++i) {
+    text += times ? fmt::format("{}{} {:.1f} ({:.3f} ms)", i ? ", " : "", entries[i].name,
+                                double(entries[i].count) / frames, double(entries[i].ns) / 1e6 / frames)
+                  : fmt::format("{}{} {:.1f} ({:.1f} waiters)", i ? ", " : "", entries[i].name,
+                                double(entries[i].count) / frames, double(entries[i].ns) / frames);
+  }
+  return text.empty() ? "none" : text;
+}
+
+std::vector<TopEntry> GuestFunctions(std::vector<std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> sites,
+                                     const std::function<std::string(uintptr_t)>& describe_site) {
+  std::sort(sites.begin(), sites.end(), [](const auto& a, const auto& b) { return a.second.second > b.second.second; });
