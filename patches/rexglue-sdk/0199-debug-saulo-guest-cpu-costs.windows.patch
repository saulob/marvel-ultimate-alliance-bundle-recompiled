+    TopEntry& entry = functions[name];
+    entry.name = name;
+    entry.count += sites[i].second.first;
+    entry.ns += sites[i].second.second;
+  }
+  std::vector<TopEntry> list;
+  for (auto& [name, entry] : functions) {
+    list.push_back(entry);
+  }
+  return list;
+}
