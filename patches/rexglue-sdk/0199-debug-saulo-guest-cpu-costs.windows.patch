+std::vector<std::string> TakeGuestLockReport(double frames,
+                                             const std::function<std::string(uintptr_t)>& describe_site) {
+  static std::mutex report_mutex;
+  std::lock_guard report_lock(report_mutex);
+  std::string waits;
+  std::string holds;
+  std::string blocking;
+  for (size_t i = 0; i < kHolderKinds; ++i) {
+    const auto [count, ns] = g_waits_by_holder[i].Take();
+    waits += fmt::format("{}{} {:.1f} ({:.3f} ms)", i ? ", " : "", kHolderNames[i], double(count) / frames,
+                         double(ns) / 1e6 / frames);
+    const auto [hold_count, hold_ns] = g_holds[i].Take();
+    if (i >= size_t(GlobalLockHolder::kGpuInterrupt)) {
+      holds += fmt::format("{}{} {:.1f} ({:.3f} ms)", holds.empty() ? "" : ", ", kHolderNames[i],
+                           double(hold_count) / frames, double(hold_ns) / 1e6 / frames);
+    }
+    const auto [blocking_count, blocked_waiters] = g_blocking_holds[i].Take();
+    if (i != size_t(GlobalLockHolder::kUnlabeled)) {
+      blocking += fmt::format("{}{} {:.1f} ({:.1f} waiters)", blocking.empty() ? "" : ", ", kHolderNames[i],
+                              double(blocking_count) / frames, double(blocked_waiters) / frames);
+    }
+  }
+  std::string buckets;
+  for (size_t i = 0; i < g_wait_buckets.size(); ++i) {
+    const std::string limit = i < kWaitBucketLimitsNs.size()
+                                  ? fmt::format("<{}us", double(kWaitBucketLimitsNs[i]) / 1000.0)
+                                  : fmt::format(">={}us", double(kWaitBucketLimitsNs.back()) / 1000.0);
+    buckets += fmt::format("{}{} {:.1f}", i ? ", " : "", limit,
+                           double(g_wait_buckets[i].exchange(0, std::memory_order_relaxed)) / frames);
+  }
+
+  std::vector<TopEntry> threads;
+  for (const auto& [tid, totals] : TakeKeyed(g_thread_waits)) {
