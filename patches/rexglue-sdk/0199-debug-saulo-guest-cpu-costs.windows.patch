+// DEBUG_SAULO: who held the global critical region when a guest section waited, how long and where it waited, and
+// what write-watch faults cost.
+constexpr size_t kHolderKinds = size_t(GlobalLockHolder::kCount);
+constexpr std::array<const char*, kHolderKinds> kHolderNames = {"unlabeled", "guest section", "GPU interrupt",
+                                                                "write watch", "object lookup"};
