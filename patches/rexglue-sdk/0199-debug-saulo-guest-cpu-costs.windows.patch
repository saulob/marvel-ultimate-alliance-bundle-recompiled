+              " | host holds per frame: " + holds,
+          "DEBUG_SAULO guest lock waiting threads: " + TopText(threads, 4, frames, true) +
+              " | waiting guest functions: " + TopText(GuestFunctions(TakeKeyed(g_site_waits), describe_site), 8,
+                                                       frames, true),
+          "DEBUG_SAULO guest lock holders that kept guest sections waiting, per frame: " + blocking +
+              " | holding guest functions: " +
+              TopText(GuestFunctions(TakeKeyed(g_blocking_sites), describe_site), 8, frames, false),
+          fmt::format("DEBUG_SAULO write watch per frame: faults {:.1f}, waiting to enter {:.3f} ms, pages unprotected "
+                      "{:.1f}, already repaired {:.1f} | distinct faulted pages in the window {}",
