+std::array<Tally, kHolderKinds> g_holds;
+std::array<Tally, kHolderKinds> g_blocking_holds;
+std::array<std::atomic<uint64_t>, kWaitBucketLimitsNs.size() + 1> g_wait_buckets{};
+std::array<KeyedTally, 32> g_thread_waits;
+std::array<KeyedTally, 512> g_site_waits;
+std::array<KeyedTally, 512> g_blocking_sites;
