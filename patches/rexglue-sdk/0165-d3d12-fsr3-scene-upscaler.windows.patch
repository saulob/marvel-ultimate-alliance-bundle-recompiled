 }
 
+// scene_encode.cs.hlsl mode 3: the render-size position, in pixels, holding the scene alpha of an output pixel; the
+// scene was drawn moved by jitter render pixels.
+inline std::array<float, 2> SceneAlphaSourcePosition(uint32_t x, uint32_t y, const std::array<float, 2>& source_scale,
+                                                     const std::array<float, 2>& jitter,
+                                                     const std::array<float, 4>& source_clamp) {
+  return {std::clamp((float(x) + 0.5f) * source_scale[0] + jitter[0], source_clamp[0] + 0.5f, source_clamp[2] - 0.5f),
+          std::clamp((float(y) + 0.5f) * source_scale[1] + jitter[1], source_clamp[1] + 0.5f, source_clamp[3] - 0.5f)};
+}
+
+// AMD FSR 3.1's quality modes, FfxApiUpscaleQualityMode order: output size over render size along each axis.
+inline constexpr std::array<float, 5> kFsr3UpscaleRatios = {1.0f, 1.5f, 1.7f, 2.0f, 3.0f};
+
+// ffxFsr3UpscalerGetRenderResolutionFromQualityMode.
+inline uint32_t Fsr3RenderSize(uint32_t output_size, uint32_t quality_mode) {
+  const size_t mode = std::min<size_t>(quality_mode, kFsr3UpscaleRatios.size() - 1);
+  return uint32_t(float(output_size) / kFsr3UpscaleRatios[mode]);
+}
+
+// ffxFsr3UpscalerGetJitterPhaseCount; FSR 3.1 derives the same count from each dispatch's render and output widths.
+inline uint32_t Fsr3JitterPhaseCount(uint32_t render_width, uint32_t output_width) {
+  if (!render_width) {
+    return 8;
+  }
+  return std::max(uint32_t(8.0f * std::pow(double(float(output_width) / float(render_width)), 2.0)), uint32_t(1));
+}
+
+// The camera planes FSR 3.1 reconstructs view depth with: the view depths where the depth buffer holds its near and far
+// values (far is infinite when nothing reaches its value) and the vertical field of view in radians.
+struct CameraProjection {
+  double near_depth = 0.0;
+  double far_depth = 0.0;
+  double fov_y = 0.0;
+};
+
+// From an object-to-clip matrix whose clip w is the view depth and whose clip z mixes the w row with a constant, as a
+// perspective projection of any affine object-to-view transform gives (the y row is the field of view times the view
+// up row, which has the forward row's length when the object scale is uniform). z_scale and z_offset are the guest
+// viewport's; inverted when nearer surfaces have greater depth.
+inline std::optional<CameraProjection> CameraProjectionFor(const Matrix& m, double z_scale, double z_offset,
+                                                           bool inverted) {
+  const double w[3] = {m[12], m[13], m[14]};
+  const double w_length_squared = w[0] * w[0] + w[1] * w[1] + w[2] * w[2];
+  if (!(w_length_squared > 1.0e-12)) {
+    return std::nullopt;
+  }
+  const double a = (m[8] * w[0] + m[9] * w[1] + m[10] * w[2]) / w_length_squared;
+  const double z_rest[3] = {m[8] - a * w[0], m[9] - a * w[1], m[10] - a * w[2]};
+  if (z_rest[0] * z_rest[0] + z_rest[1] * z_rest[1] + z_rest[2] * z_rest[2] > 1.0e-6 * w_length_squared) {
+    return std::nullopt;
+  }
+  // Depth buffer value = alpha + beta / view depth.
+  const double alpha = z_scale * a + z_offset;
+  const double beta = z_scale * (m[11] - a * m[15]);
+  const auto depth_at = [&](double value) {
+    const double denominator = value - alpha;
+    return std::abs(denominator) < 1.0e-9 ? INFINITY : beta / denominator;
+  };
+  CameraProjection projection;
+  projection.near_depth = depth_at(inverted ? 1.0 : 0.0);
+  projection.far_depth = depth_at(inverted ? 0.0 : 1.0);
+  if (projection.far_depth < 0.0) {
+    projection.far_depth = INFINITY;
+  }
+  const double y_along_w = (m[4] * w[0] + m[5] * w[1] + m[6] * w[2]) / w_length_squared;
+  const double y[3] = {m[4] - y_along_w * w[0], m[5] - y_along_w * w[1], m[6] - y_along_w * w[2]};
+  const double focal = std::sqrt((y[0] * y[0] + y[1] * y[1] + y[2] * y[2]) / w_length_squared);
+  projection.fov_y = focal > 0.0 ? 2.0 * std::atan(1.0 / focal) : 0.0;
+  if (!(projection.near_depth > 0.0) || !std::isfinite(projection.near_depth) ||
+      !(projection.far_depth > projection.near_depth) || !(projection.fov_y > 0.0 && projection.fov_y < 3.1)) {
+    return std::nullopt;
+  }
+  return projection;
+}
+
+inline bool NearlyEqual(const CameraProjection& a, const CameraProjection& b) {
+  const auto close = [](double x, double y) {
+    return x == y || std::abs(x - y) <= 1.0e-3 * std::max(std::abs(x), std::abs(y));
+  };
+  return close(a.near_depth, b.near_depth) && close(a.far_depth, b.far_depth) && close(a.fov_y, b.fov_y);
+}
+
+// The projection most of the scene's draws share (sky domes and the like may use their own).
+inline std::optional<CameraProjection> ConsensusCameraProjection(const std::vector<CameraProjection>& projections) {
+  size_t best = SIZE_MAX;
+  size_t best_agreeing = 0;
+  for (size_t i = 0; i < projections.size(); ++i) {
+    size_t agreeing = 0;
+    for (const CameraProjection& other : projections) {
+      agreeing += NearlyEqual(projections[i], other);
+    }
+    if (agreeing > best_agreeing) {
+      best_agreeing = agreeing;
+      best = i;
+    }
+  }
+  return best == SIZE_MAX ? std::nullopt : std::optional<CameraProjection>(projections[best]);
+}
+
 }  // namespace rex::graphics::d3d12::scene
