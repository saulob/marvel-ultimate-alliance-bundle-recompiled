+void SceneUpscaler::EvaluateDlss(bool reset, const std::array<float, 2>& jitter) {
+  if (feature_recreate_ && feature_.handle) {
+    // The previous feature may still be in use by submitted command lists.
+    command_processor_.AwaitAllQueueOperationsCompletion();
+  }
+  EvaluateArgs args = {};
+  args.create = feature_recreate_;
+  args.feature_desc.struct_size = sizeof(args.feature_desc);
+  args.feature_desc.render_width = render_width_;
+  args.feature_desc.render_height = render_height_;
+  args.feature_desc.output_width = output_width_;
+  args.feature_desc.output_height = output_height_;
+  args.feature_desc.quality = quality_;
+  args.feature_desc.flags = REX_DLSS_FEATURE_MV_LOW_RES | (depth_inverted_ ? REX_DLSS_FEATURE_DEPTH_INVERTED : 0u);
+  args.feature_desc.preset = uint32_t(REXCVAR_GET(d3d12_dlss_preset));
+  RexDlssEvaluateDesc& evaluate = args.evaluate;
+  evaluate.struct_size = sizeof(evaluate);
+  evaluate.color = color_;
+  evaluate.depth = depth_;
+  evaluate.motion_vectors = motion_;
+  evaluate.output = output_;
+  evaluate.render_width = render_width_;
+  evaluate.render_height = render_height_;
+  evaluate.jitter_x = jitter[0];
+  evaluate.jitter_y = jitter[1];
+  evaluate.mv_scale_x = 1.0f;
+  evaluate.mv_scale_y = 1.0f;
+  evaluate.pre_exposure = 1.0f;
+  evaluate.reset = reset || feature_recreate_;
+  command_processor_.GetDeferredCommandList().ExternalCall(EvaluateOnCommandList, &feature_, &args, sizeof(args));
+  command_processor_.InvalidateCommandListState();
+  feature_recreate_ = false;
+}
+
+void SceneUpscaler::EvaluateFsr3(bool reset, const std::array<float, 2>& jitter) {
+  UpdateCameraProjection();
+  // The depth convention is part of the context.
+  const bool recreate = fsr3_recreate_ || fsr3_depth_inverted_ != depth_inverted_;
+  if (recreate && fsr3_context_requested_) {
+    // The previous context may still be in use by submitted command lists.
+    command_processor_.AwaitAllQueueOperationsCompletion();
+  }
+  const auto now = std::chrono::steady_clock::now();
+  float frame_time_ms = std::chrono::duration<float, std::milli>(now - last_upscale_time_).count();
+  last_upscale_time_ = now;
+  if (!(frame_time_ms > 0.0f && frame_time_ms <= 200.0f)) {
+    frame_time_ms = 1000.0f / 60.0f;
+  }
+  Fsr3Upscaler::RecordArgs args;
+  args.create = recreate;
+  args.create_desc.depth_inverted = depth_inverted_;
+  args.create_desc.max_render_width = render_width_;
+  args.create_desc.max_render_height = render_height_;
+  args.create_desc.output_width = output_width_;
+  args.create_desc.output_height = output_height_;
+  Fsr3Upscaler::Frame& frame = args.frame;
+  frame.color = color_;
+  frame.depth = depth_;
+  frame.motion = motion_;
+  frame.output = output_;
+  frame.render_width = render_width_;
+  frame.render_height = render_height_;
+  frame.output_width = output_width_;
+  frame.output_height = output_height_;
+  frame.jitter_x = jitter[0];
+  frame.jitter_y = jitter[1];
+  frame.sharpness = float(fsr3_sharpness_) / 100.0f;
+  frame.frame_time_ms = frame_time_ms;
+  // Until the game's projection is found.
+  const scene::CameraProjection camera = camera_projection_.value_or(scene::CameraProjection{0.1, INFINITY, 1.0});
+  frame.camera_near = float(camera.near_depth);
+  frame.camera_far = std::isfinite(camera.far_depth) ? float(camera.far_depth) : FLT_MAX;
+  frame.camera_fov_y = float(camera.fov_y);
+  frame.reset = reset || recreate;
+  command_processor_.GetDeferredCommandList().ExternalCall(Fsr3Upscaler::RecordOnCommandList, fsr3_.get(), &args,
+                                                           sizeof(args));
+  command_processor_.InvalidateCommandListState();
+  fsr3_recreate_ = false;
+  fsr3_context_requested_ = true;
+  fsr3_depth_inverted_ = depth_inverted_;
+}
+
+void SceneUpscaler::UpdateCameraProjection() {
+  std::vector<scene::CameraProjection> projections;
+  projections.reserve(std::min(matrices_.size(), kMaxProjectionSamples));
+  const double z_scale = guest_viewport_[4] != 0.0f ? guest_viewport_[4] : 1.0;
+  for (const auto& [key, matrix] : matrices_) {
+    if (projections.size() >= kMaxProjectionSamples) {
+      break;
+    }
+    if (const auto projection = scene::CameraProjectionFor(matrix, z_scale, guest_viewport_[5], depth_inverted_)) {
+      projections.push_back(*projection);
+    }
+  }
+  const std::optional<scene::CameraProjection> consensus = scene::ConsensusCameraProjection(projections);
+  if (consensus && !camera_projection_) {
+    REXGPU_INFO("FSR 3.1: camera from the game's projection | near {:.4g} | far {} | vertical field of view {:.1f} "
+                "degrees | depth {}",
+                consensus->near_depth,
+                std::isfinite(consensus->far_depth) ? fmt::format("{:.4g}", consensus->far_depth) : "infinite",
+                consensus->fov_y * 57.29577951308232, depth_inverted_ ? "1 near, 0 far" : "0 near, 1 far");
+  } else if (!consensus && !camera_projection_ && !camera_projection_missing_logged_) {
+    camera_projection_missing_logged_ = true;
+    REXGPU_INFO("FSR 3.1: no camera projection in this frame's draws yet, near 0.1 and an infinite far plane until "
+                "one is found");
+  }
+  if (consensus) {
+    camera_projection_ = consensus;
+  }
+}
