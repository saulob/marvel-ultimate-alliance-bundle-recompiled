--- /dev/null
+++ b/src/graphics/d3d12/fsr3_upscaler.cpp
@@ -0,0 +1,200 @@
+#include <rex/graphics/d3d12/fsr3_upscaler.h>
+
+#include <algorithm>
+#include <array>
+#include <cwchar>
+#include <string>
+#include <type_traits>
+
+#include <ffx_api/dx12/ffx_api_dx12.h>
+#include <ffx_api/ffx_api.h>
+#include <ffx_api/ffx_upscale.h>
+
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+
+namespace rex::graphics::d3d12 {
+
+namespace {
+
+constexpr uint32_t kMaxLoggedMessages = 32;
+std::atomic<uint32_t> logged_messages{0};
+
+void LogMessage(uint32_t type, const wchar_t* message) {
+  if (!message || logged_messages.fetch_add(1, std::memory_order_relaxed) >= kMaxLoggedMessages) {
+    return;
+  }
+  const int length = int(std::wcslen(message));
+  std::string text(size_t(WideCharToMultiByte(CP_UTF8, 0, message, length, nullptr, 0, nullptr, nullptr)), '\0');
+  WideCharToMultiByte(CP_UTF8, 0, message, length, text.data(), int(text.size()), nullptr, nullptr);
+  if (type == FFX_API_MESSAGE_TYPE_ERROR) {
+    REXGPU_ERROR("FSR 3.1: {}", text);
+  } else {
+    REXGPU_WARN("FSR 3.1: {}", text);
+  }
+}
+
+template <typename T>
+T* Entry(HMODULE module, const char* name) {
+  return reinterpret_cast<T*>(reinterpret_cast<void*>(GetProcAddress(module, name)));
+}
+
+}  // namespace
+
+bool Fsr3Upscaler::Load(const std::filesystem::path& dll, ID3D12Device* device) {
+  // Never unloaded: FidelityFX keeps its context's objects in it.
+  HMODULE module = LoadLibraryExW(dll.c_str(), nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+  if (!module) {
+    REXGPU_WARN("FSR 3.1: off, {} can't be loaded (error {})", rex::path_to_utf8(dll), uint32_t(GetLastError()));
+    return false;
+  }
+  auto* create_context = Entry<std::remove_pointer_t<PfnFfxCreateContext>>(module, "ffxCreateContext");
+  auto* destroy_context = Entry<std::remove_pointer_t<PfnFfxDestroyContext>>(module, "ffxDestroyContext");
+  auto* query = Entry<std::remove_pointer_t<PfnFfxQuery>>(module, "ffxQuery");
+  auto* dispatch = Entry<std::remove_pointer_t<PfnFfxDispatch>>(module, "ffxDispatch");
+  if (!create_context || !destroy_context || !query || !dispatch) {
+    REXGPU_WARN("FSR 3.1: off, {} is not AMD's FidelityFX API DLL", rex::path_to_utf8(dll));
+    return false;
+  }
+  device_ = device;
+  query_ = reinterpret_cast<void*>(query);
+  std::array<uint64_t, 8> ids = {};
+  std::array<const char*, 8> names = {};
+  uint64_t count = names.size();
+  ffxQueryDescGetVersions versions = {};
+  versions.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+  versions.createDescType = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+  versions.device = device;
+  versions.outputCount = &count;
+  versions.versionIds = ids.data();
+  versions.versionNames = names.data();
+  if (query(nullptr, &versions.header) != FFX_API_RETURN_OK || !count) {
+    REXGPU_WARN("FSR 3.1: off, {} offers no upscaler for this graphics card", rex::path_to_utf8(dll));
+    query_ = nullptr;
+    device_ = nullptr;
+    return false;
+  }
+  versions_.clear();
+  for (uint64_t i = 0; i < std::min<uint64_t>(count, names.size()); ++i) {
+    versions_ += (versions_.empty() ? "" : ", ") + std::string(names[i] ? names[i] : "?");
+  }
+  create_context_ = reinterpret_cast<void*>(create_context);
+  destroy_context_ = reinterpret_cast<void*>(destroy_context);
+  dispatch_ = reinterpret_cast<void*>(dispatch);
+  return true;
+}
+
+std::optional<std::pair<uint32_t, uint32_t>> Fsr3Upscaler::QueryRenderSize(uint32_t output_width,
+                                                                            uint32_t output_height,
+                                                                            Quality quality) const {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  ffxQueryDescUpscaleGetRenderResolutionFromQualityMode desc = {};
+  desc.header.type = FFX_API_QUERY_DESC_TYPE_UPSCALE_GETRENDERRESOLUTIONFROMQUALITYMODE;
+  desc.displayWidth = output_width;
+  desc.displayHeight = output_height;
+  desc.qualityMode = quality;
+  desc.pOutRenderWidth = &width;
+  desc.pOutRenderHeight = &height;
+  if (!query_ || reinterpret_cast<PfnFfxQuery>(query_)(nullptr, &desc.header) != FFX_API_RETURN_OK || !width ||
+      !height) {
+    return std::nullopt;
+  }
+  return std::make_pair(width, height);
+}
+
+std::optional<uint32_t> Fsr3Upscaler::QueryJitterPhaseCount(uint32_t render_width, uint32_t output_width) const {
+  int32_t phases = 0;
+  ffxQueryDescUpscaleGetJitterPhaseCount desc = {};
+  desc.header.type = FFX_API_QUERY_DESC_TYPE_UPSCALE_GETJITTERPHASECOUNT;
+  desc.renderWidth = render_width;
+  desc.displayWidth = output_width;
+  desc.pOutPhaseCount = &phases;
+  if (!query_ || reinterpret_cast<PfnFfxQuery>(query_)(nullptr, &desc.header) != FFX_API_RETURN_OK || phases <= 0) {
+    return std::nullopt;
+  }
+  return uint32_t(phases);
+}
+
+bool Fsr3Upscaler::CreateContext(const CreateDesc& desc) {
+  DestroyContext();
+  ffxCreateBackendDX12Desc backend = {};
+  backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12;
+  backend.device = device_;
+  ffxCreateContextDescUpscale upscale = {};
+  upscale.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+  upscale.header.pNext = &backend.header;
+  upscale.flags = desc.depth_inverted ? FFX_UPSCALE_ENABLE_DEPTH_INVERTED : 0u;
+  upscale.maxRenderSize = {desc.max_render_width, desc.max_render_height};
+  upscale.maxUpscaleSize = {desc.output_width, desc.output_height};
+  upscale.fpMessage = LogMessage;
+  ffxContext context = nullptr;
+  const ffxReturnCode_t result =
+      reinterpret_cast<PfnFfxCreateContext>(create_context_)(&context, &upscale.header, nullptr);
+  if (result != FFX_API_RETURN_OK || !context) {
+    REXGPU_WARN("FSR 3.1: the upscaler context can't be created (FidelityFX error {})", result);
+    return false;
+  }
+  context_ = context;
+  ffxQueryGetProviderVersion provider = {};
+  provider.header.type = FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION;
+  reinterpret_cast<PfnFfxQuery>(query_)(&context, &provider.header);
+  REXGPU_INFO("FSR 3.1: upscaler context created | FidelityFX upscaler {} | max render {}x{} -> output {}x{} | depth "
+              "{}",
+              provider.versionName ? provider.versionName : "unknown", desc.max_render_width, desc.max_render_height,
+              desc.output_width, desc.output_height, desc.depth_inverted ? "inverted (1 near)" : "0 near, 1 far");
+  return true;
+}
+
+void Fsr3Upscaler::DestroyContext() {
+  if (context_) {
+    ffxContext context = context_;
+    reinterpret_cast<PfnFfxDestroyContext>(destroy_context_)(&context, nullptr);
+    context_ = nullptr;
+  }
+}
+
+void Fsr3Upscaler::RecordOnCommandList(void* upscaler, ID3D12GraphicsCommandList* command_list, const void* args) {
+  static_cast<Fsr3Upscaler*>(upscaler)->Record(command_list, *static_cast<const RecordArgs*>(args));
+}
+
+void Fsr3Upscaler::Record(ID3D12GraphicsCommandList* command_list, const RecordArgs& args) {
+  if (failed() || !loaded()) {
+    return;
+  }
+  if ((args.create || !context_) && !CreateContext(args.create_desc)) {
+    failed_.store(true, std::memory_order_relaxed);
+    return;
+  }
+  const Frame& frame = args.frame;
+  ffxDispatchDescUpscale desc = {};
+  desc.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+  desc.commandList = command_list;
+  desc.color = ffxApiGetResourceDX12(frame.color, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+  desc.depth = ffxApiGetResourceDX12(frame.depth, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+  desc.motionVectors = ffxApiGetResourceDX12(frame.motion, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+  desc.output = ffxApiGetResourceDX12(frame.output, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+  desc.jitterOffset = {frame.jitter_x, frame.jitter_y};
+  desc.motionVectorScale = {1.0f, 1.0f};
+  desc.renderSize = {frame.render_width, frame.render_height};
+  desc.upscaleSize = {frame.output_width, frame.output_height};
+  desc.enableSharpening = frame.sharpness > 0.0f;
+  desc.sharpness = frame.sharpness;
+  desc.frameTimeDelta = frame.frame_time_ms;
+  desc.preExposure = 1.0f;
+  desc.reset = frame.reset;
+  desc.cameraNear = frame.camera_near;
+  desc.cameraFar = frame.camera_far;
+  desc.cameraFovAngleVertical = frame.camera_fov_y;
+  // The game's world units aren't known; AMD's default only moves a distance-based motion threshold.
+  desc.viewSpaceToMetersFactor = 1.0f;
+  ffxContext context = context_;
+  const ffxReturnCode_t result = reinterpret_cast<PfnFfxDispatch>(dispatch_)(&context, &desc.header);
+  if (result != FFX_API_RETURN_OK) {
+    REXGPU_WARN("FSR 3.1: the upscale failed (FidelityFX error {})", result);
+    failed_.store(true, std::memory_order_relaxed);
+  }
+}
