+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include <rex/ui/d3d12/d3d12_api.h>
+
+namespace rex::graphics::d3d12 {
+
+// AMD FidelityFX Super Resolution 3.1 through AMD's signed amd_fidelityfx_dx12.dll and its C API (ffx_api), loaded at
+// run time so the GPU plugin runs without it.
+class Fsr3Upscaler {
+ public:
+  // FfxApiUpscaleQualityMode.
+  enum Quality : uint32_t { kNative, kQuality, kBalanced, kPerformance, kUltraPerformance };
+
+  struct CreateDesc {
+    bool depth_inverted = false;
+    uint32_t max_render_width = 0;
+    uint32_t max_render_height = 0;
+    uint32_t output_width = 0;
+    uint32_t output_height = 0;
+  };
+
+  // Resources in D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, the output in D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  // FidelityFX returns them to those states.
+  struct Frame {
+    ID3D12Resource* color = nullptr;   // RGBA8, render size
+    ID3D12Resource* depth = nullptr;   // R32F, render size, 0 to 1
+    ID3D12Resource* motion = nullptr;  // RG16F, render pixels, current to previous, without jitter
+    ID3D12Resource* output = nullptr;  // RGBA8, output size
+    uint32_t render_width = 0;
+    uint32_t render_height = 0;
+    uint32_t output_width = 0;
+    uint32_t output_height = 0;
+    float jitter_x = 0.0f;  // render pixels the scene was moved by, x right, y down
+    float jitter_y = 0.0f;
+    float sharpness = 0.0f;
+    float frame_time_ms = 0.0f;
+    float camera_near = 0.0f;
+    float camera_far = 0.0f;
+    float camera_fov_y = 0.0f;
+    bool reset = false;
+  };
+
+  struct RecordArgs {
+    bool create = false;
+    CreateDesc create_desc;
+    Frame frame;
+  };
+
+  Fsr3Upscaler() = default;
+  Fsr3Upscaler(const Fsr3Upscaler&) = delete;
+  Fsr3Upscaler& operator=(const Fsr3Upscaler&) = delete;
+  ~Fsr3Upscaler() { DestroyContext(); }
+
+  // Logs why FSR 3.1 can't run when it returns false.
+  bool Load(const std::filesystem::path& dll, ID3D12Device* device);
+  bool loaded() const { return create_context_ != nullptr; }
+  // The upscaler versions the DLL offers on the device, such as "3.1.4".
+  std::string versions() const { return versions_; }
+
+  std::optional<std::pair<uint32_t, uint32_t>> QueryRenderSize(uint32_t output_width, uint32_t output_height,
+                                                                Quality quality) const;
+  std::optional<uint32_t> QueryJitterPhaseCount(uint32_t render_width, uint32_t output_width) const;
+
+  // On the thread that records the command list (DeferredCommandList::ExternalCall): creates the context first when
+  // asked or when there is none, then records the upscale. The GPU must be done with an earlier context.
+  static void RecordOnCommandList(void* upscaler, ID3D12GraphicsCommandList* command_list, const void* args);
+
+  // The GPU must be done with the context.
+  void DestroyContext();
+
+  bool failed() const { return failed_.load(std::memory_order_relaxed); }
+
+ private:
+  bool CreateContext(const CreateDesc& desc);
+  void Record(ID3D12GraphicsCommandList* command_list, const RecordArgs& args);
+
+  // ffx_api's entry points (PfnFfxCreateContext and so on).
+  void* create_context_ = nullptr;
+  void* destroy_context_ = nullptr;
+  void* query_ = nullptr;
+  void* dispatch_ = nullptr;
+  ID3D12Device* device_ = nullptr;
+  std::string versions_;
+  void* context_ = nullptr;
+  std::atomic<bool> failed_{false};
+};
+
+}  // namespace rex::graphics::d3d12
