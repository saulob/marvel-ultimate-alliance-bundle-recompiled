 GpuWorkSummary g_gpu_work_summary;
 
+enum class Bottleneck { kUnknown, kCommandProcessor, kGpu, kSynchronization, kMixed };
+
+// A share of the frame counts as a limit at 25% blocked; the command processor is the limit only when it never
+// blocks and is never idle, since idling means the guest or a frame limiter is not feeding it.
+Bottleneck ClassifyBottleneck(uint32_t swaps, double frame_ms, double gpu_wait_ms, double submit_wait_ms,
+                              double idle_ms) {
+  if (swaps < 30 || frame_ms <= 0.0) {
+    return Bottleneck::kUnknown;
+  }
+  const bool gpu = gpu_wait_ms >= frame_ms * 0.25;
+  const bool synchronization = submit_wait_ms >= frame_ms * 0.25;
+  const bool command_processor =
+      gpu_wait_ms < frame_ms * 0.10 && submit_wait_ms < frame_ms * 0.10 && idle_ms < frame_ms * 0.10;
+  const int limits = int(gpu) + int(synchronization) + int(command_processor);
+  if (limits > 1) {
+    return Bottleneck::kMixed;
+  }
+  if (gpu) {
+    return Bottleneck::kGpu;
+  }
+  if (synchronization) {
+    return Bottleneck::kSynchronization;
+  }
+  return command_processor ? Bottleneck::kCommandProcessor : Bottleneck::kUnknown;
+}
+
+const char* BottleneckText(Bottleneck bottleneck) {
+  switch (bottleneck) {
+    case Bottleneck::kCommandProcessor:
+      return "CPU / COMMAND PROCESSOR LIMITED";
+    case Bottleneck::kGpu:
+      return "GPU LIMITED";
+    case Bottleneck::kSynchronization:
+      return "WAIT / SYNCHRONIZATION LIMITED";
+    case Bottleneck::kMixed:
+      return "MIXED";
+    default:
+      return "UNKNOWN";
+  }
+}
