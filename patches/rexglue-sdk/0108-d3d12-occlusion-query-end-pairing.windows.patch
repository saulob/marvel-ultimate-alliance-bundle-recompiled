Adapted from crackdown-recomp (Unowa001) origin/main patches/sdk/0005 (BEGIN/END pairing, point 1 of that patch; its deferred write is already 0075). Direct3D 9 gives a query's BEGIN and END their own sample count blocks (Crackdown: END 0x20 bytes before BEGIN) and subtracts the two snapshots, but the END handler required the BEGIN's address, so the first END disabled host occlusion queries for the rest of the session and every result was the fake count. END now pairs with the active query, and a BEGIN without an END, or a nested BEGIN, abandons only that query. A query that a forced EndSubmission splits still gets the fake count (0075 already avoids ending a submission early while a query is active). DEBUG_SAULO: the first 8 BEGIN/END events are logged with their addresses.

diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 2a22dc2..2075595 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -422,6 +422,7 @@ class D3D12CommandProcessor : public CommandProcessor {
   // if wait is true, awaits the rest.
   void CompleteOcclusionQueries(bool wait);
   bool AcquireOcclusionQueryIndex(uint32_t& host_index_out);
+  void AbandonActiveOcclusionQuery();
   void DisableHostOcclusionQueries();
   uint64_t NormalizeOcclusionSamples(uint64_t samples) const;
   void WriteGuestOcclusionResult(xenos::xe_gpu_depth_sample_counts* sample_counts,
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 1a47387..1369e5d 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -277,7 +277,7 @@ bool D3D12CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffe
   auto* sample_counts =
       memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(sample_count_addr);
   if (!sample_counts) {
-    DisableHostOcclusionQueries();
+    AbandonActiveOcclusionQuery();
     return true;
   }
 
@@ -304,25 +304,29 @@ bool D3D12CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffe
       sample_counts->ZFail_A == kQueryFinished || sample_counts->ZFail_B == kQueryFinished;
   bool is_end = is_end_via_z_pass || is_end_via_z_fail;
 
+  // DEBUG_SAULO: the first BEGIN/END pairs, to see the guest's sample count block layout.
+  static std::atomic<uint32_t> zpd_logged{0};
+  if (zpd_logged.fetch_add(1, std::memory_order_relaxed) < 8) {
+    REXGPU_INFO("DEBUG_SAULO occlusion {} at {:08X}, active query at {:08X}",
+                is_end ? "END" : "BEGIN", sample_count_addr,
+                active_occlusion_query_.valid ? active_occlusion_query_.sample_count_address : 0u);
+  }
+
   if (!is_end) {
     // Direct3D 9 snapshots the counters into separate begin and end blocks and subtracts them, so
     // the begin block reads as zero (as in the fallback result) and only the end block carries the
     // host result, written once its submission completes.
+    // A BEGIN that never got its END.
+    AbandonActiveOcclusionQuery();
     std::memset(sample_counts, 0, sizeof(xenos::xe_gpu_depth_sample_counts));
-    if (active_occlusion_query_.valid &&
-        active_occlusion_query_.sample_count_address != sample_count_addr) {
-      DisableHostOcclusionQueries();
-      return write_fallback_result();
-    }
     if (!BeginGuestOcclusionQuery(sample_count_addr)) {
       return write_fallback_result();
     }
     return true;
   }
 
-  if (!active_occlusion_query_.valid ||
-      active_occlusion_query_.sample_count_address != sample_count_addr) {
-    DisableHostOcclusionQueries();
+  // END has its own block, so it pairs with the active query whatever its address.
+  if (!active_occlusion_query_.valid) {
     return write_fallback_result();
   }
 
@@ -5495,6 +5499,15 @@ bool D3D12CommandProcessor::AcquireOcclusionQueryIndex(uint32_t& host_index_out)
   return true;
 }
 
+void D3D12CommandProcessor::AbandonActiveOcclusionQuery() {
+  // An active query's submission is open: EndSubmission ends and drops it.
+  if (active_occlusion_query_.valid && occlusion_query_heap_ && submission_open_) {
+    deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
+                                       active_occlusion_query_.host_index);
+  }
+  active_occlusion_query_ = {};
+}
+
 void D3D12CommandProcessor::DisableHostOcclusionQueries() {
   if (active_occlusion_query_.valid && occlusion_query_heap_) {
     uint32_t host_index = active_occlusion_query_.host_index;
@@ -5520,7 +5533,7 @@ bool D3D12CommandProcessor::BeginGuestOcclusionQuery(uint32_t sample_count_addre
   if (active_occlusion_query_.valid) {
     REXGPU_WARN(
         "D3D12CommandProcessor: Occlusion query begin issued while another query is active");
-    DisableHostOcclusionQueries();
+    AbandonActiveOcclusionQuery();
     return false;
   }
 
