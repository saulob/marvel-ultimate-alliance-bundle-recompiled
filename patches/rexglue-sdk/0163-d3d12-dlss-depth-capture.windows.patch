+// Which planes of the scene surface a resolve copies into the DLSS input. Color: at each resolve after scene draws,
+// before a resolve clears it, so the last one wins. Depth: once between depth clears, at the first resolve after draws
+// wrote it (or after any scene draw in a frame that writes none): MUA1 resolves each tile twice, and the draws between
+// cover the whole tile with depth at the clear value.
+class ScenePlanes {
+ public:
+  static constexpr uint32_t kColor = 1;
+  static constexpr uint32_t kDepth = 2;
+
+  void NoteSceneDraw(bool writes_depth) {
+    color_drawn_ = true;
+    depth_written_ |= writes_depth;
+    depth_written_in_frame_ |= writes_depth;
+  }
+  // Marks what it returns as taken.
+  uint32_t Take(bool depth_resolve) {
+    const bool depth = !depth_taken_ && (depth_written_ || !depth_written_in_frame_);
+    depth_taken_ |= depth;
+    return (!depth_resolve && color_drawn_ ? kColor : 0) | (depth ? kDepth : 0);
+  }
+  void AfterResolve(bool clears_color, bool clears_depth) {
+    color_drawn_ &= !clears_color;
+    if (clears_depth) {
+      depth_written_ = depth_taken_ = false;
+    }
+  }
+  void EndFrame() { *this = {}; }
+
+ private:
+  bool color_drawn_ = false;
+  bool depth_written_ = false;
+  bool depth_written_in_frame_ = false;
+  bool depth_taken_ = false;
+};
