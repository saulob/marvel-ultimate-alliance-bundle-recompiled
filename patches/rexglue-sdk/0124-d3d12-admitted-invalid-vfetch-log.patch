Adapted from TheSimpsonsGameRecomp 09a3b57d (the Vulkan path's "characterize every allowed-invalid draw" diagnostic,
ported to the D3D12 admission branch Marvel's config already exercises: gpu_allow_invalid_fetch_constants = true in
config/marvel_ultimate_alliance.toml). Patch 0051 logs a vertex fetch constant only when the "invalid" type is
rejected (the cvar off); nothing currently logs the ones the cvar admits. Bounded the same way: the first 256
occurrences, then every 256th.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index d0edb55..822df07 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2844,6 +2844,15 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
           break;
         case xenos::FetchConstantType::kInvalidVertex:
           if (REXCVAR_GET(gpu_allow_invalid_fetch_constants)) {
+            static std::atomic<uint32_t> allowed_invalid_vfetch_count{0};
+            const uint32_t occurrence = allowed_invalid_vfetch_count.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (occurrence <= 256 || (occurrence & 255) == 0) {
+              REXGPU_WARN(
+                  "Vertex fetch constant {} ({:08X} {:08X}) admitted by gpu_allow_invalid_fetch_constants: "
+                  "vs={:016X} ps={:016X} occurrence={}",
+                  vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1, vertex_shader->ucode_data_hash(),
+                  pixel_shader ? pixel_shader->ucode_data_hash() : 0, occurrence);
+            }
             break;
           }
           REXGPU_WARN(
