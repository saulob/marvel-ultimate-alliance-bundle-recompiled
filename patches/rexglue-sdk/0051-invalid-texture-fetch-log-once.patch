diff --git a/include/rex/graphics/pipeline/texture/invalid_fetch_log.h b/include/rex/graphics/pipeline/texture/invalid_fetch_log.h
new file mode 100644
index 0000000..529a862
--- /dev/null
+++ b/include/rex/graphics/pipeline/texture/invalid_fetch_log.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::graphics {
+
+enum class InvalidFetchLogDecision { kLog, kLogOverflow, kSuppress };
+
+// Not synchronized; the caller serializes access.
+class InvalidFetchLogTracker {
+ public:
+  using Signature = std::array<uint32_t, 6>;
+  static constexpr size_t kMaxSignatures = 16;
+
+  InvalidFetchLogDecision Check(const Signature& signature) {
+    for (size_t i = 0; i < count_; ++i) {
+      if (signatures_[i] == signature) {
+        return InvalidFetchLogDecision::kSuppress;
+      }
+    }
+    if (count_ < kMaxSignatures) {
+      signatures_[count_++] = signature;
+      return InvalidFetchLogDecision::kLog;
+    }
+    if (overflow_reported_) {
+      return InvalidFetchLogDecision::kSuppress;
+    }
+    overflow_reported_ = true;
+    return InvalidFetchLogDecision::kLogOverflow;
+  }
+
+  size_t count() const { return count_; }
+
+ private:
+  std::array<Signature, kMaxSignatures> signatures_{};
+  size_t count_ = 0;
+  bool overflow_reported_ = false;
+};
+
+}  // namespace rex::graphics
