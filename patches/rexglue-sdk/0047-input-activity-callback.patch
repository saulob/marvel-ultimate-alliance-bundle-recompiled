+std::mutex g_input_activity_mutex;
+std::function<void(DeviceId, const X_INPUT_GAMEPAD&)> g_input_activity_callback;
+std::unordered_map<uint64_t, X_INPUT_GAMEPAD> g_last_device_gamepad;
+
+void NotifyInputActivity(DeviceId id, const X_INPUT_GAMEPAD& gamepad) {
+  std::lock_guard lock(g_input_activity_mutex);
+  auto [it, inserted] = g_last_device_gamepad.try_emplace(static_cast<uint64_t>(id), gamepad);
+  if (!inserted && std::memcmp(&it->second, &gamepad, sizeof(gamepad)) == 0) {
+    return;
+  }
+  it->second = gamepad;
+  if (g_input_activity_callback) {
+    g_input_activity_callback(id, gamepad);
+  }
+}
+
+void ForgetInputActivity(DeviceId id) {
+  std::lock_guard lock(g_input_activity_mutex);
+  g_last_device_gamepad.erase(static_cast<uint64_t>(id));
+}
+
