+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+
+// Bounds of the faulting thread's stack, as published in its PCR.
+struct GuestStackBounds {
+  uint32_t limit = 0;
+  uint32_t base = 0;
+
+  constexpr bool known() const { return base > limit; }
+};
+
+enum class GuestFaultRegion {
+  kFree,
+  kReserved,
+  kCommitted,
+  kNoAccess,
+  kOwnStack,
+  kOwnStackGuard,
+  kOwnStackAbove,
+};
+
+// Stacks are allocated with one no-access guard page below the limit and one above the base.
+constexpr GuestFaultRegion ClassifyGuestFaultRegion(uint32_t page, uint32_t page_size,
+                                                    bool reserved, bool committed,
+                                                    bool no_access, GuestStackBounds stack) {
+  if (stack.known()) {
+    if (page >= stack.limit && page < stack.base) {
+      return GuestFaultRegion::kOwnStack;
+    }
+    if (page == stack.base || page + page_size == stack.limit) {
+      return GuestFaultRegion::kOwnStackGuard;
+    }
+    if (page == stack.base + page_size) {
+      return GuestFaultRegion::kOwnStackAbove;
+    }
+  }
+  if (committed) {
+    return no_access ? GuestFaultRegion::kNoAccess : GuestFaultRegion::kCommitted;
+  }
+  return reserved ? GuestFaultRegion::kReserved : GuestFaultRegion::kFree;
+}
+
+constexpr const char* GuestFaultRegionName(GuestFaultRegion region) {
+  switch (region) {
+    case GuestFaultRegion::kFree:
+      return "free";
+    case GuestFaultRegion::kReserved:
+      return "reserved";
+    case GuestFaultRegion::kCommitted:
+      return "committed";
+    case GuestFaultRegion::kNoAccess:
+      return "no_access";
+    case GuestFaultRegion::kOwnStack:
+      return "own_stack";
+    case GuestFaultRegion::kOwnStackGuard:
+      return "own_stack_guard";
+    case GuestFaultRegion::kOwnStackAbove:
+      return "own_stack_above";
+  }
+  return "unknown";
+}
+
+}  // namespace rex::memory
