+// Guest code keeps the PCR in r13; its stack fields are only trusted when that page is readable.
+GuestStackBounds CurrentGuestStack(Memory* memory, const ::PPCContext& ctx) {
+  const uint32_t pcr_address = ctx.r13.u32;
+  BaseHeap* heap = memory->LookupHeap(pcr_address);
+  if (!pcr_address || !heap) {
+    return {};
+  }
+  const uint32_t pcr_page = pcr_address & ~(heap->page_size() - 1);
+  const uint32_t fields_end = pcr_address + offsetof(system::X_KPCR, alt_stack_base_ptr);
+  HeapAllocationInfo info{};
+  if (!heap->QueryRegionInfo(pcr_page, &info) ||
+      !(info.state & memory::kMemoryAllocationCommit) ||
+      !(info.protect & memory::kMemoryProtectRead) || fields_end > pcr_page + info.region_size) {
+    return {};
+  }
+  const auto* pcr = memory->TranslateVirtual<const system::X_KPCR*>(pcr_address);
+  return {pcr->stack_end_ptr, pcr->stack_base_ptr};
+}
+
+struct GuestFaultDescription {
+  uint32_t page = 0;
+  HeapAllocationInfo info{};
+  GuestStackBounds stack;
+  GuestFaultRegion region = GuestFaultRegion::kFree;
+};
+
+bool DescribeGuestFault(Memory* memory, BaseHeap* heap, const ::PPCContext& ctx,
+                        uint32_t guest_address, GuestFaultDescription& out) {
+  const uint32_t page_size = heap->page_size();
+  out.page = guest_address & ~(page_size - 1);
+  if (!heap->QueryRegionInfo(out.page, &out.info)) {
+    return false;
+  }
+  out.stack = CurrentGuestStack(memory, ctx);
+  out.region = ClassifyGuestFaultRegion(
+      out.page, page_size, (out.info.state & memory::kMemoryAllocationReserve) != 0,
+      (out.info.state & memory::kMemoryAllocationCommit) != 0,
+      out.info.protect == memory::kMemoryProtectNoAccess, out.stack);
+  return true;
+}
+
+
+void LogUnhandledGuestFault(Memory* memory, BaseHeap* heap, uint32_t guest_address,
+                            bool is_write) {
+  const auto* thread_state = runtime::ThreadState::Get();
+  if (!thread_state) {
+    return;
+  }
+  const ::PPCContext& ctx = *thread_state->context();
+  GuestFaultDescription fault;
+  if (!DescribeGuestFault(memory, heap, ctx, guest_address, fault)) {
+    return;
+  }
+  const int64_t offset_from_stack_base =
+      fault.stack.known() ? int64_t(guest_address) - int64_t(fault.stack.base) : 0;
+  REXSYS_ERROR(
+      "[SAVE_CRASH] Guest {} fault: addr=0x{:08X} region={} alloc=0x{:08X}+0x{:X} state={} "
+      "protect={} stack_limit=0x{:08X} stack_base=0x{:08X} offset_from_stack_base={:+#x} "
+      "r1=0x{:08X} lr=0x{:08X} thread=0x{:X}",
+      is_write ? "write" : "read", guest_address, GuestFaultRegionName(fault.region),
+      fault.info.allocation_base, fault.info.allocation_size, fault.info.state, fault.info.protect,
+      fault.stack.limit, fault.stack.base, offset_from_stack_base, ctx.r1.u32, uint32_t(ctx.lr),
+      thread_state->thread_id());
+}
