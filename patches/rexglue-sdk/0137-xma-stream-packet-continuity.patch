+static constexpr uint32_t kBitsPerPacket = 2048 * 8;
+
+// A packet of a stream, addressed by its index counted from the start of the current input buffer. The packet skip
+// count of an interleaved stream does not restart at a buffer boundary, so an index past the current buffer is a
+// packet inside the other buffer, not its first packet.
+struct StreamPacket {
+  uint8_t buffer = 0;
+  uint32_t packet = 0;
+};
+
+inline bool LocateStreamPacket(uint8_t current_buffer, uint32_t packet_index, const uint32_t packet_counts[2],
+                               StreamPacket* location) {
+  uint8_t buffer = current_buffer;
+  if (packet_index >= packet_counts[buffer]) {
+    packet_index -= packet_counts[buffer];
+    buffer ^= 1;
+    if (packet_index >= packet_counts[buffer]) {
+      return false;
+    }
+  }
+  *location = {buffer, packet_index};
+  return true;
+}
+
+// Where a stream resumes after a packet: the first packet from packet_index on (counted as in LocateStreamPacket) in
+// which a frame begins. When the buffer it continues in is not valid yet, pending_packet is its index there.
+struct StreamAdvance {
+  uint32_t buffers_finished = 0;
+  bool found = false;
+  uint32_t read_offset = 0;
+  uint32_t pending_packet = 0;
+};
+
+template <typename FrameOffsetOf>
+StreamAdvance AdvanceStream(uint8_t current_buffer, uint32_t packet_index, const uint32_t packet_counts[2],
+                            const bool valid[2], FrameOffsetOf frame_offset_of) {
+  StreamAdvance result;
+  uint8_t buffer = current_buffer;
+  while (result.buffers_finished < 2 && valid[buffer]) {
+    for (; packet_index < packet_counts[buffer]; ++packet_index) {
+      const uint32_t frame_offset = frame_offset_of(buffer, packet_index);
+      if (frame_offset < kBitsPerPacket) {
+        result.found = true;
+        result.read_offset = packet_index * kBitsPerPacket + frame_offset;
+        return result;
+      }
+    }
+    packet_index -= packet_counts[buffer];
+    buffer ^= 1;
+    ++result.buffers_finished;
+  }
+  result.pending_packet = packet_index;
+  return result;
+}
+
 }  // namespace rex::audio::xma
