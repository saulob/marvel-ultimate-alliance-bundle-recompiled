diff --git a/src/graphics/d3d12/dlss_bridge.cpp b/src/graphics/d3d12/dlss_bridge.cpp
new file mode 100644
index 0000000..acff12d
--- /dev/null
+++ b/src/graphics/d3d12/dlss_bridge.cpp
@@ -0,0 +1,132 @@
+#include <rex/graphics/d3d12/dlss_bridge.h>
+
+#include <array>
+#include <string>
+#include <system_error>
+#include <utility>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+
+REXCVAR_DEFINE_INT32(d3d12_dlss_ngx_log_level, 0, "GPU/D3D12",
+                     "How much of NVIDIA NGX's own log goes to this log: 0 none, 1 normal, 2 verbose")
+    .range(0, 2)
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::d3d12 {
+
+namespace {
+
+void LogFromBridge(void*, RexDlssLogLevel level, const char* message) {
+  switch (level) {
+    case REX_DLSS_LOG_ERROR:
+      REXGPU_ERROR("DLSS: {}", message);
+      break;
+    case REX_DLSS_LOG_WARNING:
+      REXGPU_WARN("DLSS: {}", message);
+      break;
+    default:
+      REXGPU_INFO("DLSS: {}", message);
+      break;
+  }
+}
+
+std::string AdapterReasons(uint32_t reasons) {
+  constexpr std::array<std::pair<uint32_t, const char*>, 5> kReasons = {{
+      {1, "no support check in the driver"},
+      {2, "driver too old"},
+      {4, "graphics card not supported"},
+      {8, "Windows too old"},
+      {16, "not implemented"},
+  }};
+  std::string text;
+  for (const auto& [bit, reason] : kReasons) {
+    if (reasons & bit) {
+      text += (text.empty() ? "" : ", ") + std::string(reason);
+    }
+  }
+  return text.empty() ? "unknown reason" : text;
+}
+
+Microsoft::WRL::ComPtr<IDXGIAdapter> DeviceAdapter(const ui::d3d12::D3D12Provider& provider) {
+  Microsoft::WRL::ComPtr<IDXGIFactory4> factory;
+  Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+  if (provider.GetDXGIFactory() && SUCCEEDED(provider.GetDXGIFactory()->QueryInterface(IID_PPV_ARGS(&factory)))) {
+    factory->EnumAdapterByLuid(provider.GetDevice()->GetAdapterLuid(), IID_PPV_ARGS(&adapter));
+  }
+  return adapter;
+}
+
+}  // namespace
+
+bool DlssBridge::Initialize(const std::filesystem::path& dll, const std::filesystem::path& data_path,
+                            const ui::d3d12::D3D12Provider& provider) {
+  Shutdown();
+  if (provider.GetAdapterVendorID() != ui::GraphicsProvider::GpuVendorID::kNvidia) {
+    REXGPU_INFO("DLSS: off, the graphics card is not an NVIDIA one");
+    return false;
+  }
+  // Never unloaded: NGX's threads may still call the bridge's log callback after shutdown.
+  HMODULE module = LoadLibraryExW(dll.c_str(), nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+  if (!module) {
+    REXGPU_WARN("DLSS: off, {} can't be loaded (error {})", rex::path_to_utf8(dll),
+                uint32_t(GetLastError()));
+    return false;
+  }
+  const auto get_api = reinterpret_cast<RexDlssBridgeGetApiFunction>(
+      reinterpret_cast<void*>(GetProcAddress(module, REX_DLSS_BRIDGE_ENTRY_POINT)));
+  api_ = get_api ? get_api(REX_DLSS_BRIDGE_ABI_VERSION) : nullptr;
+  if (!api_) {
+    REXGPU_WARN("DLSS: off, {} doesn't offer interface version {}", rex::path_to_utf8(dll),
+                REX_DLSS_BRIDGE_ABI_VERSION);
+    Shutdown();
+    return false;
+  }
+
+  std::error_code error;
+  std::filesystem::create_directories(data_path, error);
+  if (Microsoft::WRL::ComPtr<IDXGIAdapter> adapter = DeviceAdapter(provider)) {
+    RexDlssAdapterRequirements requirements = {};
+    if (api_->query_adapter(adapter.Get(), data_path.c_str(), &requirements) != REX_DLSS_OK) {
+      REXGPU_INFO("DLSS: NVIDIA's adapter check failed ({}), trying NGX anyway", api_->last_error());
+    } else if (!requirements.supported) {
+      REXGPU_WARN("DLSS: off, NVIDIA reports the system unsupported: {} (minimum architecture 0x{:X}, Windows {})",
+                  AdapterReasons(requirements.unsupported_reasons), requirements.min_hw_architecture,
+                  requirements.min_os_version);
+      Shutdown();
+      return false;
+    }
+  }
+
+  RexDlssInitDesc desc = {};
+  desc.struct_size = sizeof(desc);
+  desc.device = provider.GetDevice();
+  desc.data_path = data_path.c_str();
+  desc.log = LogFromBridge;
+  desc.ngx_log_level = REXCVAR_GET(d3d12_dlss_ngx_log_level);
+  const RexDlssStatus status = api_->init(&desc, &capabilities_);
+  if (status != REX_DLSS_OK) {
+    REXGPU_WARN("DLSS: off ({})", api_->last_error());
+    Shutdown();
+    return false;
+  }
+  initialized_ = true;
+  REXGPU_INFO("DLSS: Super Resolution available | nvngx_dlss.dll {} | driver minimum {}.{}",
+              capabilities_.runtime_version[0] ? capabilities_.runtime_version : "from the driver",
+              capabilities_.min_driver_major, capabilities_.min_driver_minor);
+  return true;
+}
+
+void DlssBridge::Shutdown() {
+  if (initialized_) {
+    api_->shutdown();
+    initialized_ = false;
+  }
+  api_ = nullptr;
+  capabilities_ = {};
+}
+
+}  // namespace rex::graphics::d3d12
