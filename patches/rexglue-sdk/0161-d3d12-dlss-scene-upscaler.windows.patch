+          if (draw_resolution_scaled) {
+            descriptor_dest = descriptors[0];
+          } else {
+            descriptor_dest = command_processor_.GetSharedMemoryUintPow2BindlessUAVHandlePair(
+                copy_shader_info.dest_bpe_log2);
