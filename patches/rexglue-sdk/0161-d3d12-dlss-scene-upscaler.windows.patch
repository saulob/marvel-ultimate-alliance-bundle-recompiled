+bool D3D12RenderTargetCache::CopyResolveToMemory(const draw_util::ResolveInfo& resolve_info,
+                                                 D3D12SharedMemory& shared_memory,
+                                                 D3D12TextureCache& texture_cache,
+                                                 ID3D12Resource* source_buffer,
+                                                 uint32_t& written_address_out,
+                                                 uint32_t& written_length_out) {
+  bool copied;
+  return CopyResolveToMemory(resolve_info, shared_memory, texture_cache, source_buffer, written_address_out,
+                             written_length_out, copied) &&
+         copied;
+}
+
+void D3D12RenderTargetCache::WriteResolveSourceSRVDescriptor(
+    D3D12_CPU_DESCRIPTOR_HANDLE handle, ID3D12Resource* source_buffer,
+    const draw_util::ResolveCopyShaderInfo& copy_shader_info) {
+  D3D12_SHADER_RESOURCE_VIEW_DESC desc = {};
+  desc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
+  desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  const uint64_t size = source_buffer->GetDesc().Width;
+  if (copy_shader_info.source_is_raw) {
+    desc.Format = DXGI_FORMAT_R32_TYPELESS;
+    desc.Buffer.NumElements = UINT(size >> 2);
+    desc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
+  } else {
+    desc.Format = copy_shader_info.source_bpe_log2 >= 4   ? DXGI_FORMAT_R32G32B32A32_UINT
+                  : copy_shader_info.source_bpe_log2 == 3 ? DXGI_FORMAT_R32G32_UINT
+                                                          : DXGI_FORMAT_R32_UINT;
+    desc.Buffer.NumElements = UINT(size >> copy_shader_info.source_bpe_log2);
+  }
+  command_processor_.GetD3D12Provider().GetDevice()->CreateShaderResourceView(source_buffer, &desc, handle);
+}
