+    ranges[i].OffsetInDescriptorsFromTableStart = 0;
+  }
+  D3D12_ROOT_PARAMETER parameters[kRootParameterCount];
+  parameters[kRootParameterConstants].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  parameters[kRootParameterConstants].Constants.ShaderRegister = 0;
+  parameters[kRootParameterConstants].Constants.RegisterSpace = 0;
+  parameters[kRootParameterConstants].Constants.Num32BitValues = sizeof(MotionConstants) / sizeof(uint32_t);
+  parameters[kRootParameterConstants].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (uint32_t i = 0; i < 4; ++i) {
+    D3D12_ROOT_PARAMETER& parameter = parameters[kRootParameterSource0 + i];
+    parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameter.DescriptorTable.NumDescriptorRanges = 1;
+    parameter.DescriptorTable.pDescriptorRanges = &ranges[i];
+    parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxAnisotropy = 1;
+  sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_ROOT_SIGNATURE_DESC root_signature_desc = {};
+  root_signature_desc.NumParameters = kRootParameterCount;
+  root_signature_desc.pParameters = parameters;
+  root_signature_desc.NumStaticSamplers = 1;
+  root_signature_desc.pStaticSamplers = &sampler;
+  root_signature_ = ui::d3d12::util::CreateRootSignature(provider, root_signature_desc);
+  ID3D12Device* device = provider.GetDevice();
+  if (root_signature_) {
+    capture_pipeline_ = ui::d3d12::util::CreateComputePipeline(device, shaders::scene_capture_cs,
+                                                               sizeof(shaders::scene_capture_cs), root_signature_);
+    motion_pipeline_ = ui::d3d12::util::CreateComputePipeline(device, shaders::scene_motion_cs,
+                                                              sizeof(shaders::scene_motion_cs), root_signature_);
+    encode_pipeline_ = ui::d3d12::util::CreateComputePipeline(device, shaders::scene_encode_cs,
+                                                              sizeof(shaders::scene_encode_cs), root_signature_);
+  }
+  if (!root_signature_ || !capture_pipeline_ || !motion_pipeline_ || !encode_pipeline_) {
+    REXGPU_ERROR("DLSS: off, its compute pipelines can't be created - the scene renders without it");
+    Shutdown();
+    return true;
+  }
+  enabled_ = true;
+  return true;
+}
+
+void SceneUpscaler::Shutdown() {
+  if (feature_.handle && feature_.api) {
+    command_processor_.AwaitAllQueueOperationsCompletion();
+    feature_.api->release_feature(feature_.handle);
+    feature_.handle = nullptr;
+  }
+  ReleaseResources();
+  ui::d3d12::util::ReleaseAndNull(encode_pipeline_);
+  ui::d3d12::util::ReleaseAndNull(motion_pipeline_);
+  ui::d3d12::util::ReleaseAndNull(capture_pipeline_);
+  ui::d3d12::util::ReleaseAndNull(root_signature_);
+  bridge_.Shutdown();
+  enabled_ = false;
+  runtime_ready_ = false;
+}
+
+void SceneUpscaler::DisableForSession(const std::string& reason) {
+  if (!disabled_) {
+    REXGPU_WARN("DLSS: off for this session, {} - the scene renders at full resolution without DLSS", reason);
+  }
+  disabled_ = true;
+  runtime_ready_ = false;
+}
+
+bool SceneUpscaler::EnsureRuntime() {
+  if (runtime_ready_ || disabled_ || !enabled_) {
+    return runtime_ready_;
+  }
+  const std::filesystem::path dll = rex::to_path(REXCVAR_GET(d3d12_dlss_bridge));
+  const std::string& data = REXCVAR_GET(d3d12_dlss_data_path);
+  if (!bridge_.Initialize(dll, data.empty() ? dll.parent_path() : rex::to_path(data),
+                          command_processor_.GetD3D12Provider())) {
+    DisableForSession("NVIDIA DLSS is unavailable");
+    return false;
+  }
+  if (quality_ == REX_DLSS_QUALITY_DLAA) {
+    render_width_ = output_width_;
+    render_height_ = output_height_;
+    optimal_ = {output_width_, output_height_, output_width_, output_height_, output_width_, output_height_};
+  } else {
+    if (bridge_.api().query_optimal_settings(output_width_, output_height_, quality_, &optimal_) != REX_DLSS_OK) {
+      DisableForSession(std::string("DLSS offers no render size for ") + QualityName(quality_) + " (" +
+                        bridge_.api().last_error() + ")");
+      return false;
+    }
+    render_width_ = scene::SnapRenderWidth(optimal_.render_width, guest_width_, optimal_.min_render_width,
+                                           optimal_.max_render_width);
+    render_height_ = optimal_.render_height;
+  }
+  const float ratio = float(output_width_) / float(render_width_);
+  jitter_phases_ = std::clamp(uint32_t(std::ceil(8.0f * ratio * ratio)), uint32_t(8), uint32_t(72));
+  if (!EnsureResources()) {
+    DisableForSession("its textures can't be created");
+    return false;
+  }
+  feature_.api = &bridge_.api();
+  feature_recreate_ = true;
+  runtime_ready_ = true;
+  REXGPU_INFO(
+      "DLSS: Super Resolution {} | output {}x{} | NVIDIA recommends {}x{} (dynamic {}x{} to {}x{}) | scene input {}x{} "
+      "| jitter Halton(2,3) {} phases | preset {}",
+      QualityName(quality_), output_width_, output_height_, optimal_.render_width, optimal_.render_height,
+      optimal_.min_render_width, optimal_.min_render_height, optimal_.max_render_width, optimal_.max_render_height,
+      render_width_, render_height_, jitter_phases_,
+      REXCVAR_GET(d3d12_dlss_preset) ? std::to_string(REXCVAR_GET(d3d12_dlss_preset)) : std::string("default"));
+  return true;
+}
+
+bool SceneUpscaler::EnsureResources() {
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  const auto texture = [&](ID3D12Resource*& resource, DXGI_FORMAT format, uint32_t width, uint32_t height) {
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    return SUCCEEDED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                                     D3D12_HEAP_FLAG_NONE, &desc,
+                                                     D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                                     IID_PPV_ARGS(&resource)));
+  };
+  staging_pitch_tiles_ = (guest_width_ + kEdramTileWidth - 1) / kEdramTileWidth;
+  const uint32_t staging_rows = (guest_height_ + kEdramTileHeight - 1) / kEdramTileHeight;
+  const uint64_t tile_bytes = uint64_t(kEdramTileWidth * resolution_scale_x_) *
+                              (kEdramTileHeight * resolution_scale_y_) * sizeof(uint32_t);
+  D3D12_RESOURCE_DESC staging_desc;
+  ui::d3d12::util::FillBufferResourceDesc(staging_desc, uint64_t(staging_pitch_tiles_) * staging_rows * tile_bytes,
+                                          D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+  const bool created =
+      texture(color_, DXGI_FORMAT_R8G8B8A8_UNORM, render_width_, render_height_) &&
+      texture(depth_, DXGI_FORMAT_R32_FLOAT, render_width_, render_height_) &&
+      texture(motion_, DXGI_FORMAT_R16G16_FLOAT, render_width_, render_height_) &&
+      texture(output_, DXGI_FORMAT_R8G8B8A8_UNORM, output_width_, output_height_) &&
+      SUCCEEDED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE,
+                                                &staging_desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                                IID_PPV_ARGS(&staging_)));
+  color_state_ = depth_state_ = motion_state_ = output_state_ = staging_state_ =
+      D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  if (!created) {
+    ReleaseResources();
+  }
+  return created;
+}
+
+void SceneUpscaler::ReleaseResources() {
+  ui::d3d12::util::ReleaseAndNull(staging_);
+  ui::d3d12::util::ReleaseAndNull(output_);
+  ui::d3d12::util::ReleaseAndNull(motion_);
+  ui::d3d12::util::ReleaseAndNull(depth_);
+  ui::d3d12::util::ReleaseAndNull(color_);
+}
+
+bool SceneUpscaler::IsSceneDraw(const RegisterFile& regs, xenos::EdramMode edram_mode,
+                                bool pixel_shader_writes_color) const {
+  if (!surface_ || (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly)) {
+    return false;
+  }
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (surface_info.msaa_samples != surface_->msaa) {
+    return false;
+  }
+  if (edram_mode == xenos::EdramMode::kColorDepth && pixel_shader_writes_color) {
+    return regs.Get<reg::RB_COLOR_INFO>().color_base == surface_->color_base;
+  }
+  return regs.Get<reg::RB_DEPTH_INFO>().depth_base == surface_->depth_base;
+}
+
+std::array<float, 2> SceneUpscaler::JitterForFrame() const {
+  const uint32_t index = uint32_t(jitter_index_ % jitter_phases_) + 1;
+  return {scene::Halton(index, 2) - 0.5f, scene::Halton(index, 3) - 0.5f};
+}
+
+SceneUpscaler::DrawAdjustment SceneUpscaler::BeginDraw(const RegisterFile& regs, xenos::EdramMode edram_mode,
+                                                       const Shader& vertex_shader, bool pixel_shader_writes_color,
+                                                       uint32_t index_base, uint32_t index_count) {
+  DrawAdjustment adjustment;
+  if (!enabled_ || disabled_) {
+    return adjustment;
+  }
+  const bool scene = IsSceneDraw(regs, edram_mode, pixel_shader_writes_color);
+  if (!scene) {
+    if (scene_pending_) {
+      FinishScene();
+    }
+    // A multisampled, depth-tested surface drawn into often enough becomes the scene surface at the end of the frame.
+    const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+    const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+    if (edram_mode == xenos::EdramMode::kColorDepth && pixel_shader_writes_color &&
+        surface_info.msaa_samples >= xenos::MsaaSamples::k2X && (depth_control.z_enable || depth_control.z_write_enable)) {
+      const auto color_info = regs.Get<reg::RB_COLOR_INFO>();
+      if (color_info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+          color_info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA) {
+        const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+        const uint64_t key = uint64_t(color_info.color_base) | uint64_t(depth_info.depth_base) << 16 |
+                             uint64_t(surface_info.msaa_samples) << 32 | uint64_t(color_info.color_format) << 40 |
+                             uint64_t(depth_info.depth_format) << 48;
+        ++candidate_draws_[key];
+      }
+    }
+    return adjustment;
+  }
+  if (!EnsureRuntime()) {
+    return adjustment;
+  }
+  scene_drawn_ = true;
+  color_fresh_ = depth_fresh_ = true;
+  if (edram_mode == xenos::EdramMode::kColorDepth && !viewport_known_) {
+    const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+    guest_viewport_ = {
+        vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f,
+        vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f,
+        vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f,
+        vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f,
+        vte.vport_z_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE) : 1.0f,
+        vte.vport_z_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET) : 0.0f,
+    };
+    viewport_known_ = vte.vport_x_scale_ena && vte.vport_y_scale_ena;
+  }
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  if (depth_control.z_enable) {
+    depth_inverted_ = depth_control.zfunc == xenos::CompareFunction::kGreater ||
+                      depth_control.zfunc == xenos::CompareFunction::kGreaterEqual;
+  }
+  NoteDirectTransform(regs, vertex_shader, index_base, index_count);
+  adjustment.scene = true;
+  adjustment.scale_x = float(render_width_) / float(output_width_);
+  adjustment.scale_y = float(render_height_) / float(output_height_);
+  const std::array<float, 2> jitter = JitterForFrame();
+  adjustment.jitter_x = jitter[0];
+  adjustment.jitter_y = jitter[1];
+  return adjustment;
+}
+
+void SceneUpscaler::NoteDirectTransform(const RegisterFile& regs, const Shader& vertex_shader, uint32_t index_base,
+                                        uint32_t index_count) {
+  auto analysis = direct_transforms_.find(vertex_shader.ucode_data_hash());
+  if (analysis == direct_transforms_.end()) {
+    analysis = direct_transforms_
+                   .emplace(vertex_shader.ucode_data_hash(),
+                            AnalyzeDirectPositionTransform(vertex_shader.ucode_disassembly()))
+                   .first;
+  }
+  if (!analysis->second || matrices_.size() >= kMaxTrackedMatrices) {
+    return;
+  }
+  const DirectPositionTransform& transform = *analysis->second;
+  const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(transform.fetch_constant);
+  uint64_t key = Mix(vertex_shader.ucode_data_hash(), uint64_t(fetch.address) | uint64_t(fetch.size) << 32);
+  key = Mix(key, uint64_t(index_base) | uint64_t(index_count) << 32);
+  key = Mix(key, draw_occurrences_[key]++);
+  scene::Matrix matrix;
+  for (uint32_t column = 0; column < 4; ++column) {
+    const uint32_t first = XE_GPU_REG_SHADER_CONSTANT_000_X + transform.column_registers[column] * 4;
+    for (uint32_t row = 0; row < 4; ++row) {
+      matrix[row * 4 + column] = double(regs.Get<float>(first + row));
+    }
+  }
+  matrices_.emplace(key, matrix);
+}
+
+std::optional<scene::Matrix> SceneUpscaler::EstimateCameraReprojection(uint32_t& matched_out,
+                                                                       uint32_t& agreeing_out) const {
+  std::vector<std::pair<scene::Matrix, scene::Matrix>> pairs;
+  pairs.reserve(std::min(matrices_.size(), kMaxReprojectionSamples));
+  for (const auto& [key, current] : matrices_) {
+    if (pairs.size() >= kMaxReprojectionSamples) {
+      break;
+    }
+    if (const auto previous = previous_matrices_.find(key); previous != previous_matrices_.end()) {
+      pairs.emplace_back(current, previous->second);
+    }
+  }
+  return scene::EstimateCameraReprojection(pairs, matched_out, agreeing_out);
+}
+
+void SceneUpscaler::Transition(ID3D12Resource* resource, D3D12_RESOURCE_STATES& state,
+                               D3D12_RESOURCE_STATES new_state) {
+  if (state == new_state) {
+    if (new_state == D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+      command_processor_.PushUAVBarrier(resource);
+    }
+    return;
+  }
+  command_processor_.PushTransitionBarrier(resource, state, new_state);
+  state = new_state;
+}
+
+void SceneUpscaler::Dispatch(ID3D12PipelineState* pipeline, const void* constants, uint32_t constant_dwords,
+                             std::array<ID3D12Resource*, 2> sources, std::array<DXGI_FORMAT, 2> source_formats,
+                             std::array<ID3D12Resource*, 2> dests, std::array<DXGI_FORMAT, 2> dest_formats,
+                             uint32_t width, uint32_t height) {
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[4];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(4, descriptors)) {
+    return;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  for (uint32_t i = 0; i < 2; ++i) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    if (source_formats[i] == DXGI_FORMAT_UNKNOWN && !sources[i]) {
+      // The EDRAM, as a raw buffer.
+      render_target_cache_.WriteEdramRawSRVDescriptor(descriptors[i].first);
+      continue;
+    }
+    srv.Format = source_formats[i];
+    srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(sources[i], &srv, descriptors[i].first);
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav = {};
+    ID3D12Resource* dest = dests[i] ? dests[i] : dests[0];
+    if (dest == staging_) {
+      uav.Format = DXGI_FORMAT_R32_TYPELESS;
+      uav.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+      uav.Buffer.NumElements = UINT(staging_->GetDesc().Width / sizeof(uint32_t));
+      uav.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+    } else {
+      uav.Format = dests[i] ? dest_formats[i] : dest_formats[0];
+      uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    }
+    device->CreateUnorderedAccessView(dest, nullptr, &uav, descriptors[2 + i].first);
+  }
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_list.D3DSetComputeRootSignature(root_signature_);
+  command_list.D3DSetComputeRoot32BitConstants(kRootParameterConstants, constant_dwords, constants, 0);
+  for (uint32_t i = 0; i < 4; ++i) {
+    command_list.D3DSetComputeRootDescriptorTable(kRootParameterSource0 + i, descriptors[i].second);
+  }
+  command_processor_.SetExternalPipeline(pipeline);
+  command_processor_.SubmitBarriers();
+  command_list.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+}
+
+void SceneUpscaler::BeforeResolve(const RegisterFile& regs, const draw_util::ResolveInfo& resolve_info) {
+  resolving_.reset();
+  if (!runtime_ready_ || !surface_ || !resolve_info.copy_dest_extent_length) {
+    return;
+  }
+  const bool depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info = depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const uint32_t original_base = depth ? resolve_info.depth_original_base : resolve_info.color_original_base;
+  if (edram_info.msaa_samples != surface_->msaa ||
+      original_base != (depth ? surface_->depth_base : surface_->color_base)) {
+    return;
+  }
+  const uint32_t log2_x = uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k4X);
+  const uint32_t log2_y = uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  int32_t window_x = 0;
+  int32_t window_y = 0;
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    window_x = window_offset.window_x_offset;
+    window_y = window_offset.window_y_offset;
+  }
+  SceneResolve resolve;
+  resolve.info = resolve_info;
+  resolve.depth = depth;
+  resolve.rect = scene::ResolveRectFor(edram_info.base_tiles, original_base, edram_info.pitch_tiles, log2_x, log2_y,
+                                       resolve_info.coordinate_info.edram_offset_x_div_8,
+                                       resolve_info.coordinate_info.edram_offset_y_div_8,
+                                       resolve_info.coordinate_info.width_div_8, resolve_info.height_div_8, window_x,
+                                       window_y);
+  resolve.region = scene::CaptureRegionFor(resolve.rect, double(render_width_) / double(guest_width_),
+                                           double(render_height_) / double(guest_height_), render_width_,
+                                           render_height_);
+
+  // Each plane is taken at the first resolve after it was drawn, before a resolve clears it.
+  const uint32_t planes = uint32_t(!depth && color_fresh_) | uint32_t(depth_fresh_) << 1;
+  if (planes && resolve.region.width && resolve.region.height) {
+    const uint32_t tile_width = kEdramTileWidth * resolution_scale_x_;
+    const uint32_t tile_height = kEdramTileHeight * resolution_scale_y_;
+    const uint32_t tile_dwords = tile_width * tile_height;
+    CaptureConstants constants = {};
+    constants.color_base_dwords = surface_->color_base * tile_dwords;
+    constants.depth_base_dwords = surface_->depth_base * tile_dwords;
+    constants.pitch_dwords = std::max(uint32_t(edram_info.pitch_tiles), uint32_t(1)) * tile_dwords;
+    constants.edram_size_dwords = xenos::kEdramTileCount * tile_dwords;
+    constants.tile_width = tile_width;
+    constants.tile_height = tile_height;
+    constants.sample_count_log2_x = log2_x;
+    constants.sample_count_log2_y = log2_y;
+    constants.source_origin[0] = resolve.region.source_x;
+    constants.source_origin[1] = resolve.region.source_y;
+    constants.dest_origin[0] = resolve.region.dest_x;
+    constants.dest_origin[1] = resolve.region.dest_y;
+    constants.region_size[0] = resolve.region.width;
+    constants.region_size[1] = resolve.region.height;
+    constants.depth_is_float24 = surface_->depth_format == xenos::DepthRenderTargetFormat::kD24FS8;
+    constants.capture_planes = planes;
+    render_target_cache_.PrepareEdramBufferForComputeRead();
+    Transition(color_, color_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Transition(depth_, depth_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Dispatch(capture_pipeline_, &constants, sizeof(constants) / sizeof(uint32_t), {nullptr, nullptr},
+             {DXGI_FORMAT_UNKNOWN, DXGI_FORMAT_UNKNOWN}, {color_, depth_},
+             {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_R32_FLOAT}, resolve.region.width, resolve.region.height);
+  }
+  (depth ? depth_resolves_ : color_resolves_).push_back(resolve);
+  resolving_ = resolve;
+  scene_pending_ = true;
+  scene_captured_ |= !depth;
+}
+
+void SceneUpscaler::AfterResolve() {
+  if (!resolving_) {
+    return;
+  }
+  const SceneResolve resolve = *resolving_;
+  resolving_.reset();
+  color_fresh_ &= !resolve.info.rb_copy_control.color_clear_enable;
+  depth_fresh_ &= !resolve.info.rb_copy_control.depth_clear_enable;
+  // The game's own copy holds the smaller scene in a corner of the texture; whatever reads it before the scene is done
+  // gets it stretched to full size instead.
+  EncodeStaging(resolve.depth ? Encode::kStretchedDepth : Encode::kStretchedColor, &resolve);
+  if (!CopyStagingTo(resolve) && structure_mismatch_.empty()) {
+    structure_mismatch_ = "a scene resolve is outside the screen";
+  }
+}
+
+void SceneUpscaler::EvaluateOnCommandList(void* context, ID3D12GraphicsCommandList* command_list, const void* data) {
+  Feature& feature = *static_cast<Feature*>(context);
+  const EvaluateArgs& args = *static_cast<const EvaluateArgs*>(data);
+  if (feature.failed.load(std::memory_order_relaxed) || !feature.api) {
+    return;
+  }
+  if (args.create || !feature.handle) {
+    if (feature.handle) {
+      feature.api->release_feature(feature.handle);
+      feature.handle = nullptr;
+    }
+    if (feature.api->create_feature(command_list, &args.feature_desc, &feature.handle) != REX_DLSS_OK) {
+      REXGPU_WARN("DLSS: the feature can't be created ({})", feature.api->last_error());
+      feature.failed.store(true, std::memory_order_relaxed);
+      return;
+    }
+    feature.desc = args.feature_desc;
+  }
+  if (feature.api->evaluate(command_list, feature.handle, &args.evaluate) != REX_DLSS_OK) {
+    REXGPU_WARN("DLSS: evaluation failed ({})", feature.api->last_error());
+    feature.failed.store(true, std::memory_order_relaxed);
+    return;
+  }
+  feature.evaluations.fetch_add(1, std::memory_order_relaxed);
+}
+
+void SceneUpscaler::EncodeStaging(Encode encode, const SceneResolve* resolve) {
+  EncodeConstants constants = {};
+  constants.tile_width = kEdramTileWidth * resolution_scale_x_;
+  constants.tile_height = kEdramTileHeight * resolution_scale_y_;
+  constants.pitch_dwords = staging_pitch_tiles_ * constants.tile_width * constants.tile_height;
+  constants.mode = uint32_t(encode);
+  constants.source_scale[0] = float(render_width_) / float(output_width_);
+  constants.source_scale[1] = float(render_height_) / float(output_height_);
+  constants.source_texel_size[0] = 1.0f / float(render_width_);
+  constants.source_texel_size[1] = 1.0f / float(render_height_);
+  constants.depth_is_float24 = surface_->depth_format == xenos::DepthRenderTargetFormat::kD24FS8;
+  if (resolve) {
+    const scene::ResolveRect& rect = resolve->rect;
+    const auto clip = [](int32_t begin, uint32_t size, uint32_t limit, uint32_t scale, uint32_t& origin_out,
+                         uint32_t& size_out) {
+      const int32_t end = std::clamp(begin + int32_t(size), 0, int32_t(limit));
+      begin = std::clamp(begin, 0, int32_t(limit));
+      origin_out = uint32_t(begin) * scale;
+      size_out = uint32_t(end - begin) * scale;
+    };
+    clip(rect.screen_x, rect.width, guest_width_, resolution_scale_x_, constants.region_origin[0],
+         constants.region_size[0]);
+    clip(rect.screen_y, rect.height, guest_height_, resolution_scale_y_, constants.region_origin[1],
+         constants.region_size[1]);
+    constants.source_clamp[0] = float(resolve->region.dest_x);
+    constants.source_clamp[1] = float(resolve->region.dest_y);
+    constants.source_clamp[2] = float(resolve->region.dest_x + int32_t(resolve->region.width));
+    constants.source_clamp[3] = float(resolve->region.dest_y + int32_t(resolve->region.height));
+    if (!resolve->region.width || !resolve->region.height) {
+      return;
+    }
+  } else {
+    constants.region_size[0] = output_width_;
+    constants.region_size[1] = output_height_;
+    constants.source_clamp[2] = float(render_width_);
+    constants.source_clamp[3] = float(render_height_);
+  }
+  if (!constants.region_size[0] || !constants.region_size[1]) {
+    return;
+  }
+  ID3D12Resource* color_source = encode == Encode::kOutput ? output_ : color_;
+  Transition(color_, color_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(depth_, depth_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(output_, output_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(staging_, staging_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  Dispatch(encode_pipeline_, &constants, sizeof(constants) / sizeof(uint32_t), {color_source, depth_},
+           {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_R32_FLOAT}, {staging_, nullptr},
+           {DXGI_FORMAT_UNKNOWN, DXGI_FORMAT_UNKNOWN}, constants.region_size[0], constants.region_size[1]);
+  Transition(staging_, staging_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+}
+
+bool SceneUpscaler::CopyStagingTo(const SceneResolve& resolve) {
+  const scene::ResolveRect& rect = resolve.rect;
+  if (rect.screen_x < 0 || rect.screen_y < 0 || uint32_t(rect.screen_x) >= guest_width_ ||
+      uint32_t(rect.screen_y) >= guest_height_) {
+    return false;
+  }
+  draw_util::ResolveInfo info = resolve.info;
+  info.rb_copy_control.color_clear_enable = 0;
+  info.rb_copy_control.depth_clear_enable = 0;
+  // The staging buffer has one sample per pixel.
+  info.copy_dest_coordinate_info.copy_sample_select = draw_util::SanitizeCopySampleSelect(
+      info.copy_dest_coordinate_info.copy_sample_select, xenos::MsaaSamples::k1X, resolve.depth);
+  draw_util::ResolveEdramInfo& edram_info = resolve.depth ? info.depth_edram_info : info.color_edram_info;
+  const scene::StagingPlacement placement =
+      scene::StagingPlacementFor(uint32_t(rect.screen_x), uint32_t(rect.screen_y), staging_pitch_tiles_);
+  edram_info.msaa_samples = xenos::MsaaSamples::k1X;
+  edram_info.pitch_tiles = staging_pitch_tiles_;
+  edram_info.base_tiles = placement.base_tiles;
+  info.coordinate_info.edram_offset_x_div_8 = placement.edram_offset_x_div_8;
+  info.coordinate_info.edram_offset_y_div_8 = placement.edram_offset_y_div_8;
+  uint32_t written_address, written_length;
+  return render_target_cache_.CopyResolveToMemory(info, shared_memory_, texture_cache_, staging_, written_address,
+                                                  written_length);
+}
+
+void SceneUpscaler::FinishScene() {
+  scene_pending_ = false;
+  if (!runtime_ready_ || color_resolves_.empty()) {
+    color_resolves_.clear();
+    depth_resolves_.clear();
+    return;
+  }
+  uint32_t matched = 0;
+  uint32_t agreeing = 0;
+  const std::optional<scene::Matrix> reprojection = EstimateCameraReprojection(matched, agreeing);
+  last_matched_ = matched;
+  last_agreeing_ = agreeing;
+  const bool reset = reset_history_ || !reprojection || !scene_drawn_previous_frame_;
+  frames_camera_ += reprojection.has_value();
+  frames_camera_moving_ += reprojection && scene::DistanceFromIdentity(*reprojection) > 1.0e-4;
+  frames_reset_ += reset;
+
+  MotionConstants motion = {};
+  const scene::Matrix& clip_to_previous_clip = reprojection ? *reprojection : scene::kIdentity;
+  for (size_t i = 0; i < 16; ++i) {
+    motion.clip_to_previous_clip[i] = float(clip_to_previous_clip[i]);
+  }
+  std::copy(guest_viewport_.begin(), guest_viewport_.begin() + 4, motion.viewport_xy);
+  motion.viewport_z[0] = guest_viewport_[4] != 0.0f ? guest_viewport_[4] : 1.0f;
+  motion.viewport_z[1] = guest_viewport_[5];
+  motion.render_scale[0] = float(render_width_) / float(guest_width_);
+  motion.render_scale[1] = float(render_height_) / float(guest_height_);
+  const std::array<float, 2> jitter = JitterForFrame();
+  motion.jitter[0] = jitter[0];
+  motion.jitter[1] = jitter[1];
+  motion.render_size[0] = render_width_;
+  motion.render_size[1] = render_height_;
+  Transition(depth_, depth_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(color_, color_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(motion_, motion_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  Dispatch(motion_pipeline_, &motion, sizeof(motion) / sizeof(uint32_t), {depth_, nullptr},
+           {DXGI_FORMAT_R32_FLOAT, DXGI_FORMAT_R32_FLOAT}, {motion_, nullptr},
+           {DXGI_FORMAT_R16G16_FLOAT, DXGI_FORMAT_UNKNOWN}, render_width_, render_height_);
+  Transition(motion_, motion_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(output_, output_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_processor_.SubmitBarriers();
+
+  // A second scene in a frame would be a second step of DLSS's history.
+  const bool dlss = !feature_.failed.load(std::memory_order_relaxed) && !scenes_finished_this_frame_;
+  if (scenes_finished_this_frame_) {
+    structure_mismatch_ = "the scene was resolved in more than one pass in a frame";
+  }
+  ++scenes_finished_this_frame_;
+  if (dlss) {
+    if (feature_recreate_ && feature_.handle) {
+      // The previous feature may still be in use by submitted command lists.
+      command_processor_.AwaitAllQueueOperationsCompletion();
+    }
+    EvaluateArgs args = {};
+    args.create = feature_recreate_;
+    args.feature_desc.struct_size = sizeof(args.feature_desc);
+    args.feature_desc.render_width = render_width_;
+    args.feature_desc.render_height = render_height_;
+    args.feature_desc.output_width = output_width_;
+    args.feature_desc.output_height = output_height_;
+    args.feature_desc.quality = quality_;
+    args.feature_desc.flags =
+        REX_DLSS_FEATURE_MV_LOW_RES | (depth_inverted_ ? REX_DLSS_FEATURE_DEPTH_INVERTED : 0u);
+    args.feature_desc.preset = uint32_t(REXCVAR_GET(d3d12_dlss_preset));
+    RexDlssEvaluateDesc& evaluate = args.evaluate;
+    evaluate.struct_size = sizeof(evaluate);
+    evaluate.color = color_;
+    evaluate.depth = depth_;
+    evaluate.motion_vectors = motion_;
+    evaluate.output = output_;
+    evaluate.render_width = render_width_;
+    evaluate.render_height = render_height_;
+    evaluate.jitter_x = jitter[0];
+    evaluate.jitter_y = jitter[1];
+    evaluate.mv_scale_x = 1.0f;
+    evaluate.mv_scale_y = 1.0f;
+    evaluate.pre_exposure = 1.0f;
+    evaluate.reset = reset || feature_recreate_;
+    command_processor_.GetDeferredCommandList().ExternalCall(EvaluateOnCommandList, &feature_, &args,
+                                                             sizeof(args));
+    command_processor_.InvalidateCommandListState();
+    feature_recreate_ = false;
+  }
+  Transition(output_, output_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+
+  // The textures of resolves that later ones cover again keep their stretched earlier content.
+  uint32_t final_resolves = 0;
+  if (dlss) {
+    EncodeStaging(Encode::kOutput, nullptr);
+    std::vector<scene::ResolveRect> rects;
+    for (const SceneResolve& resolve : color_resolves_) {
+      rects.push_back(resolve.rect);
+    }
+    const std::vector<bool> covered = scene::CoveredByLater(rects);
+    for (size_t i = 0; i < color_resolves_.size(); ++i) {
+      if (!covered[i] && CopyStagingTo(color_resolves_[i])) {
+        ++final_resolves;
+      }
+    }
+  }
+  reset_history_ = false;
+  ++frames_finished_;
+
+  if (!active_logged_) {
+    active_logged_ = true;
+    REXGPU_INFO(
+        "DLSS: {} | scene color EDRAM base {} {} {}x MSAA -> {}x{} RGBA8 | depth base {} {} {} -> R32F | motion: camera "
+        "reprojection from static draws ({} of {} agree) -> RG16F | output {}x{} written to {} of {} color resolve(s), "
+        "{} depth resolve(s) stretched | HUD and menus at full resolution",
+        dlss ? "active" : "not evaluated (scene stretched)", surface_->color_base,
+        surface_->color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA ? "k_8_8_8_8_GAMMA" : "k_8_8_8_8",
+        1u << uint32_t(surface_->msaa), render_width_, render_height_, surface_->depth_base,
+        surface_->depth_format == xenos::DepthRenderTargetFormat::kD24FS8 ? "D24FS8" : "D24S8",
+        depth_inverted_ ? "inverted" : "normal", agreeing, matched, output_width_, output_height_, final_resolves,
+        color_resolves_.size(), depth_resolves_.size());
+  }
+  color_resolves_.clear();
+  depth_resolves_.clear();
+}
+
+void SceneUpscaler::BeforeSwap() {
+  if (!enabled_ || disabled_) {
+    return;
+  }
+  if (scene_pending_) {
+    FinishScene();
+  }
+  if (feature_.failed.load(std::memory_order_relaxed) && runtime_ready_) {
+    DisableForSession("DLSS stopped working");
+  }
+  if (!structure_mismatch_.empty() && runtime_ready_) {
+    DisableForSession(structure_mismatch_);
+  }
+  if (runtime_ready_ && scene_drawn_ && !scene_captured_) {
+    // The reduced-size scene would reach the screen as the game drew it.
+    DisableForSession("the scene was drawn but not resolved where DLSS expects it");
+  }
+  scene_captured_ = false;
+  // The surface the game drew its scene into most this frame, when the remembered one wasn't drawn.
+  if (!scene_drawn_) {
+    uint64_t best_key = 0;
+    uint32_t best_draws = 0;
+    for (const auto& [key, draws] : candidate_draws_) {
+      if (draws > best_draws) {
+        best_key = key;
+        best_draws = draws;
+      }
+    }
+    if (best_draws >= kSceneSurfaceMinDraws) {
+      Surface surface;
+      surface.color_base = uint32_t(best_key & 0xFFFF);
+      surface.depth_base = uint32_t((best_key >> 16) & 0xFFFF);
+      surface.msaa = xenos::MsaaSamples((best_key >> 32) & 0xFF);
+      surface.color_format = xenos::ColorRenderTargetFormat((best_key >> 40) & 0xFF);
+      surface.depth_format = xenos::DepthRenderTargetFormat((best_key >> 48) & 0xFF);
+      surface_ = surface;
+      reset_history_ = true;
+      REXGPU_INFO("DLSS: scene surface found: color base {} {}x MSAA, depth base {}, {} draws in a frame",
+                  surface.color_base, 1u << uint32_t(surface.msaa), surface.depth_base, best_draws);
+    }
+  }
+  candidate_draws_.clear();
+  scene_drawn_previous_frame_ = scene_drawn_;
+  scene_drawn_ = false;
+  color_fresh_ = depth_fresh_ = false;
+  resolving_.reset();
+  viewport_known_ = false;
+  previous_matrices_.swap(matrices_);
+  matrices_.clear();
+  draw_occurrences_.clear();
+  scenes_finished_this_frame_ = 0;
+  if (runtime_ready_) {
+    ++jitter_index_;
+  }
+  if (runtime_ready_ && frames_finished_ >= last_summary_frame_ + 600) {
+    REXGPU_INFO(
+        "DLSS: {} frames | camera found in {}, moving in {} | history resets {} | static draws agreeing {} of {}",
+        frames_finished_ - last_summary_frame_, frames_camera_, frames_camera_moving_, frames_reset_, last_agreeing_,
+        last_matched_);
+    last_summary_frame_ = frames_finished_;
+    frames_camera_ = 0;
+    frames_camera_moving_ = 0;
+    frames_reset_ = 0;
+  }
+}
