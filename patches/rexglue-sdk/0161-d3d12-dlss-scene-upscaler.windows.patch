diff --git a/src/graphics/shaders/scene_capture.cs.hlsl b/src/graphics/shaders/scene_capture.cs.hlsl
new file mode 100644
index 0000000..e1ac387
--- /dev/null
+++ b/src/graphics/shaders/scene_capture.cs.hlsl
@@ -0,0 +1,61 @@
+// Copies a resolved region of the scene's color (samples averaged) and depth (sample 0, as 0 to 1) from the EDRAM to
+// the DLSS input textures. From src/graphics/shaders, then without trailing spaces:
+//   fxc /nologo /T cs_5_1 /O3 /E main /Vn scene_capture_cs /Fh bytecode/d3d12_5_1/scene_capture_cs.h
+//       scene_capture.cs.hlsl
+
+#include "scene_upscaler.hlsli"
+
+cbuffer constants : register(b0) {
+  uint color_base_dwords;
+  uint depth_base_dwords;
+  uint pitch_dwords;
+  uint edram_size_dwords;
+
+  uint tile_width;
+  uint tile_height;
+  uint sample_count_log2_x;
+  uint sample_count_log2_y;
+
+  int2 source_origin;
+  int2 dest_origin;
+
+  uint2 region_size;
+  uint depth_is_float24;
+  uint capture_planes;
+};
+
+ByteAddressBuffer edram : register(t0);
+RWTexture2D<unorm float4> color_out : register(u0);
+RWTexture2D<float> depth_out : register(u1);
+
+float4 UnpackColor(uint packed) {
+  return float4(uint4(packed, packed >> 8u, packed >> 16u, packed >> 24u) & 0xFFu) * (1.0f / 255.0f);
+}
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= region_size)) {
+    return;
+  }
+  uint2 source = uint2(source_origin + int2(id.xy));
+  uint2 dest = uint2(dest_origin + int2(id.xy));
+  uint2 sample0 = source << uint2(sample_count_log2_x, sample_count_log2_y);
+  if ((capture_planes & 1u) != 0u) {
+    uint offset = XeSceneEdramSampleOffset(sample0, tile_width, tile_height, pitch_dwords, false);
+    uint sample_count = 1u << (sample_count_log2_x + sample_count_log2_y);
+    float4 color = 0.0f;
+    [unroll] for (uint i = 0u; i < 4u; ++i) {
+      if (i < sample_count) {
+        uint sample_offset = (i & 1u) * tile_width + (i >> 1u);
+        color += UnpackColor(
+            edram.Load(XeSceneEdramWrap(color_base_dwords + offset + sample_offset, edram_size_dwords) << 2u));
+      }
+    }
+    color_out[dest] = color / float(sample_count);
+  }
+  if ((capture_planes & 2u) != 0u) {
+    uint depth_offset = XeSceneEdramSampleOffset(sample0, tile_width, tile_height, pitch_dwords, true);
+    uint depth_stencil = edram.Load(XeSceneEdramWrap(depth_base_dwords + depth_offset, edram_size_dwords) << 2u);
+    depth_out[dest] = XeSceneDecodeDepth(depth_stencil, depth_is_float24 != 0u);
+  }
+}
diff --git a/src/graphics/shaders/scene_encode.cs.hlsl b/src/graphics/shaders/scene_encode.cs.hlsl
new file mode 100644
index 0000000..d93f628
--- /dev/null
+++ b/src/graphics/shaders/scene_encode.cs.hlsl
@@ -0,0 +1,64 @@
+// Writes the scene at the output size into a single-sampled EDRAM-layout buffer that the resolve copy shaders then copy
+// into the game's scene textures: mode 0 copies the DLSS output, mode 1 stretches the render-size color bilinearly and
+// mode 2 the render-size depth, both from within source_clamp only (one resolve's pixels). From src/graphics/shaders,
+// then without trailing spaces:
+//   fxc /nologo /T cs_5_1 /O3 /E main /Vn scene_encode_cs /Fh bytecode/d3d12_5_1/scene_encode_cs.h
+//       scene_encode.cs.hlsl
+
+#include "scene_upscaler.hlsli"
+
+cbuffer constants : register(b0) {
+  uint pitch_dwords;
+  uint tile_width;
+  uint tile_height;
+  uint mode;
+
+  uint2 region_origin;
+  uint2 region_size;
+
+  // Source pixels per output pixel, and one over the source texture's size.
+  float2 source_scale;
+  float2 source_texel_size;
+
+  // Source pixels: left, top, right, bottom.
+  float4 source_clamp;
+
+  uint depth_is_float24;
+};
+
+Texture2D<float4> color : register(t0);
+Texture2D<float> depth : register(t1);
+RWByteAddressBuffer staging : register(u0);
+SamplerState linear_clamp : register(s0);
+
+uint PackColor(float4 value) {
+  uint4 bytes = uint4(saturate(value) * 255.0f + 0.5f);
+  return bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u);
+}
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= region_size)) {
+    return;
+  }
+  uint2 position = region_origin + id.xy;
+  bool is_depth = mode == 2u;
+  uint packed;
+  if (mode == 0u) {
+    packed = PackColor(color[position]);
+  } else {
+    float2 source_position = (float2(position) + 0.5f) * source_scale;
+    if (is_depth) {
+      uint2 texel = uint2(clamp(floor(source_position), source_clamp.xy, source_clamp.zw - 1.0f));
+      float value = depth[texel];
+      uint depth24 = depth_is_float24 != 0u ? XeSceneFloat32To20e4(value)
+                                            : uint(round(saturate(value) * 16777215.0f));
+      packed = depth24 << 8u;
+    } else {
+      source_position = clamp(source_position, source_clamp.xy + 0.5f, source_clamp.zw - 0.5f);
+      packed = PackColor(color.SampleLevel(linear_clamp, source_position * source_texel_size, 0.0f));
+    }
+  }
+  uint offset = XeSceneEdramSampleOffset(position, tile_width, tile_height, pitch_dwords, is_depth);
+  staging.Store(offset << 2u, packed);
+}
diff --git a/src/graphics/shaders/scene_motion.cs.hlsl b/src/graphics/shaders/scene_motion.cs.hlsl
new file mode 100644
index 0000000..a287b48
--- /dev/null
+++ b/src/graphics/shaders/scene_motion.cs.hlsl
@@ -0,0 +1,41 @@
+// Camera motion vectors for DLSS from the scene depth: each pixel's unjittered position is reprojected with
+// clip_to_previous_clip, the previous frame's view-projection times the inverse of the current one, and the result is
+// where the surface was in the previous frame minus where it is now, in render pixels. From src/graphics/shaders, then
+// without trailing spaces:
+//   fxc /nologo /T cs_5_1 /O3 /E main /Vn scene_motion_cs /Fh bytecode/d3d12_5_1/scene_motion_cs.h
+//       scene_motion.cs.hlsl
+
+cbuffer constants : register(b0) {
+  // Rows of the matrix, applied to column vectors.
+  float4 clip_to_previous_clip[4];
+  // The guest viewport: screen = ndc * scale + offset, in guest pixels.
+  float4 viewport_scale_offset_xy;
+  float2 viewport_scale_offset_z;
+  // Render pixels per guest pixel.
+  float2 render_scale;
+  float2 jitter;
+  uint2 render_size;
+};
+
+Texture2D<float> depth : register(t0);
+RWTexture2D<float2> motion_vectors : register(u0);
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= render_size)) {
+    return;
+  }
+  float2 render_position = float2(id.xy) + 0.5f - jitter;
+  float2 screen = render_position / render_scale;
+  float3 ndc = float3((screen - viewport_scale_offset_xy.yw) / viewport_scale_offset_xy.xz,
+                      (depth[id.xy] - viewport_scale_offset_z.y) / viewport_scale_offset_z.x);
+  float4 clip = float4(ndc, 1.0f);
+  float4 previous = float4(dot(clip_to_previous_clip[0], clip), dot(clip_to_previous_clip[1], clip),
+                           dot(clip_to_previous_clip[2], clip), dot(clip_to_previous_clip[3], clip));
+  float2 motion = 0.0f;
+  if (previous.w > 1.0e-6f) {
+    float2 previous_screen = previous.xy / previous.w * viewport_scale_offset_xy.xz + viewport_scale_offset_xy.yw;
+    motion = previous_screen * render_scale - render_position;
+  }
+  motion_vectors[id.xy] = motion;
+}
diff --git a/src/graphics/shaders/scene_upscaler.hlsli b/src/graphics/shaders/scene_upscaler.hlsli
new file mode 100644
index 0000000..60bbacd
--- /dev/null
+++ b/src/graphics/shaders/scene_upscaler.hlsli
@@ -0,0 +1,51 @@
+// The 32bpp EDRAM layout of the rasterizer-ordered view path (dxbc_translator_om.cpp
+// StartPixelShader_LoadROVParameters): tiles of tile_width x tile_height samples, 2x MSAA doubling the sample rows
+// and 4x the columns, samples of a pixel at +0, +tile_width, +1, +tile_width + 1, and depth with the 40-sample
+// halves of each tile swapped.
+
+uint XeSceneEdramSampleOffset(uint2 sample_position, uint tile_width, uint tile_height, uint pitch_dwords,
+                              bool depth) {
+  uint2 tile = sample_position / uint2(tile_width, tile_height);
+  uint2 in_tile = sample_position - tile * uint2(tile_width, tile_height);
+  if (depth) {
+    uint half_width = tile_width >> 1;
+    in_tile.x = in_tile.x >= half_width ? in_tile.x - half_width : in_tile.x + half_width;
+  }
+  return tile.y * pitch_dwords + tile.x * (tile_width * tile_height) + in_tile.y * tile_width + in_tile.x;
+}
+
+uint XeSceneEdramWrap(uint address, uint edram_size_dwords) {
+  return address >= edram_size_dwords ? address - edram_size_dwords : address;
+}
+
+// xenos::Float20e4To32 and xenos::Float32To20e4 with rounding to nearest even.
+float XeSceneFloat20e4To32(uint f24) {
+  f24 &= 0xFFFFFFu;
+  uint mantissa = f24 & 0xFFFFFu;
+  uint exponent = f24 >> 20u;
+  if (exponent == 0u && mantissa != 0u) {
+    uint mantissa_lzcnt = 20u - firstbithigh(mantissa);
+    exponent = 1u - mantissa_lzcnt;
+    mantissa = (mantissa << mantissa_lzcnt) & 0xFFFFFu;
+  }
+  return f24 != 0u ? asfloat(((exponent + 112u) << 23u) | (mantissa << 3u)) : 0.0f;
+}
+
+// rex::graphics::d3d12::scene::DecodeDepth: the depth in bits 8:31 of an EDRAM depth/stencil word, as 0 to 1.
+float XeSceneDecodeDepth(uint depth_stencil, bool float24) {
+  uint depth24 = depth_stencil >> 8u;
+  return float24 ? XeSceneFloat20e4To32(depth24) : float(depth24) * (1.0f / 16777215.0f);
+}
+
+uint XeSceneFloat32To20e4(float f32) {
+  uint bits = asuint(f32);
+  if (bits < 0x38800000u) {
+    uint shift = min(113u - (bits >> 23u), 24u);
+    bits = (0x800000u | (bits & 0x7FFFFFu)) >> shift;
+  } else {
+    bits += 0xC8000000u;
+  }
+  bits += 3u + ((bits >> 3u) & 1u);
+  uint f24 = (bits >> 3u) & 0xFFFFFFu;
+  return !(f32 > 0.0f) ? 0u : (asuint(f32) >= 0x3FFFFFF8u ? 0xFFFFFFu : f24);
+}
