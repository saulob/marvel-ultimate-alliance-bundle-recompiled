+namespace rex::graphics {
+class RegisterFile;
+class Shader;
+}  // namespace rex::graphics
+
+namespace rex::graphics::d3d12 {
+
+class D3D12CommandProcessor;
+class D3D12RenderTargetCache;
+class D3D12SharedMemory;
+class D3D12TextureCache;
+
+// NVIDIA DLSS Super Resolution of the 3D scene only. Draws into the multisampled color and depth surfaces the game
+// renders its scene in are drawn smaller (by the scale DLSS asks for) and jittered. At each resolve of the scene, its
+// color and depth are copied out of the EDRAM and the game's texture gets them stretched to full size; when the scene
+// is done, camera motion vectors are computed from the depth and the object-to-clip matrices of draws with static
+// vertex shaders, DLSS runs, and its output replaces the textures with the scene's final content, so everything the
+// game draws from them afterwards (post-processing, HUD, menus) keeps the full resolution.
+class SceneUpscaler {
+ public:
+  SceneUpscaler(D3D12CommandProcessor& command_processor, D3D12RenderTargetCache& render_target_cache,
+                D3D12TextureCache& texture_cache, D3D12SharedMemory& shared_memory);
+  ~SceneUpscaler();
+
+  bool Initialize(uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y);
+  void Shutdown();
+
+  bool enabled() const { return enabled_; }
+
+  struct DrawAdjustment {
+    bool scene = false;
