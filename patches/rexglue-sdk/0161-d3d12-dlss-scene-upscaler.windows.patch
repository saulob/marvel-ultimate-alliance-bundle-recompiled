+std::optional<RexDlssQuality> ParseMode(const std::string& mode) {
+  if (mode == "dlaa") return REX_DLSS_QUALITY_DLAA;
+  if (mode == "quality") return REX_DLSS_QUALITY_QUALITY;
+  if (mode == "balanced") return REX_DLSS_QUALITY_BALANCED;
+  if (mode == "performance") return REX_DLSS_QUALITY_PERFORMANCE;
+  if (mode == "ultra_performance") return REX_DLSS_QUALITY_ULTRA_PERFORMANCE;
+  return std::nullopt;
+}
+
+const char* QualityName(RexDlssQuality quality) {
+  switch (quality) {
+    case REX_DLSS_QUALITY_DLAA:
+      return "DLAA";
+    case REX_DLSS_QUALITY_QUALITY:
+      return "Quality";
+    case REX_DLSS_QUALITY_BALANCED:
+      return "Balanced";
+    case REX_DLSS_QUALITY_PERFORMANCE:
+      return "Performance";
+    default:
+      return "Ultra Performance";
+  }
+}
