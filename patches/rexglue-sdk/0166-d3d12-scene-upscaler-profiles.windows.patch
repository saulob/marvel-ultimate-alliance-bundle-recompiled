Scene profiles for the scene upscaler of 0161 to 0165: DLSS and FSR 3.1 run only for a game whose renderer has one.
d3d12_scene_profile names it (empty by default, which leaves both off before anything loads); scene_layout.h's
kSceneProfiles holds the rule that finds the game's 3D scene surface: the least multisampling, the color formats and
the draws in a frame. mua1 is Marvel Ultimate Alliance's and its Gold Edition's, and keeps the rule 0161 had
(2x or more, k_8_8_8_8 or k_8_8_8_8_GAMMA, 20 draws), so their scene detection is unchanged. The scene surface and
runtime log lines name the profile.

diff --git a/include/rex/graphics/d3d12/scene_layout.h b/include/rex/graphics/d3d12/scene_layout.h
index 685f390..8c7cd42 100644
--- a/include/rex/graphics/d3d12/scene_layout.h
+++ b/include/rex/graphics/d3d12/scene_layout.h
@@ -7,6 +7,7 @@
 #include <cstring>
 #include <numeric>
 #include <optional>
+#include <string_view>
 #include <vector>
 
 // Geometry and math of the scene upscaler (NVIDIA DLSS, AMD FSR 3.1) that doesn't need a GPU.
@@ -634,4 +635,38 @@ inline std::optional<CameraProjection> ConsensusCameraProjection(const std::vect
   return best == SIZE_MAX ? std::nullopt : std::optional<CameraProjection>(projections[best]);
 }
 
+// xenos::MsaaSamples and xenos::ColorRenderTargetFormat values.
+inline constexpr uint32_t kMsaa2xLog2 = 1;
+inline constexpr uint32_t kColorFormat8888 = 0;
+inline constexpr uint32_t kColorFormat8888Gamma = 1;
+
+// How a game's renderer draws its 3D scene: the scene is the multisampled color and depth surface with depth-tested
+// draws that a frame draws into most, at least min_draws times, in one of color_formats.
+struct SceneProfile {
+  std::string_view key;
+  uint32_t min_msaa_samples_log2;
+  std::array<uint32_t, 2> color_formats;
+  uint32_t min_draws;
+};
+
+// Marvel Ultimate Alliance and its Gold Edition draw with one renderer and the same assets and shaders.
+inline constexpr std::array kSceneProfiles = {
+    SceneProfile{"mua1", kMsaa2xLog2, {kColorFormat8888, kColorFormat8888Gamma}, 20},
+};
+
+inline const SceneProfile* FindSceneProfile(std::string_view key) {
+  for (const SceneProfile& profile : kSceneProfiles) {
+    if (profile.key == key) {
+      return &profile;
+    }
+  }
+  return nullptr;
+}
+
+inline bool IsSceneSurfaceCandidate(const SceneProfile& profile, uint32_t msaa_samples_log2, uint32_t color_format) {
+  return msaa_samples_log2 >= profile.min_msaa_samples_log2 &&
+         std::find(profile.color_formats.begin(), profile.color_formats.end(), color_format) !=
+             profile.color_formats.end();
+}
+
 }  // namespace rex::graphics::d3d12::scene
