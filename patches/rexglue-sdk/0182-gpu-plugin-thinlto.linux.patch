The Linux half of 0086: the Release GPU plugin is built with ThinLTO, so the command processor's per-draw
path can be inlined across its translation units.

diff --git a/src/graphics/CMakeLists.txt b/src/graphics/CMakeLists.txt
index 1879857..8447776 100644
--- a/src/graphics/CMakeLists.txt
+++ b/src/graphics/CMakeLists.txt
@@ -113,6 +113,13 @@ target_include_directories(rexgpu-xenos PRIVATE
 
 target_compile_options(rexgpu-xenos PRIVATE -Wno-unused-variable)
 
+# ThinLTO in Release: the command processor's per-draw path calls across many translation units (render target,
+# texture and pipeline caches, shared memory, register file), which only link-time optimization can inline.
+if(NOT WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    target_compile_options(rexgpu-xenos PRIVATE $<$<CONFIG:Release>:-flto=thin>)
+    target_link_options(rexgpu-xenos PRIVATE $<$<CONFIG:Release>:-flto=thin>)
+endif()
+
 rex_target_pch(rexgpu-xenos
     <mutex>
     <unordered_map>
