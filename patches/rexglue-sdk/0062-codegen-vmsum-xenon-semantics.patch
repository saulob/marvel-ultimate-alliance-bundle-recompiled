 //=============================================================================
+// Vector Dot Products (vmsum3fp128 / vmsum4fp128)
+//=============================================================================
+
+// Xenon accumulates the products in double, rounds once to float and adds in the order of Xenia's
+// DOT_PRODUCT_3/4. A finite sum that overflows float gives the default NaN, not infinity as dpps does.
+// Guest element i is host lane 3 - i.
+
+namespace rex::ppc {
+namespace detail {
+inline simde__m128 VmsumResult(simde__m128d sum) {
+  const double total = simde_mm_cvtsd_f64(sum);
+  float result = float(total);
+  if (std::isinf(result) && std::isfinite(total)) {
+    result = std::numeric_limits<float>::quiet_NaN();
+  }
+  return simde_mm_set1_ps(result);
+}
+
+// {w * w', z * z'} and {y * y', x * x'}.
+inline void VmsumProducts(simde__m128 a, simde__m128 b, simde__m128d& wz, simde__m128d& yx) {
+  wz = simde_mm_mul_pd(simde_mm_cvtps_pd(a), simde_mm_cvtps_pd(b));
+  yx = simde_mm_mul_pd(simde_mm_cvtps_pd(simde_mm_movehl_ps(a, a)),
+                       simde_mm_cvtps_pd(simde_mm_movehl_ps(b, b)));
+}
+}  // namespace detail
+
+// (x + z) + y
+inline simde__m128 simde_mm_vmsum3fp(simde__m128 a, simde__m128 b) {
+  simde__m128d wz, yx;
+  detail::VmsumProducts(a, b, wz, yx);
+  const simde__m128d pairs = simde_mm_add_pd(yx, wz);
+  return detail::VmsumResult(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), yx));
+}
+
+// (x + z) + (y + w)
+inline simde__m128 simde_mm_vmsum4fp(simde__m128 a, simde__m128 b) {
+  simde__m128d wz, yx;
+  detail::VmsumProducts(a, b, wz, yx);
+  const simde__m128d pairs = simde_mm_add_pd(yx, wz);
+  return detail::VmsumResult(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), pairs));
+}
+}  // namespace rex::ppc
+
