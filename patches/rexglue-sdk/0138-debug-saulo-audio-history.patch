+/**
+ * DEBUG_SAULO, temporary: a bounded in-memory history of audio events. Dump() logs the last five seconds of it and,
+ * two seconds later, what came after the request.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace rex::audio::history {
+
+enum class Event : uint16_t {
+  kPacket,
+  kFrame,
+  kDecodeError,
+  kAdvance,
+  kSwap,
+  kContinuationWait,
+  kPendingPacket,
+  kInputBuffers,
+  kLoop,
+  kCodecOpen,
+  kNoProgress,
+  kOutputInvalid,
+  kStarved,
+  kAllocate,
+  kRelease,
+  kClear,
+  kDisableWait,
+  kQueueEmpty,
+  kCallbackGap,
+  kSubmitGap,
+  kQueueDepth,
+};
+
+enum FrameFlags : uint32_t {
+  kFrameSplitHeader = 1,
+  kFrameCrossesPacket = 2,
+  kFrameNextFromOtherBuffer = 4,
+  kFrameDecoded = 8,
+  kFrameLoopEnd = 16,
+  kFrameLoopStart = 32,
+};
+
+enum class SwapReason : uint32_t {
+  kCurrentInvalid = 1,
+  kSplitHeaderOutOfRange,
+  kNoBitsToCopy,
+};
+
+// Error kinds from FFmpeg's XMA decoder; kOther for any other message.
+enum class ErrorKind : uint32_t {
+  kOther,
+  kSkipBits,
+  kScaleFactor,
+  kSpectralRle,
+  kVecCoeffs,
+  kReservedBit,
+  kFillBits,
+};
+
+void Record(Event event, uint32_t context, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0, uint32_t d = 0,
+            uint32_t e = 0);
+void RecordDecodeError(uint32_t context, std::string_view message, uint32_t location, uint32_t read_offset);
+
+void Dump(std::string_view reason);
+void Shutdown();
+
+}  // namespace rex::audio::history
