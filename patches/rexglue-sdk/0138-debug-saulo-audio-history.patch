--- /dev/null
+++ b/src/audio/audio_history.cpp
@@ -0,0 +1,353 @@
+// DEBUG_SAULO, temporary: see audio_history.h.
+
+#include <rex/audio/audio_history.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rex/chrono/clock.h>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+
+namespace rex::audio::history {
+namespace {
+
+constexpr uint64_t kCapacity = uint64_t(1) << 16;
+constexpr int64_t kBeforeNs = 5'000'000'000;
+constexpr int64_t kAfterNs = 2'000'000'000;
+constexpr uint32_t kNone = 0xFFFFFFFF;
+
+// Writers claim a slot with one fetch_add and publish it with a sequence number, so the reader can drop a slot that
+// was overwritten while it was copied instead of making writers wait.
+struct Slot {
+  std::atomic<uint64_t> sequence{0};
+  std::atomic<uint64_t> words[4] = {};
+};
+
+struct Entry {
+  int64_t time_ns = 0;
+  Event event = Event::kPacket;
+  uint32_t context = 0;
+  uint32_t a = 0, b = 0, c = 0, d = 0, e = 0;
+};
+
+Slot g_slots[kCapacity];
+std::atomic<uint64_t> g_head{0};
+
+std::mutex g_dump_mutex;
+std::condition_variable g_dump_wake;
+bool g_dump_running = false;
+bool g_stopping = false;
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// The entries recorded between from_ns and to_ns, in time order, and the time of the oldest entry still held.
+std::vector<Entry> Collect(int64_t from_ns, int64_t to_ns, int64_t* oldest_ns) {
+  const uint64_t head = g_head.load(std::memory_order_acquire);
+  const uint64_t first = head > kCapacity ? head - kCapacity : 0;
+  std::vector<Entry> entries;
+  entries.reserve(size_t(head - first));
+  *oldest_ns = to_ns;
+  for (uint64_t index = first; index < head; ++index) {
+    const Slot& slot = g_slots[index & (kCapacity - 1)];
+    const uint64_t sequence = slot.sequence.load(std::memory_order_acquire);
+    if (sequence != index * 2 + 2) {
+      continue;
+    }
+    uint64_t words[4];
+    for (int i = 0; i < 4; ++i) {
+      words[i] = slot.words[i].load(std::memory_order_relaxed);
+    }
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (slot.sequence.load(std::memory_order_relaxed) != sequence) {
+      continue;
+    }
+    Entry entry;
+    entry.time_ns = int64_t(words[0]);
+    entry.event = Event(words[1] & 0xFFFF);
+    entry.context = uint32_t(words[1] >> 16) & 0xFFFF;
+    entry.a = uint32_t(words[1] >> 32);
+    entry.b = uint32_t(words[2]);
+    entry.c = uint32_t(words[2] >> 32);
+    entry.d = uint32_t(words[3]);
+    entry.e = uint32_t(words[3] >> 32);
+    *oldest_ns = std::min(*oldest_ns, entry.time_ns);
+    if (entry.time_ns >= from_ns && entry.time_ns <= to_ns) {
+      entries.push_back(entry);
+    }
+  }
+  std::stable_sort(entries.begin(), entries.end(),
+                   [](const Entry& x, const Entry& y) { return x.time_ns < y.time_ns; });
+  return entries;
+}
+
+const char* ErrorKindName(uint32_t kind) {
+  switch (ErrorKind(kind)) {
+    case ErrorKind::kSkipBits:
+      return "skip-bits";
+    case ErrorKind::kScaleFactor:
+      return "invalid-scale-factor";
+    case ErrorKind::kSpectralRle:
+      return "spectral-rle-overflow";
+    case ErrorKind::kVecCoeffs:
+      return "num-vec-coeffs";
+    case ErrorKind::kReservedBit:
+      return "reserved-bit";
+    case ErrorKind::kFillBits:
+      return "fill-bits";
+    default:
+      return "other";
+  }
+}
+
+std::string FrameFlagsText(uint32_t flags) {
+  std::string text;
+  const auto add = [&](uint32_t flag, const char* name) {
+    if (flags & flag) {
+      text += text.empty() ? name : std::string(",") + name;
+    }
+  };
+  add(kFrameSplitHeader, "split-header");
+  add(kFrameCrossesPacket, "crosses-packet");
+  add(kFrameNextFromOtherBuffer, "other-buffer");
+  add(kFrameDecoded, "decoded");
+  add(kFrameLoopEnd, "loop-end");
+  add(kFrameLoopStart, "loop-start");
+  return text.empty() ? "-" : text;
+}
+
+std::string LocationText(uint32_t location) {
+  if (location == kNone) {
+    return "none";
+  }
+  return "b" + std::to_string(location & 1) + "p" + std::to_string(location >> 1);
+}
+
+std::string ValidText(uint32_t bits) {
+  return "valid=" + std::to_string(bits & 1) + std::to_string((bits >> 1) & 1) + " current=" +
+         std::to_string((bits >> 2) & 1);
+}
+
+void LogEntry(const char* section, const Entry& x, int64_t trigger_ns) {
+  const double ms = double(x.time_ns - trigger_ns) / 1e6;
+  const std::string ctx = x.context == 0xFFFF ? std::string("-") : std::to_string(x.context);
+  switch (x.event) {
+    case Event::kPacket:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} packet b{}p{} of {} header {:08X} @{:08X}", section, ms, ctx, x.a, x.b,
+                  x.c, x.d, x.e);
+      break;
+    case Event::kFrame:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} frame {} {}/{} bit {} size {} next {} [{}]", section, ms, ctx,
+                  LocationText(x.a), x.c & 0xFF, (x.c >> 8) & 0xFF, x.b, x.d, LocationText(x.e),
+                  FrameFlagsText(x.c >> 16));
+      break;
+    case Event::kDecodeError:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} FFMPEG ERROR {} values {} {} at {} bit {}", section, ms, ctx,
+                  ErrorKindName(x.a), int32_t(x.b), int32_t(x.c), LocationText(x.d), x.e);
+      break;
+    case Event::kAdvance:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} advance from {} buffers finished {} -> {} pending packet {} {}", section,
+                  ms, ctx, LocationText(x.a), x.b, x.c == kNone ? std::string("not found") : "bit " + std::to_string(x.c),
+                  x.d, ValidText(x.e));
+      break;
+    case Event::kSwap:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} swap reason {} -> buffer {} {} bit {}", section, ms, ctx,
+                  x.a == uint32_t(SwapReason::kCurrentInvalid)          ? "current-invalid"
+                  : x.a == uint32_t(SwapReason::kSplitHeaderOutOfRange) ? "split-header-out-of-range"
+                                                                        : "no-bits",
+                  x.b, ValidText(x.c), x.d);
+      break;
+    case Event::kContinuationWait:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} wait for other buffer: {} at {} next packet index {} of {}", section, ms,
+                  ctx, x.d == 1 ? "split header" : "frame tail", LocationText(x.a), x.b, x.c);
+      break;
+    case Event::kPendingPacket:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} carried skip applied: buffer {} packet {} -> {}", section, ms, ctx, x.a,
+                  x.b, x.c == kNone ? std::string("not found") : "bit " + std::to_string(x.c));
+      break;
+    case Event::kInputBuffers:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} input buffers {} b0 @{:08X} x{} b1 @{:08X} x{} read bit {}", section, ms,
+                  ctx, ValidText(x.a), x.b, x.d & 0xFFFF, x.c, x.d >> 16, x.e);
+      break;
+    case Event::kLoop:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} loop jump: count {} start {} end {} subframe skip {} end {}", section, ms,
+                  ctx, x.a, x.b, x.c, x.d & 0xFF, x.d >> 8);
+      break;
+    case Event::kCodecOpen:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} decoder reopened: {} Hz {} ch", section, ms, ctx, x.a, x.b);
+      break;
+    case Event::kNoProgress:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} no progress: {} read bit {} output read {} write {} blocks {} free {}",
+                  section, ms, ctx, ValidText(x.a), x.b, x.c & 0xFF, (x.c >> 8) & 0xFF, x.c >> 16, int32_t(x.d));
+      break;
+    case Event::kOutputInvalid:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} output buffer full: read {} write {} blocks {}", section, ms, ctx, x.a,
+                  x.b, x.c);
+      break;
+    case Event::kStarved:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} STARVED: no input, output read {} write {}", section, ms, ctx, x.a, x.b);
+      break;
+    case Event::kAllocate:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} allocated", section, ms, ctx);
+      break;
+    case Event::kRelease:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} released", section, ms, ctx);
+      break;
+    case Event::kClear:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} cleared", section, ms, ctx);
+      break;
+    case Event::kDisableWait:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} disable waited {:.2f} ms", section, ms, ctx, x.a / 1000.0);
+      break;
+    case Event::kQueueEmpty:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} OUTPUT QUEUE EMPTY: {} silent frame(s), {} queued", section, ms, ctx, x.a,
+                  x.b);
+      break;
+    case Event::kCallbackGap:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} output callback late: {:.2f} ms since the last, {} queued", section, ms,
+                  ctx, x.a / 1000.0, x.b);
+      break;
+    case Event::kSubmitGap:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} guest submit late: {:.2f} ms since the last, {} queued", section, ms, ctx,
+                  x.a / 1000.0, x.b);
+      break;
+    case Event::kQueueDepth:
+      REXAPU_INFO("{} {:+10.3f} ms ctx={} output queue {} (min {} max {})", section, ms, ctx, x.a, x.b, x.c);
+      break;
+  }
+}
+
+void LogSection(const char* section, const std::vector<Entry>& entries, int64_t trigger_ns) {
+  for (const Entry& entry : entries) {
+    LogEntry(section, entry, trigger_ns);
+  }
+}
+
+void DumpThread(std::string reason, int64_t trigger_ns, uint32_t guest_ms, int64_t guest_updates) {
+  int64_t oldest_ns = 0;
+  const std::vector<Entry> before = Collect(trigger_ns - kBeforeNs, trigger_ns, &oldest_ns);
+  REXAPU_INFO(
+      "DEBUG_SAULO AUDIO SNAPSHOT BEGIN reason={} guest uptime {} ms guest updates {} | {} event(s) from {:.0f} ms "
+      "before the request (history holds {:.0f} ms)",
+      reason, guest_ms, guest_updates, before.size(), kBeforeNs / 1e6, (trigger_ns - oldest_ns) / 1e6);
+  LogSection("DEBUG_SAULO AUDIO", before, trigger_ns);
+  REXAPU_INFO("DEBUG_SAULO AUDIO SNAPSHOT END reason={}", reason);
+
+  bool stopped;
+  {
+    std::unique_lock lock(g_dump_mutex);
+    stopped = g_dump_wake.wait_for(lock, std::chrono::nanoseconds(kAfterNs), [] { return g_stopping; });
+  }
+  const std::vector<Entry> after = Collect(trigger_ns + 1, trigger_ns + kAfterNs, &oldest_ns);
+  REXAPU_INFO("DEBUG_SAULO AUDIO SNAPSHOT POST reason={} | {} event(s) in the {:.0f} ms after the request{}", reason,
+              after.size(), kAfterNs / 1e6, stopped ? " (cut short by shutdown)" : "");
+  LogSection("DEBUG_SAULO AUDIO POST", after, trigger_ns);
+  REXAPU_INFO("DEBUG_SAULO AUDIO SNAPSHOT POST END reason={}", reason);
+
+  std::lock_guard lock(g_dump_mutex);
+  g_dump_running = false;
+  g_dump_wake.notify_all();
+}
+
+int32_t NumberAt(std::string_view text, size_t* position) {
+  while (*position < text.size()) {
+    const char ch = text[*position];
+    const bool negative = ch == '-' && *position + 1 < text.size() && text[*position + 1] >= '0' &&
+                          text[*position + 1] <= '9';
+    if ((ch >= '0' && ch <= '9') || negative) {
+      break;
+    }
+    ++*position;
+  }
+  if (*position >= text.size()) {
+    return 0;
+  }
+  const bool negative = text[*position] == '-';
+  if (negative) {
+    ++*position;
+  }
+  int64_t value = 0;
+  while (*position < text.size() && text[*position] >= '0' && text[*position] <= '9') {
+    value = std::min<int64_t>(value * 10 + (text[*position] - '0'), INT32_MAX);
+    ++*position;
+  }
+  return int32_t(negative ? -value : value);
+}
+
+ErrorKind ClassifyError(std::string_view message) {
+  if (message.find("would have to skip") != std::string_view::npos) {
+    return ErrorKind::kSkipBits;
+  }
+  if (message.find("scale factor") != std::string_view::npos) {
+    return ErrorKind::kScaleFactor;
+  }
+  if (message.find("spectral RLE") != std::string_view::npos) {
+    return ErrorKind::kSpectralRle;
+  }
+  if (message.find("num_vec_coeffs") != std::string_view::npos) {
+    return ErrorKind::kVecCoeffs;
+  }
+  if (message.find("Reserved bit") != std::string_view::npos) {
+    return ErrorKind::kReservedBit;
+  }
+  if (message.find("fill bits") != std::string_view::npos) {
+    return ErrorKind::kFillBits;
+  }
+  return ErrorKind::kOther;
+}
+
+}  // namespace
+
+void Record(Event event, uint32_t context, uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint32_t e) {
+  const uint64_t index = g_head.fetch_add(1, std::memory_order_relaxed);
+  Slot& slot = g_slots[index & (kCapacity - 1)];
+  slot.sequence.store(index * 2 + 1, std::memory_order_relaxed);
+  std::atomic_thread_fence(std::memory_order_release);
+  slot.words[0].store(uint64_t(NowNs()), std::memory_order_relaxed);
+  slot.words[1].store(uint64_t(event) | uint64_t(context & 0xFFFF) << 16 | uint64_t(a) << 32,
+                      std::memory_order_relaxed);
+  slot.words[2].store(uint64_t(b) | uint64_t(c) << 32, std::memory_order_relaxed);
+  slot.words[3].store(uint64_t(d) | uint64_t(e) << 32, std::memory_order_relaxed);
+  slot.sequence.store(index * 2 + 2, std::memory_order_release);
+}
+
+void RecordDecodeError(uint32_t context, std::string_view message, uint32_t location, uint32_t read_offset) {
+  size_t position = 0;
+  const int32_t first = NumberAt(message, &position);
+  const int32_t second = NumberAt(message, &position);
+  Record(Event::kDecodeError, context, uint32_t(ClassifyError(message)), uint32_t(first), uint32_t(second),
+         location, read_offset);
+}
+
+void Dump(std::string_view reason) {
+  const int64_t trigger_ns = NowNs();
+  {
+    std::lock_guard lock(g_dump_mutex);
+    if (g_dump_running || g_stopping) {
+      REXAPU_INFO("DEBUG_SAULO AUDIO SNAPSHOT SKIPPED reason={}: the previous snapshot is still being written", reason);
+      return;
+    }
+    g_dump_running = true;
+  }
+  std::thread(DumpThread, std::string(reason), trigger_ns, rex::chrono::Clock::QueryGuestUptimeMillis(),
+              rex::perf::GetCounter(rex::perf::CounterId::kGuestUpdates))
+      .detach();
+}
+
+void Shutdown() {
+  std::unique_lock lock(g_dump_mutex);
+  g_stopping = true;
+  g_dump_wake.notify_all();
+  g_dump_wake.wait_for(lock, std::chrono::seconds(1), [] { return !g_dump_running; });
+}
+
+}  // namespace rex::audio::history
