+
+void RecordFrame(uint32_t context, const XMA_CONTEXT_DATA& data, const DecodeTrace& trace, uint32_t next_packet_index,
+                 bool decoded, bool loop_end, bool loop_start) {
+  uint32_t flags = (trace.split_header ? history::kFrameSplitHeader : 0) |
+                   (trace.crosses_packet ? history::kFrameCrossesPacket : 0) |
+                   (trace.next_from_other_buffer ? history::kFrameNextFromOtherBuffer : 0) |
+                   (decoded ? history::kFrameDecoded : 0) | (loop_end ? history::kFrameLoopEnd : 0) |
+                   (loop_start ? history::kFrameLoopStart : 0);
+  uint32_t next = UINT32_MAX;
+  if (trace.split_header || trace.crosses_packet) {
+    const uint32_t packet_counts[2] = {data.input_buffer_0_packet_count, data.input_buffer_1_packet_count};
+    xma::StreamPacket location;
+    if (xma::LocateStreamPacket(uint8_t(trace.buffer), next_packet_index, packet_counts, &location)) {
+      next = location.buffer | location.packet << 1;
+    }
+  }
+  history::Record(history::Event::kFrame, context, trace.buffer | trace.packet_index << 1, trace.read_offset,
+                  trace.frame_in_packet | trace.frames_in_packet << 8 | flags << 16, trace.frame_size, next);
+}
