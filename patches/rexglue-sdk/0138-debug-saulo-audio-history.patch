+
+uint64_t InputBuffersKey(const XMA_CONTEXT_DATA& data) {
+  return uint64_t(InputBufferBits(data)) | uint64_t(data.input_buffer_0_packet_count) << 3 |
+         uint64_t(data.input_buffer_1_packet_count) << 15 |
+         (uint64_t(data.input_buffer_0_ptr) ^ uint64_t(data.input_buffer_1_ptr) << 13) << 27;
