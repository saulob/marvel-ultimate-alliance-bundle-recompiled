+constexpr uint32_t kHistoryContext = 0xFFFF;
+constexpr int64_t kLateSubmitUs = 12000;
+constexpr int64_t kLateCallbackUs = 25000;
+constexpr int64_t kDepthSampleUs = 100000;
+
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void NoteSubmit(size_t queued) {
+  static std::atomic<int64_t> last_us{0};
+  const int64_t now = NowUs();
+  const int64_t last = last_us.exchange(now, std::memory_order_relaxed);
+  if (last && now - last >= kLateSubmitUs) {
+    history::Record(history::Event::kSubmitGap, kHistoryContext, uint32_t(now - last), uint32_t(queued));
+  }
+}
+
+// Runs on SDL's audio thread only.
+void NoteCallback(size_t queued, uint32_t silent_frames) {
+  static int64_t last_us = 0;
+  static int64_t depth_window_us = 0;
+  static uint32_t depth_min = UINT32_MAX;
+  static uint32_t depth_max = 0;
+  const int64_t now = NowUs();
+  if (last_us && now - last_us >= kLateCallbackUs) {
+    history::Record(history::Event::kCallbackGap, kHistoryContext, uint32_t(now - last_us), uint32_t(queued));
+  }
+  last_us = now;
+  if (silent_frames) {
+    history::Record(history::Event::kQueueEmpty, kHistoryContext, silent_frames, uint32_t(queued));
+  }
+  depth_min = std::min(depth_min, uint32_t(queued));
+  depth_max = std::max(depth_max, uint32_t(queued));
+  if (now - depth_window_us >= kDepthSampleUs) {
+    history::Record(history::Event::kQueueDepth, kHistoryContext, uint32_t(queued), depth_min, depth_max);
+    depth_window_us = now;
+    depth_min = UINT32_MAX;
+    depth_max = 0;
+  }
+}
+
