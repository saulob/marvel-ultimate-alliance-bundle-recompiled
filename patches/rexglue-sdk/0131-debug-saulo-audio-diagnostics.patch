+  bool next_from_other_buffer = false;
+  uint32_t loop_count = 0;
+  uint32_t loop_start = 0;
+  uint32_t loop_end = 0;
+  bool stereo = false;
+  const uint8_t* packet = nullptr;
+  const uint8_t* next_packet = nullptr;
+  const uint8_t* copied = nullptr;
+  bool reported = false;
