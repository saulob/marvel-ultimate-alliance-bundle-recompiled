+std::atomic<uint32_t> g_error_lines{0};
+std::atomic<uint32_t> g_slow_lines{0};
+std::atomic<uint32_t> g_summary_lines{0};
+std::atomic<uint64_t> g_works{0};
+std::atomic<uint64_t> g_inline_works{0};
+std::atomic<uint64_t> g_decodes{0};
+std::atomic<uint64_t> g_errors{0};
+std::atomic<uint64_t> g_starved{0};
+std::atomic<uint64_t> g_slow{0};
+std::atomic<uint64_t> g_lock_waits{0};
+std::atomic<int64_t> g_max_work_us{0};
+std::atomic<int64_t> g_next_summary_ns{0};
+
+// Errors that differ only in their numbers are one kind: the first of each is logged with its context, the rest are
+// counted into the 10-second summary.
+struct ErrorKind {
+  std::string text;
+  uint32_t repeats = 0;
+};
+constexpr size_t kMaxErrorKinds = 32;
+std::mutex g_kinds_mutex;
+std::vector<ErrorKind> g_kinds;
+
+std::string ErrorKindOf(std::string_view message) {
+  std::string kind;
+  for (size_t i = 0; i < message.size(); ++i) {
+    const bool digit = message[i] >= '0' && message[i] <= '9';
+    const bool negative = message[i] == '-' && i + 1 < message.size() && message[i + 1] >= '0' && message[i + 1] <= '9';
+    if (digit || negative) {
+      if (kind.empty() || kind.back() != '#') {
+        kind += '#';
+      }
+    } else {
+      kind += message[i];
+    }
+  }
+  return kind;
+}
+
+// Whether this is the first error of its kind; a kind beyond the table is treated as new.
+bool NoteErrorKind(std::string_view message) {
+  const std::string kind = ErrorKindOf(message);
+  std::lock_guard lock(g_kinds_mutex);
+  for (ErrorKind& known : g_kinds) {
+    if (known.text == kind) {
+      ++known.repeats;
+      return false;
+    }
+  }
+  if (g_kinds.size() < kMaxErrorKinds) {
+    g_kinds.push_back({kind, 0});
+  }
+  return true;
+}
+
+std::string TakeRepeatsText() {
+  std::lock_guard lock(g_kinds_mutex);
+  std::string text;
+  for (ErrorKind& kind : g_kinds) {
+    if (kind.repeats) {
+      text += (text.empty() ? "" : "; ") + std::to_string(kind.repeats) + "x '" + kind.text + "'";
+      kind.repeats = 0;
+    }
+  }
+  return text.empty() ? "none" : text;
+}
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+uint32_t LoadBE32(const uint8_t* bytes) {
+  return (uint32_t(bytes[0]) << 24) | (uint32_t(bytes[1]) << 16) | (uint32_t(bytes[2]) << 8) | bytes[3];
+}
+
+// Whether guest memory no longer holds the bytes the decoder was given.
+bool SourceChanged(const DecodeTrace& trace) {
+  constexpr size_t kData = XmaContext::kBytesPerPacketData;
+  if (std::memcmp(trace.packet + XmaContext::kBytesPerPacketHeader, trace.copied, kData)) {
+    return true;
+  }
+  return trace.next_packet &&
+         std::memcmp(trace.next_packet + XmaContext::kBytesPerPacketHeader, trace.copied + kData, kData);
+}
+
+void MaybeLogSummary() {
+  const int64_t now = NowNs();
+  int64_t next = g_next_summary_ns.load(std::memory_order_relaxed);
+  if (next == 0) {
+    g_next_summary_ns.compare_exchange_strong(next, now + kSummaryWindowNs);
+    return;
+  }
+  if (now < next || !g_next_summary_ns.compare_exchange_strong(next, now + kSummaryWindowNs)) {
+    return;
+  }
+  const uint64_t works = g_works.exchange(0);
+  const uint64_t inline_works = g_inline_works.exchange(0);
+  const uint64_t decodes = g_decodes.exchange(0);
+  const uint64_t errors = g_errors.exchange(0);
+  const uint64_t starved = g_starved.exchange(0);
+  const uint64_t slow = g_slow.exchange(0);
+  const uint64_t lock_waits = g_lock_waits.exchange(0);
+  const int64_t max_work_us = g_max_work_us.exchange(0);
+  const std::string repeats = TakeRepeatsText();
+  if ((errors || starved || slow || lock_waits) && g_summary_lines.fetch_add(1) < kMaxSummaryLines) {
+    REXAPU_INFO(
+        "DEBUG_SAULO XMA 10s: work {} (inline {}) | decodes {} | errors {} | starved {} | slow >10ms {} | "
+        "max work {:.2f} ms | lock waits >5ms {} | repeats {}",
+        works, inline_works, decodes, errors, starved, slow, max_work_us / 1000.0, lock_waits, repeats);
+  }
+}
+
+class WorkTimer {
+ public:
+  explicit WorkTimer(uint32_t context) : context_(context), start_ns_(NowNs()) {}
+  ~WorkTimer() {
+    const int64_t us = (NowNs() - start_ns_) / 1000;
+    g_works.fetch_add(1, std::memory_order_relaxed);
+    if (t_inline_kick) {
+      g_inline_works.fetch_add(1, std::memory_order_relaxed);
+    }
+    int64_t max = g_max_work_us.load(std::memory_order_relaxed);
+    while (us > max && !g_max_work_us.compare_exchange_weak(max, us, std::memory_order_relaxed)) {
+    }
+    if (us >= kSlowWorkUs) {
+      g_slow.fetch_add(1, std::memory_order_relaxed);
+      if (g_slow_lines.fetch_add(1) < kMaxSlowLines) {
+        REXAPU_INFO("DEBUG_SAULO XMA slow work: ctx={} {:.2f} ms {}", context_, us / 1000.0,
+                    t_inline_kick ? "inline" : "worker");
+      }
+    }
+    MaybeLogSummary();
+  }
+
+ private:
+  uint32_t context_;
+  int64_t start_ns_;
+};
+
+}  // namespace
+
+void DebugSauloSetInlineKick(bool inline_kick) {
+  t_inline_kick = inline_kick;
+}
+
+void DebugSauloNoteLockWait(uint32_t context, double ms) {
+  g_lock_waits.fetch_add(1, std::memory_order_relaxed);
+  if (g_slow_lines.fetch_add(1) < kMaxSlowLines) {
+    REXAPU_INFO("DEBUG_SAULO XMA lock wait: ctx={} {:.2f} ms", context, ms);
+  }
+}
+
+// Called from the FFmpeg log callback, on the decoding thread, inside DecodePacket.
+void DebugSauloReportDecodeError(std::string_view message) {
+  while (!message.empty() && (message.back() == '\n' || message.back() == '\r')) {
+    message.remove_suffix(1);
+  }
+  DecodeTrace* trace = t_trace;
+  if (!trace) {
+    if (g_error_lines.fetch_add(1) < kMaxErrorLines) {
+      REXAPU_INFO("DEBUG_SAULO XMA error outside a traced decode: '{}'", message);
+    }
+    return;
+  }
+  if (trace->reported) {
+    return;
+  }
+  trace->reported = true;
+  g_errors.fetch_add(1, std::memory_order_relaxed);
+  if (!NoteErrorKind(message) || g_error_lines.fetch_add(1) >= kMaxErrorLines) {
+    return;
+  }
+  REXAPU_INFO(
+      "DEBUG_SAULO XMA error: ctx={} '{}' | buffer {} @{:08X} packets {} | packet {} header {:08X} (frames {}, first "
+      "bit {}, skip {}) | frame {} at bit {} size {} | split header {} crosses packet {} next from other buffer {} | "
+      "loop {} {}..{} | stereo {} | source changed {} | word0 {:08X} -> {:08X} | {}",
+      trace->context, message, trace->buffer, trace->buffer_address, trace->packet_count, trace->packet_index,
+      trace->packet_header, trace->frames_in_packet, xma::GetPacketFrameOffset(trace->packet),
+      trace->packet_header & 0xFF, trace->frame_in_packet, trace->read_offset, trace->frame_size, trace->split_header,
+      trace->crosses_packet, trace->next_from_other_buffer, trace->loop_count, trace->loop_start, trace->loop_end,
+      trace->stereo, SourceChanged(*trace), trace->initial_word0,
+      XMA_CONTEXT_DATA::LoadWord(trace->context_ptr, 0), t_inline_kick ? "inline" : "worker");
+}
