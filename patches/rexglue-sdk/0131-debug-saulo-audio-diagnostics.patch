+constexpr uint32_t kMaxErrorLines = 150;
+constexpr uint32_t kMaxSlowLines = 40;
+constexpr uint32_t kMaxSummaryLines = 60;
+constexpr int64_t kSlowWorkUs = 10000;
+constexpr int64_t kSummaryWindowNs = 10'000'000'000;
