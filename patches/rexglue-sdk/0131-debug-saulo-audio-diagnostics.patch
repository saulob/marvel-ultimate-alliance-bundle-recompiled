+
+void MaybeLogUnderruns() {
+  thread_local auto window_start = std::chrono::steady_clock::now();
+  const auto now = std::chrono::steady_clock::now();
+  if (now - window_start < std::chrono::seconds(10)) {
+    return;
+  }
+  window_start = now;
+  const uint32_t underruns = g_underruns.exchange(0);
+  const uint32_t max_queued = g_max_queued.exchange(0);
+  if (underruns && g_underrun_lines.fetch_add(1) < kMaxUnderrunLines) {
+    REXAPU_INFO("DEBUG_SAULO audio queue 10s: {} silent frame(s) for an empty queue | max queued {}", underruns,
