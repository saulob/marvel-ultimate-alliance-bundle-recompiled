Adapted from Aegis-Wing-XBLA-PC-Recomp patches/rexglue.patch (function_dispatcher.cpp, ppc/context.h); the same invariant is handled by the FP exception guards of king-kong-recompiled (kk/src/fpe_guard.cpp) and earthworm-jim-hd-recompiled. Host FP exceptions are masked whenever guest code is entered on a native thread that never ran XThread::Execute (XHostThread::Execute, FunctionDispatcher::Execute for host callbacks, ExecuteInterrupt for the GPU and vsync interrupts), and again when mffs reads MXCSR. Otherwise a zeroed FPSCR context makes the first flush-mode write set MXCSR with every exception unmasked, and the first invalid operation crashes the process (guest FP exceptions are never delivered).

diff --git a/include/rex/ppc/context.h b/include/rex/ppc/context.h
index 0ede542..5a16575 100644
--- a/include/rex/ppc/context.h
+++ b/include/rex/ppc/context.h
@@ -168,6 +168,9 @@ struct FPSCRRegister {
 
   inline uint32_t loadFromHost() noexcept {
     csr = getcsr();
+    // A driver or codec on this thread may have changed MXCSR; FP exceptions must stay masked.
+    Platform::InitHostExceptions(csr);
+    setcsr(csr);
     return HostToGuest[(csr & RoundMaskVal) >> RoundShift];
   }
 
diff --git a/src/system/function_dispatcher.cpp b/src/system/function_dispatcher.cpp
index bd43109..c81c246 100644
--- a/src/system/function_dispatcher.cpp
+++ b/src/system/function_dispatcher.cpp
@@ -70,6 +70,10 @@ bool FunctionDispatcher::Execute(ThreadState* thread_state, uint32_t address) {
   auto* ctx = thread_state->context();
   auto* previous_thread_state = ThreadState::Get();
 
+  // A native thread that never went through XThread::Execute (a host callback) has no exception
+  // mask yet, and guest FP exceptions are never delivered, so an unmasked one would crash.
+  ctx->fpscr.InitHost();
+
   // Rebind the active guest thread for cross-module callbacks.
   ThreadState::Bind(thread_state);
 
@@ -150,6 +154,9 @@ uint64_t FunctionDispatcher::ExecuteInterrupt(ThreadState* thread_state, uint32_
   auto* ctx = thread_state->context();
   assert_true(arg_count <= 5);
 
+  // Interrupts run on host threads (GPU, vsync) that never went through XThread::Execute.
+  ctx->fpscr.InitHost();
+
   if (arg_count > 0)
     ctx->r3.u64 = args[0];
   if (arg_count > 1)
diff --git a/src/system/xthread.cpp b/src/system/xthread.cpp
index 2bfb37a..6cef2a8 100644
--- a/src/system/xthread.cpp
+++ b/src/system/xthread.cpp
@@ -1558,6 +1558,8 @@ void XHostThread::Execute() {
   // Let the kernel know we are starting.
   kernel_state_->OnThreadExecute(this);
 
+  thread_state_->context()->fpscr.InitHost();
+
   int ret = host_fn_();
 
   // Exit.
