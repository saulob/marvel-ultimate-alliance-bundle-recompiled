diff --git a/src/core/dynlib_posix.cpp b/src/core/dynlib_posix.cpp
index fcfd6c9..cd58006 100644
--- a/src/core/dynlib_posix.cpp
+++ b/src/core/dynlib_posix.cpp
@@ -31,6 +31,12 @@ bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mo
   return handle_ != nullptr;
 }
 
+bool DynamicLibrary::LoadExisting(const std::filesystem::path& path) {
+  Close();
+  handle_ = dlopen(path.c_str(), RTLD_NOLOAD | RTLD_LAZY);
+  return handle_ != nullptr;
+}
+
 void DynamicLibrary::Close() {
   if (handle_) {
     dlclose(handle_);
diff --git a/src/core/dynlib_win.cpp b/src/core/dynlib_win.cpp
index a402c75..62aafa6 100644
--- a/src/core/dynlib_win.cpp
+++ b/src/core/dynlib_win.cpp
@@ -31,6 +31,16 @@ bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution /*
   return handle_ != nullptr;
 }
 
+bool DynamicLibrary::LoadExisting(const std::filesystem::path& path) {
+  Close();
+  // Without GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT this adds a reference, which Close releases.
+  HMODULE module = nullptr;
+  if (GetModuleHandleExW(0, path.c_str(), &module)) {
+    handle_ = static_cast<void*>(module);
+  }
+  return handle_ != nullptr;
+}
+
 void DynamicLibrary::Close() {
   if (handle_) {
     FreeLibrary(static_cast<HMODULE>(handle_));
