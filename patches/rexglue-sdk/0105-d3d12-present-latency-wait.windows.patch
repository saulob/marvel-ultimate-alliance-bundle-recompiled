 Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // When a driver forces V-Sync, Present waits for a free back buffer while
+  // holding the direct queue that the GPU emulation's submission thread also
+  // uses, which stalled the game to a fraction of the refresh rate (GitHub
+  // issue #16, 33 fps at 100 Hz). Waiting here instead keeps that wait off the
+  // queue. The timeout only guards against a lost signal.
+  if (paint_context_.frame_latency_waitable) {
+    WaitForSingleObjectEx(paint_context_.frame_latency_waitable, 100, TRUE);
+  }
+
   // Begin the command list with the command allocator not currently potentially
   // used on the GPU.
   UINT64 current_paint_submission = paint_context_.paint_submission_tracker.GetCurrentSubmission();
@@ -1166,9 +1203,12 @@ Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawe
   // fullscreen is ever used in, the allow tearing flag must not be passed in
   // fullscreen, but DXGI fullscreen is largely unneeded with the flip
   // presentation model used in Direct3D 12).
+  const UINT sync_interval = UINT(std::clamp(REXCVAR_GET(d3d12_present_test_sync_interval), 0, 4));
   HRESULT present_result = paint_context_.swap_chain->Present(
-      0, DXGI_PRESENT_RESTART |
-             (paint_context_.swap_chain_allows_tearing ? DXGI_PRESENT_ALLOW_TEARING : 0));
+      sync_interval,
+      DXGI_PRESENT_RESTART |
+          (paint_context_.swap_chain_allows_tearing && !sync_interval ? DXGI_PRESENT_ALLOW_TEARING
+                                                                     : 0));
   // Even if presentation has failed, work might have been enqueued anyway
   // internally before the failure according to Jesse Natalie from the DirectX
   // Discord server.
