@@ -104,7 +109,18 @@ X_STATUS AudioSystem::Setup(system::KernelState* kernel_state) {
   return X_STATUS_SUCCESS;
 }
 
+bool RaiseAudioThreadPriority() {
+#if defined(_WIN32)
+  return SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL) != 0;
+#else
+  return false;
+#endif
+}
+
 void AudioSystem::WorkerThreadMain() {
+  if (!RaiseAudioThreadPriority()) {
+    REXAPU_WARN("AudioWorker: cannot raise the thread priority");
+  }
   // Initialize driver and ringbuffer.
   Initialize();
 
