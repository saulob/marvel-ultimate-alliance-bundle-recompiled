+REXCVAR_DEFINE_UINT32(gpu_invalidation_expand_pages, 16, "GPU",
+                      "When the CPU writes a page the GPU holds a copy of, also drop the aligned "
+                      "group of this many pages around it (power of two, 1-64; 64 is the original "
+                      "whole block): fewer pages re-uploaded, more write faults")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
