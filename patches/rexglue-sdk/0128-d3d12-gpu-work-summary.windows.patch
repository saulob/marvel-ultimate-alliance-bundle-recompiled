+// One EDRAM render target as draws see it: the largest viewport drawn into it and the guest pixels those draws cover.
+struct GpuTargetStats {
+  bool depth_only = false;
+  uint32_t base = 0;
+  uint32_t format = 0;
+  uint32_t msaa = 0;
+  uint32_t pitch = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t draws = 0;
+  uint64_t pixels = 0;
+};
+
+struct GpuResolveStats {
+  uint32_t source_pitch = 0;
+  uint32_t dest_pitch = 0;
+  uint32_t dest_height = 0;
+  uint32_t count = 0;
+};
+
+// Touched only by the command processor thread.
+struct GpuWorkSummary {
+  std::chrono::steady_clock::time_point window_start;
+  uint64_t window_first_submission = 0;
+  uint32_t swaps = 0;
+  uint32_t draws = 0;
+  uint32_t copies = 0;
+  std::array<GpuTargetStats, 16> targets{};
+  size_t target_count = 0;
+  uint32_t untracked_draws = 0;
+  std::array<GpuResolveStats, 8> resolves{};
+  size_t resolve_count = 0;
+  uint32_t swap_packet_width = 0;
+  uint32_t swap_packet_height = 0;
+  uint32_t swap_texture_width = 0;
+  uint32_t swap_texture_height = 0;
+  uint32_t presenter_input_width = 0;
+  uint32_t presenter_input_height = 0;
+  std::chrono::steady_clock::duration fence_wait{};
+  std::chrono::steady_clock::duration submission_thread_wait{};
+};
+GpuWorkSummary g_gpu_work_summary;
+
+std::string SizeText(uint32_t width, uint32_t height) {
+  return std::to_string(width) + "x" + std::to_string(height);
+}
+
+// The guest viewport of a draw, or its window scissor when the viewport transform is off.
+std::pair<uint32_t, uint32_t> DrawExtent(const RegisterFile& regs, uint32_t pitch) {
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  uint32_t width = 0;
+  uint32_t height = 0;
+  const float x_scale = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE);
+  const float y_scale = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE);
+  if (vte.vport_x_scale_ena && vte.vport_y_scale_ena && std::isfinite(x_scale) && std::isfinite(y_scale)) {
+    width = uint32_t(std::min(std::fabs(x_scale) * 2.0f + 0.5f, 16384.0f));
+    height = uint32_t(std::min(std::fabs(y_scale) * 2.0f + 0.5f, 16384.0f));
+  } else {
+    const auto tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+    const auto br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+    width = br.br_x > tl.tl_x ? br.br_x - tl.tl_x : 0;
+    height = br.br_y > tl.tl_y ? br.br_y - tl.tl_y : 0;
+  }
+  return {pitch ? std::min(width, pitch) : width, height};
+}
+
+void NoteGpuWorkDraw(const RegisterFile& regs, xenos::EdramMode edram_mode) {
+  GpuWorkSummary& summary = g_gpu_work_summary;
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  GpuTargetStats draw;
+  draw.depth_only = edram_mode == xenos::EdramMode::kDepthOnly;
+  if (draw.depth_only) {
+    const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+    draw.base = depth_info.depth_base;
+    draw.format = uint32_t(depth_info.depth_format);
+  } else {
+    const auto color_info = regs.Get<reg::RB_COLOR_INFO>();
+    draw.base = color_info.color_base;
+    draw.format = uint32_t(color_info.color_format);
+  }
+  draw.msaa = 1u << uint32_t(surface_info.msaa_samples);
+  draw.pitch = surface_info.surface_pitch;
+  const auto [width, height] = DrawExtent(regs, draw.pitch);
+  GpuTargetStats* target = nullptr;
+  for (size_t i = 0; i < summary.target_count; ++i) {
+    GpuTargetStats& known = summary.targets[i];
+    if (known.depth_only == draw.depth_only && known.base == draw.base && known.format == draw.format &&
+        known.msaa == draw.msaa && known.pitch == draw.pitch) {
+      target = &known;
+      break;
+    }
+  }
+  if (!target) {
+    if (summary.target_count == summary.targets.size()) {
+      ++summary.untracked_draws;
+      return;
+    }
+    target = &summary.targets[summary.target_count++];
+    *target = draw;
+  }
+  target->width = std::max(target->width, width);
+  target->height = std::max(target->height, height);
+  ++target->draws;
+  target->pixels += uint64_t(width) * height;
+}
+
+void NoteGpuWorkResolve(const RegisterFile& regs) {
+  GpuWorkSummary& summary = g_gpu_work_summary;
+  const uint32_t source_pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  const auto dest = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  for (size_t i = 0; i < summary.resolve_count; ++i) {
+    GpuResolveStats& known = summary.resolves[i];
+    if (known.source_pitch == source_pitch && known.dest_pitch == dest.copy_dest_pitch &&
+        known.dest_height == dest.copy_dest_height) {
+      ++known.count;
+      return;
+    }
+  }
+  if (summary.resolve_count < summary.resolves.size()) {
+    summary.resolves[summary.resolve_count++] = {source_pitch, dest.copy_dest_pitch, dest.copy_dest_height, 1};
+  }
+}
+
+std::string GpuTargetsText(GpuWorkSummary& summary, double swaps, uint32_t scale_x, uint32_t scale_y) {
+  std::sort(summary.targets.begin(), summary.targets.begin() + summary.target_count,
+            [](const GpuTargetStats& a, const GpuTargetStats& b) { return a.pixels > b.pixels; });
+  uint64_t total = 0;
+  for (size_t i = 0; i < summary.target_count; ++i) {
+    total += summary.targets[i].pixels;
+  }
+  std::string text;
+  for (size_t i = 0; i < std::min<size_t>(summary.target_count, 5); ++i) {
+    const GpuTargetStats& target = summary.targets[i];
+    char draws[32];
+    std::snprintf(draws, sizeof(draws), "%.1f", target.draws / swaps);
+    text += (i ? "; " : "") + std::string(target.depth_only ? "depth" : "color") + " fmt " +
+            std::to_string(target.format) + " " + std::to_string(target.msaa) + "x base " +
+            std::to_string(target.base) + " pitch " + std::to_string(target.pitch) + ": " +
+            SizeText(target.width, target.height) + " guest -> " +
+            SizeText(target.width * scale_x, target.height * scale_y) + " host, " + draws + " draws/swap, " +
+            std::to_string(total ? target.pixels * 100 / total : 0) + "% of pixels";
+  }
+  if (summary.untracked_draws) {
+    text += "; " + std::to_string(summary.untracked_draws) + " draws on untracked targets";
+  }
+  return text.empty() ? "none" : text;
+}
+
+std::string GpuResolvesText(GpuWorkSummary& summary, double swaps) {
+  std::sort(summary.resolves.begin(), summary.resolves.begin() + summary.resolve_count,
+            [](const GpuResolveStats& a, const GpuResolveStats& b) { return a.count > b.count; });
+  std::string text;
+  for (size_t i = 0; i < std::min<size_t>(summary.resolve_count, 5); ++i) {
+    const GpuResolveStats& resolve = summary.resolves[i];
+    char count[32];
+    std::snprintf(count, sizeof(count), "%.1f", resolve.count / swaps);
+    text += (i ? "; " : "") + std::string("pitch ") + std::to_string(resolve.source_pitch) + " -> " +
+            SizeText(resolve.dest_pitch, resolve.dest_height) + " texture, " + count + "/swap";
+  }
+  return text.empty() ? "none" : text;
+}
+
+void NoteGpuWorkSwap(uint64_t current_submission, uint32_t scale_x, uint32_t scale_y, bool rov) {
+  constexpr auto kWindow = std::chrono::seconds(10);
+  GpuWorkSummary& summary = g_gpu_work_summary;
+  const auto now = std::chrono::steady_clock::now();
+  if (summary.swaps == 0 && summary.window_first_submission == 0) {
+    summary.window_start = now;
+    summary.window_first_submission = current_submission;
+  }
+  ++summary.swaps;
+  const auto elapsed = now - summary.window_start;
+  if (elapsed < kWindow) {
+    return;
+  }
+  if (REXCVAR_GET(gpu_work_summary)) {
+    const double swaps = double(summary.swaps);
+    const auto per_swap_ms = [swaps](std::chrono::steady_clock::duration total) {
+      return std::chrono::duration<double, std::milli>(total).count() / swaps;
+    };
+    REXGPU_INFO(
+        "GPU work: {:.1f} swaps/s; per swap {:.0f} draws, {:.1f} resolves, {:.1f} submissions, "
+        "{:.2f} ms waiting for the GPU, {:.2f} ms waiting for the submission thread",
+        swaps / std::chrono::duration<double>(elapsed).count(), summary.draws / swaps, summary.copies / swaps,
+        double(current_submission - summary.window_first_submission) / swaps, per_swap_ms(summary.fence_wait),
+        per_swap_ms(summary.submission_thread_wait));
+    REXGPU_INFO("GPU targets ({}, scale {}x{}): {}", rov ? "rov" : "host render targets", scale_x, scale_y,
+                GpuTargetsText(summary, swaps, scale_x, scale_y));
+    REXGPU_INFO("GPU resolves: {}", GpuResolvesText(summary, swaps));
+    REXGPU_INFO("GPU swap: packet {} guest, front buffer texture {} guest, presenter input {} host",
+                SizeText(summary.swap_packet_width, summary.swap_packet_height),
+                SizeText(summary.swap_texture_width, summary.swap_texture_height),
+                SizeText(summary.presenter_input_width, summary.presenter_input_height));
+  }
+  summary = GpuWorkSummary{};
+  summary.window_start = now;
+  summary.window_first_submission = current_submission;
+}
