+void Presenter::LogGuestOutputPaintFlow(const GuestOutputPaintFlow& flow, uint32_t swap_chain_width,
+                                        uint32_t swap_chain_height) {
+  struct Shape {
+    uint32_t input_width, input_height, output_width, output_height, swap_chain_width, swap_chain_height;
+    size_t effect_count;
+    GuestOutputPaintEffect last_effect;
+    bool operator==(const Shape&) const = default;
+  };
+  static Shape logged{};
+  if (!flow.effect_count) {
+    return;
+  }
+  const std::pair<uint32_t, uint32_t>& output = flow.effect_output_sizes[flow.effect_count - 1];
+  const Shape shape{flow.properties.frontbuffer_width, flow.properties.frontbuffer_height, output.first,
+                    output.second, swap_chain_width, swap_chain_height, flow.effect_count,
+                    flow.effects[flow.effect_count - 1]};
+  if (shape == logged) {
+    return;
+  }
+  logged = shape;
+  std::string effects;
+  for (size_t i = 0; i < flow.effect_count; ++i) {
+    const char* name = "other";
+    switch (flow.effects[i]) {
+      case GuestOutputPaintEffect::kBilinear:
+      case GuestOutputPaintEffect::kBilinearDither:
+        name = "bilinear";
+        break;
+      case GuestOutputPaintEffect::kCasSharpen:
+      case GuestOutputPaintEffect::kCasSharpenDither:
+        name = "cas sharpen";
+        break;
+      case GuestOutputPaintEffect::kCasResample:
+      case GuestOutputPaintEffect::kCasResampleDither:
+        name = "cas resample";
+        break;
+      case GuestOutputPaintEffect::kFsrEasu:
+        name = "fsr easu";
+        break;
+      case GuestOutputPaintEffect::kFsrRcas:
+      case GuestOutputPaintEffect::kFsrRcasDither:
+        name = "fsr rcas";
+        break;
+      default:
+        break;
+    }
+    effects += (i ? ", " : "") + std::string(name) + " " + std::to_string(flow.effect_output_sizes[i].first) + "x" +
+               std::to_string(flow.effect_output_sizes[i].second);
+  }
+  REXLOG_INFO("Presenter: input {}x{} | output {}x{} | swap chain {}x{} | effects: {}", shape.input_width,
+              shape.input_height, shape.output_width, shape.output_height, swap_chain_width, swap_chain_height,
+              effects);
+}
