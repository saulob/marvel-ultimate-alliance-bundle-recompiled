Adapted from GoldenEye-007-XBLA-PC-Recomp patches (graphics_system.cpp, the vblank part only): the vsync worker fires at most one vblank per wake and drops the backlog after a stall, instead of running the guest vblank interrupt back to back for every missed interval.

diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index fdb7562..e0298a9 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -162,9 +162,14 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           uint64_t interval_ticks =
               REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
-          while (current_time - last_frame_time >= interval_ticks) {
+          // At most one vblank per wake: after a stall the backlog is dropped instead of flooding
+          // the guest vblank interrupt.
+          if (current_time - last_frame_time >= interval_ticks) {
             MarkVblank();
             last_frame_time += interval_ticks;
+            if (current_time - last_frame_time >= interval_ticks) {
+              last_frame_time = current_time;
+            }
           }
           // Wait for the next vblank instead of polling for it.
           current_time = chrono::Clock::QueryGuestTickCount();
