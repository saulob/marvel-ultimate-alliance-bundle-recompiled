+// A surface's width in samples (PreSceneTargets keys): a 4x MSAA pixel is two samples wide.
+inline uint32_t PitchSamples(uint32_t key) {
+  return PreSceneTargets::Pitch(key) << uint32_t(PreSceneTargets::SamplesLog2(key) >= kMsaa4xLog2);
