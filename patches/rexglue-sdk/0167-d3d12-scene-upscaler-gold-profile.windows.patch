+inline bool IsSceneMemoryDraw(const SceneProfile& profile, uint32_t scene_key, uint32_t key, uint32_t base,
+                              uint32_t scene_color_base, uint32_t scene_depth_base) {
+  return profile.scene_memory_4x_draws && PreSceneTargets::SamplesLog2(key) == kMsaa4xLog2 &&
+         PreSceneTargets::SamplesLog2(scene_key) < kMsaa4xLog2 && PitchSamples(key) == PitchSamples(scene_key) &&
+         (base == scene_color_base || base == scene_depth_base);
