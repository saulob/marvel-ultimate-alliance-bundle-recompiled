+bool SceneUpscaler::IsSceneMemoryDraw(const RegisterFile& regs, xenos::EdramMode edram_mode,
+                                      bool pixel_shader_writes_color) const {
+  if (!profile_->scene_memory_4x_draws || !surface_ || scenes_finished_this_frame_ ||
+      (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly)) {
+    return false;
+  }
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const uint32_t base = edram_mode == xenos::EdramMode::kColorDepth && pixel_shader_writes_color
+                            ? uint32_t(regs.Get<reg::RB_COLOR_INFO>().color_base)
+                            : uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_base);
+  return scene::IsSceneMemoryDraw(
+      *profile_, scene_key_,
+      scene::PreSceneTargets::Key(surface_info.surface_pitch, uint32_t(surface_info.msaa_samples)), base,
+      surface_->color_base, surface_->depth_base);
+}
+
+// It lands where the scene's draws do, unjittered, and what it writes over is no longer the scene's.
+void SceneUpscaler::NoteSceneMemoryDraw(const RegisterFile& regs, xenos::EdramMode edram_mode,
+                                        bool pixel_shader_writes_color, DrawAdjustment& adjustment) {
+  uint32_t planes = 0;
+  if (edram_mode == xenos::EdramMode::kColorDepth && pixel_shader_writes_color) {
+    planes |= scene::ScenePlanesAt(regs.Get<reg::RB_COLOR_INFO>().color_base, surface_->color_base,
+                                   surface_->depth_base);
+  }
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  if (depth_control.z_enable && depth_control.z_write_enable) {
+    planes |= scene::ScenePlanesAt(regs.Get<reg::RB_DEPTH_INFO>().depth_base, surface_->color_base,
+                                   surface_->depth_base);
+  }
+  planes_.Clear(planes);
+  if (runtime_ready_) {
+    adjustment.scale_x = float(render_width_) / float(output_width_);
+    adjustment.scale_y = float(render_height_) / float(output_height_);
+  }
+}
