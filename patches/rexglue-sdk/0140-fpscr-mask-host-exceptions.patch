Port of rexglue-sdk#382: FPSCRRegister::setcsr applies Platform::InitHostExceptions to the value it writes, so a zeroed or guest-derived csr (storeFromGuest, enableFlushMode, ...) cannot unmask host FP exceptions. Guest rounding and flush bits are unchanged. Adds the upstream fpscr_test cases.

diff --git a/include/rex/ppc/context.h b/include/rex/ppc/context.h
index 5a16575..6f74df4 100644
--- a/include/rex/ppc/context.h
+++ b/include/rex/ppc/context.h
@@ -158,7 +158,11 @@ struct FPSCRRegister {
   static constexpr uint32_t GuestMask = uint32_t(RoundMaskVal) | uint32_t(FlushMask);
 
   inline uint32_t getcsr() noexcept { return Platform::getcsr(); }
-  inline void setcsr(uint32_t csr) noexcept { Platform::setcsr(csr); }
+  inline void setcsr(uint32_t csr) noexcept {
+    // A zeroed or guest-derived csr must not unmask host FP exceptions.
+    Platform::InitHostExceptions(csr);
+    Platform::setcsr(csr);
+  }
 
   // Restoring the whole word would unmask every FP exception when csr is 0.
   inline void restoreGuestBits(uint32_t saved) noexcept {
