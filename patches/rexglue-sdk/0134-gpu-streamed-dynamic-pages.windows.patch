+void SharedMemory::OnGuestFrameEnd() {
+  bool enabled = REXCVAR_GET(gpu_stream_dynamic_pages);
+  if (!enabled && !streamed_pages_active_) {
+    return;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  if (!num_system_page_flags_) {
+    return;
+  }
+  for (uint32_t page : streamed_pages_uploaded_) {
+    streamed_page_uploads_[page] = 0;
+  }
+  streamed_pages_uploaded_.clear();
+  // Streamed pages stop faulting, so forget them now and then: pages the game stopped rewriting
+  // every frame go back to being watched.
+  if (!enabled || ++streamed_pages_frames_ >= kStreamedPagesResetFrames) {
+    streamed_pages_frames_ = 0;
+    std::fill(system_page_flags_streamed_.begin(), system_page_flags_streamed_.end(), uint64_t(0));
+    std::fill(system_page_flags_streamed_blocked_.begin(),
+              system_page_flags_streamed_blocked_.end(), uint64_t(0));
+    streamed_page_shadows_.clear();
+  }
+  if (enabled) {
+    for (uint32_t block : faulted_blocks_) {
+      system_page_flags_streamed_[block] |= system_page_flags_faulted_[block] &
+                                            system_page_flags_faulted_previous_[block] &
+                                            ~system_page_flags_streamed_blocked_[block];
+    }
+  }
+  for (uint32_t block : faulted_blocks_previous_) {
+    system_page_flags_faulted_previous_[block] = 0;
+  }
+  faulted_blocks_previous_.clear();
+  if (enabled) {
+    for (uint32_t block : faulted_blocks_) {
+      system_page_flags_faulted_previous_[block] = system_page_flags_faulted_[block];
+    }
+    faulted_blocks_previous_.swap(faulted_blocks_);
+  }
+  for (uint32_t block : faulted_blocks_previous_) {
+    system_page_flags_faulted_[block] = 0;
+  }
+  for (uint32_t block : faulted_blocks_) {
+    system_page_flags_faulted_[block] = 0;
+  }
+  faulted_blocks_.clear();
+  streamed_pages_active_ = enabled;
+}
+
+void SharedMemory::MarkPageFaulted(uint32_t page) {
+  uint64_t& faulted = system_page_flags_faulted_[page >> 6];
+  if (!faulted) {
+    faulted_blocks_.push_back(page >> 6);
+  }
+  faulted |= uint64_t(1) << (page & 63);
+}
