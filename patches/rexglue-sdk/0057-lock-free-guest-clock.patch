+// The guest clock advances from guest_base at host_base at one ratio; a ratio change starts a new
+// segment at the current guest time, so readers take no lock. Segments are never freed.
+struct ClockSegment {
+  uint64_t host_base;
+  uint64_t guest_base;
+  uint64_t numerator;
+  uint64_t denominator;
+};
+
+std::deque<ClockSegment> clock_segments_ = {ClockSegment{Clock::QueryHostTickCount(), 0, 1, 1}};
+std::atomic<const ClockSegment*> clock_segment_{&clock_segments_.front()};
+// The largest guest time any reader has returned. No reader returns less, so a slower segment holds the clock
+// until it catches up rather than moving it back.
+std::atomic<uint64_t> guest_tick_floor_{0};
+
+uint64_t SegmentGuestTicks(const ClockSegment& segment, uint64_t host_tick_count) {
+  const uint64_t delta = host_tick_count > segment.host_base ? host_tick_count - segment.host_base : 0;
+  const uint64_t whole = delta / segment.denominator;
+  const uint64_t rest = delta % segment.denominator;
+  return segment.guest_base + whole * segment.numerator + rest * segment.numerator / segment.denominator;
+}
+
+uint64_t RaiseGuestTickFloor(uint64_t guest_tick_count) {
+  uint64_t floor = guest_tick_floor_.load(std::memory_order_acquire);
+  while (floor < guest_tick_count &&
+         !guest_tick_floor_.compare_exchange_weak(floor, guest_tick_count, std::memory_order_acq_rel,
+                                                  std::memory_order_acquire)) {
+  }
+  return std::max(floor, guest_tick_count);
+}
+
+}  // namespace
