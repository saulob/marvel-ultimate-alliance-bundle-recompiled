+bool UserProfile::display_name(uint32_t user_index, std::string* name) const {
+  std::string configured;
+  switch (user_index) {
+    case 0:
+      configured = REXCVAR_GET(local_player_1_name);
+      break;
+    case 1:
+      configured = REXCVAR_GET(local_player_2_name);
+      break;
+    case 2:
+      configured = REXCVAR_GET(local_player_3_name);
+      break;
+    case 3:
+      configured = REXCVAR_GET(local_player_4_name);
+      break;
+    default:
+      return false;
+  }
+  if (NormalizeUserDisplayName(configured, name)) {
+    return true;
+  }
+  if (user_index != 0) {
+    return false;
+  }
+  *name = name_;
+  return true;
+}
