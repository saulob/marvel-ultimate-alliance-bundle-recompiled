Defines rex::bit_scan_forward inline in math.h. The GPU plugin calls it in its per-draw loops (constant maps, render
target and texture bindings), and the out-of-line definition in the runtime DLL made each call go through the import
table. The runtime no longer exports it; this project's code does not call it.

diff --git a/include/rex/math.h b/include/rex/math.h
--- a/include/rex/math.h
+++ b/include/rex/math.h
@@ -166,9 +166,17 @@
 // BitScanForward (bsf).
 // Search the value from least significant bit (LSB) to the most significant bit
 // (MSB) for a set bit (1).
-// Returns false if no bits are set and the output index is invalid.
-bool bit_scan_forward(uint32_t v, uint32_t* out_first_set_index);
-bool bit_scan_forward(uint64_t v, uint32_t* out_first_set_index);
+// Returns false if no bits are set and the output index is invalid (all ones).
+// Inline: the GPU plugin calls it in its per-draw loops, and an out-of-line definition in the runtime DLL made every
+// call a call through the import table.
+inline bool bit_scan_forward(uint32_t v, uint32_t* out_first_set_index) {
+  *out_first_set_index = v ? static_cast<uint32_t>(std::countr_zero(v)) : UINT32_MAX;
+  return v != 0;
+}
+inline bool bit_scan_forward(uint64_t v, uint32_t* out_first_set_index) {
+  *out_first_set_index = v ? static_cast<uint32_t>(std::countr_zero(v)) : UINT32_MAX;
+  return v != 0;
+}
 inline bool bit_scan_forward(int32_t v, uint32_t* out_first_set_index) {
   return bit_scan_forward(static_cast<uint32_t>(v), out_first_set_index);
 }
