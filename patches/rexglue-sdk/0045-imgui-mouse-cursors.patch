+// The runtime renders ImGui draw lists itself and never reads the requested
+// cursor shape, so nothing would honor ImGui::SetMouseCursor. Apply it to the
+// OS cursor here; system cursors are created once and reused.
+void ApplyMouseCursor() {
+  static SDL_Cursor* cursors[ImGuiMouseCursor_COUNT] = {};
+  static ImGuiMouseCursor applied = ImGuiMouseCursor_COUNT;
+  if (ImGui::GetIO().ConfigFlags & ImGuiConfigFlags_NoMouseCursorChange) {
+    return;
+  }
+  ImGuiMouseCursor cursor = ImGui::GetMouseCursor();
+  if (cursor < 0 || cursor >= ImGuiMouseCursor_COUNT) {
+    cursor = ImGuiMouseCursor_Arrow;
+  }
+  if (cursor == applied) {
+    return;
+  }
+  static const SDL_SystemCursor kShapes[ImGuiMouseCursor_COUNT] = {
+      SDL_SYSTEM_CURSOR_DEFAULT,     SDL_SYSTEM_CURSOR_TEXT,        SDL_SYSTEM_CURSOR_MOVE,
+      SDL_SYSTEM_CURSOR_NS_RESIZE,   SDL_SYSTEM_CURSOR_EW_RESIZE,   SDL_SYSTEM_CURSOR_NESW_RESIZE,
+      SDL_SYSTEM_CURSOR_NWSE_RESIZE, SDL_SYSTEM_CURSOR_POINTER,     SDL_SYSTEM_CURSOR_WAIT,
+      SDL_SYSTEM_CURSOR_PROGRESS,    SDL_SYSTEM_CURSOR_NOT_ALLOWED,
+  };
+  if (!cursors[cursor]) {
+    cursors[cursor] = SDL_CreateSystemCursor(kShapes[cursor]);
+  }
+  if (cursors[cursor]) {
+    SDL_SetCursor(cursors[cursor]);
+    applied = cursor;
+  }
+}
