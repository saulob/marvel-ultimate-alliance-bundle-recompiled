DEBUG_SAULO, temporary: mua_debug_draw_fastpath_stats (off by default) adds one line to the 10 s GPU work summary with
the command processor's time per draw split into phases (setup and primitives, render targets, pipeline, textures,
fixed-function and system constants, bindings, residency and recording) and, per frame, the pipeline, root signature and
index buffer binds, the constant buffers written, the shared memory requests, uploads, streamed and unchanged pages and
watch arms, the texture loads, the resource barriers, and the guest faults on watched pages with the time their handler
takes. The counters are plain fields on the command processor thread, read behind one flag latched at each summary
window; the fault count and time are running perf counters the access violation handler always adds to, since a
fault costs microseconds.

diff --git a/include/rex/graphics/draw_fastpath_stats.h b/include/rex/graphics/draw_fastpath_stats.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/draw_fastpath_stats.h
@@ -0,0 +1,89 @@
+// DEBUG_SAULO, temporary: per-draw work counters for mua_debug_draw_fastpath_stats, logged with the 10 s GPU work
+// summary. Only the command processor thread touches them, and only while the cvar is on.
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::graphics {
+
+enum class DrawPhase : uint32_t {
+  kSetup,
+  kRenderTargets,
+  kPipeline,
+  kTextures,
+  kState,
+  kBindings,
+  kRecord,
+  kCount,
+};
+
+struct DrawFastpathStats {
+  bool enabled = false;
+  std::array<uint64_t, size_t(DrawPhase::kCount)> phase_ns{};
+  uint64_t draws = 0;
+  uint64_t indexed_draws = 0;
+  uint64_t index_buffer_binds = 0;
+  uint64_t pipeline_binds = 0;
+  uint64_t root_signature_binds = 0;
+  // System, vertex float, pixel float, bool and loop, fetch, descriptor indices.
+  std::array<uint64_t, 6> constant_buffer_writes{};
+  uint64_t range_requests = 0;
+  uint64_t range_requests_valid = 0;
+  uint64_t uploads = 0;
+  uint64_t uploaded_pages = 0;
+  uint64_t streamed_page_uploads = 0;
+  uint64_t streamed_pages_unchanged = 0;
+  uint64_t watch_arms = 0;
+  uint64_t texture_loads = 0;
+  uint64_t barrier_batches = 0;
+  uint64_t barriers = 0;
+  int64_t window_first_faults = 0;
+  int64_t window_first_fault_ns = 0;
+};
+
+inline DrawFastpathStats g_draw_fastpath_stats;
+
+inline void CountDrawStat(uint64_t& counter, uint64_t amount = 1) {
+  if (g_draw_fastpath_stats.enabled) [[unlikely]] {
+    counter += amount;
+  }
+}
+
+// Adds the time from one Enter to the next, and to the end of the draw, to the phase entered.
+class DrawPhaseClock {
+ public:
+  DrawPhaseClock() {
+    if (g_draw_fastpath_stats.enabled) [[unlikely]] {
+      stats_ = &g_draw_fastpath_stats;
+      ++stats_->draws;
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~DrawPhaseClock() { Enter(DrawPhase::kCount); }
+  DrawPhaseClock(const DrawPhaseClock&) = delete;
+  DrawPhaseClock& operator=(const DrawPhaseClock&) = delete;
+
+  void Enter(DrawPhase phase) {
+    if (!stats_) [[likely]] {
+      return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (phase_ != DrawPhase::kCount) {
+      stats_->phase_ns[size_t(phase_)] +=
+          uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now - start_).count());
+    }
+    start_ = now;
+    phase_ = phase;
+  }
+
+ private:
+  DrawFastpathStats* stats_ = nullptr;
+  DrawPhase phase_ = DrawPhase::kSetup;
+  std::chrono::steady_clock::time_point start_{};
+};
+
+}  // namespace rex::graphics
