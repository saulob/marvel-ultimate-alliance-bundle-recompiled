diff --git a/src/core/mutex.cpp b/src/core/mutex.cpp
--- a/src/core/mutex.cpp
+++ b/src/core/mutex.cpp
@@ -9,13 +9,37 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <rex/assert.h>
 #include <rex/thread/mutex.h>
 
 namespace rex::thread {
 
+namespace {
+
+constexpr uint64_t kMsrExternalInterruptEnable = 0x8000;
+
+thread_local int32_t guest_interrupt_lock_depth = 0;
+
+}  // namespace
+
 std::recursive_mutex& global_critical_region::mutex() {
   static std::recursive_mutex global_mutex;
   return global_mutex;
 }
 
+uint64_t GuestInterruptMsr() {
+  return guest_interrupt_lock_depth ? 0 : kMsrExternalInterruptEnable;
+}
+
+void EnterGuestInterruptLock() {
+  global_critical_region::mutex().lock();
+  ++guest_interrupt_lock_depth;
+}
+
+void LeaveGuestInterruptLock() {
+  assert_true(guest_interrupt_lock_depth > 0);
+  --guest_interrupt_lock_depth;
+  global_critical_region::mutex().unlock();
+}
+
 }  // namespace rex::thread
