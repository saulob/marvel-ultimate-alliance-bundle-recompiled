Adapted from patches/rexglue-sdk/0050-d3d12-unchanged-constant-writes.windows.patch in geometry-wars-retro-evolved-2-recompiled
(originally Crackdown Recompiled PR #13). D3D12 command processor only; the same code runs on the host render target and the
ROV path. Float, bool, loop and fetch constants rewritten with the values they already hold keep the uploaded constant buffers,
texture bindings and the sampler memo (gpu_skip_unchanged_constant_writes, on by default); vertex buffer residency is still
invalidated for every fetch constant write, since the game may have rewritten the vertex data at the same address.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 54d80f6..e0be3b9 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -73,10 +73,27 @@ REXCVAR_DEFINE_UINT32(d3d12_async_submission_draws, 2000, "GPU/D3D12",
                       "(0 = only where it already ends)")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(gpu_skip_unchanged_constant_writes, true, "GPU",
+                    "Keep the uploaded constant buffers, texture bindings and sampler state when the "
+                    "game rewrites float, bool, loop or fetch constants with the values they have")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 namespace rex::graphics::d3d12 {
 
 namespace {
 
+// Returns whether any stored value changed; branch-free so it vectorizes like memory::copy_and_swap.
+bool StoreSwappedRegisters(uint32_t* __restrict dest, const uint32_t* __restrict src,
+                           uint32_t count) {
+  uint32_t difference = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t value = rex::byte_swap(src[i]);
+    difference |= dest[i] ^ value;
+    dest[i] = value;
+  }
+  return difference != 0;
+}
