+// ResolveRectFor for a resolve of any format: 64bpp resolves count their base and pitch in 40-sample half-tiles.
+inline ResolveRect SurfaceRectFor(uint32_t base_tiles, uint32_t original_base, uint32_t pitch_tiles, bool is_64bpp,
+                                  uint32_t sample_count_log2_x, uint32_t sample_count_log2_y,
+                                  uint32_t edram_offset_x_div_8, uint32_t edram_offset_y_div_8, uint32_t width_div_8,
+                                  uint32_t height_div_8) {
+  const uint32_t shift = uint32_t(is_64bpp);
+  return ResolveRectFor(original_base + (((base_tiles - original_base) & (kTileCount - 1)) >> shift), original_base,
+                        pitch_tiles >> shift, sample_count_log2_x, sample_count_log2_y, edram_offset_x_div_8,
+                        edram_offset_y_div_8, width_div_8, height_div_8, 0, 0);
+}
+
+// What scene_edram_stretch.cs.hlsl needs to stretch a resolve rectangle of a surface drawn at a smaller scale.
+struct StretchLayout {
+  uint32_t base_dwords = 0;
+  uint32_t pitch_dwords = 0;
+  // 0: 32bpp color, 1: 64bpp color, 2: depth.
+  uint32_t layout = 0;
+  // Host pixels from the surface's origin.
+  uint32_t rect_origin[2] = {};
+  uint32_t rect_size[2] = {};
+};
+
+inline StretchLayout StretchLayoutFor(uint32_t base_tiles, uint32_t original_base, uint32_t pitch_tiles, bool depth,
+                                      bool is_64bpp, uint32_t sample_count_log2_x, uint32_t sample_count_log2_y,
+                                      uint32_t edram_offset_x_div_8, uint32_t edram_offset_y_div_8,
+                                      uint32_t width_div_8, uint32_t height_div_8, uint32_t scale_x,
+                                      uint32_t scale_y) {
+  const ResolveRect rect =
+      SurfaceRectFor(base_tiles, original_base, pitch_tiles, is_64bpp && !depth, sample_count_log2_x,
+                     sample_count_log2_y, edram_offset_x_div_8, edram_offset_y_div_8, width_div_8, height_div_8);
+  const uint32_t tile_dwords = kTileWidthSamples * scale_x * kTileHeightSamples * scale_y;
+  StretchLayout layout;
+  layout.base_dwords = original_base * tile_dwords;
+  layout.pitch_dwords = std::max(pitch_tiles, uint32_t(1)) * tile_dwords;
+  layout.layout = depth ? 2 : uint32_t(is_64bpp);
+  layout.rect_origin[0] = uint32_t(rect.edram_x) * scale_x;
+  layout.rect_origin[1] = uint32_t(rect.edram_y) * scale_y;
+  layout.rect_size[0] = rect.width * scale_x;
+  layout.rect_size[1] = rect.height * scale_y;
+  return layout;
+}
+
+// scene_edram_stretch.cs.hlsl's SampleAddress: the EDRAM dword of a sample, in samples from the surface's origin.
+inline uint32_t StretchSampleAddress(const StretchLayout& layout, uint32_t scale_x, uint32_t scale_y,
+                                     uint32_t sample_x, uint32_t sample_y) {
+  const uint32_t tile_width = kTileWidthSamples * scale_x, tile_height = kTileHeightSamples * scale_y;
+  const uint32_t tile_dwords = tile_width * tile_height;
+  uint32_t offset;
+  if (layout.layout == 1) {
+    const uint32_t half_width = tile_width >> 1;
+    offset = sample_y / tile_height * layout.pitch_dwords + sample_x / half_width * tile_dwords +
+             sample_y % tile_height * tile_width + sample_x % half_width * 2;
+  } else {
+    uint32_t in_x = sample_x % tile_width;
+    if (layout.layout == 2) {
+      in_x = in_x >= tile_width / 2 ? in_x - tile_width / 2 : in_x + tile_width / 2;
+    }
+    offset = sample_y / tile_height * layout.pitch_dwords + sample_x / tile_width * tile_dwords +
+             sample_y % tile_height * tile_width + in_x;
+  }
+  const uint32_t address = layout.base_dwords + offset;
+  const uint32_t edram_dwords = kTileCount * tile_dwords;
+  return address >= edram_dwords ? address - edram_dwords : address;
+}
+
+// The whole resolution scale the targets drawn before the scene use with DLSS: the smallest one with at least the
+// scene's detail, or output_scale when that leaves nothing to save.
+inline uint32_t PreSceneScale(uint32_t render_size, uint32_t guest_size, uint32_t output_scale) {
+  if (!guest_size) {
+    return output_scale;
+  }
+  return std::clamp((render_size + guest_size - 1) / guest_size, uint32_t(1), std::max(output_scale, uint32_t(1)));
+}
+
+// The host pixel of a draw at scale holding what the full-scale host pixel shows: each guest pixel covers scale instead
+// of output_scale host pixels, from the EDRAM origin (scene_edram_stretch.cs.hlsl).
+inline uint32_t ReducedPixel(uint32_t pixel, uint32_t scale, uint32_t output_scale) {
+  return pixel * scale / output_scale;
+}
+
+// Surfaces the game draws into before its 3D scene in a frame, such as shadow maps, whose textures nothing samples
+// after the scene: only the scene uses them, and DLSS renders it smaller, so they're drawn at PreSceneScale. A surface
+// is a pitch and a sample count, which the color and depth targets of a pass share. Changes take effect between
+// frames only, so all draws and resolves of a surface in a frame agree.
+class PreSceneTargets {
+ public:
+  static constexpr uint32_t kFramesToReduce = 3;
+  static constexpr size_t kMaxSurfaces = 32;
+
+  struct Surface {
+    uint32_t key = 0;
+    uint32_t frames_before = 0;
+    bool drawn_before = false;
+    bool drawn_after = false;
+    bool sampled_after = false;
+    bool reduced = false;
+    // Drawn into or sampled after the scene once: stays at the output scale.
+    bool kept = false;
+  };
+
+  static uint32_t Key(uint32_t surface_pitch, uint32_t msaa_samples_log2) {
+    return surface_pitch | msaa_samples_log2 << 16;
+  }
+  static uint32_t Pitch(uint32_t key) { return key & 0xFFFF; }
+  static uint32_t SamplesLog2(uint32_t key) { return key >> 16; }
+
+  // A draw that isn't part of the scene.
+  void NoteDraw(uint32_t key, bool after_scene) {
+    if (Surface* surface = Find(key, true)) {
+      (after_scene ? surface->drawn_after : surface->drawn_before) = true;
+    }
+  }
+  // A draw after the scene sampled a texture resolved from the surface.
+  void NoteSampledAfterScene(uint32_t key) {
+    if (Surface* surface = Find(key, false)) {
+      surface->sampled_after = true;
+    }
+  }
+  // Only frames that drew the scene tell what comes before it. Returns whether a surface changed.
+  bool EndFrame(bool scene_drawn, uint32_t scene_key) {
+    bool changed = false;
+    for (Surface& surface : surfaces_) {
+      if (scene_drawn) {
+        const bool was_reduced = surface.reduced;
+        if (surface.key == scene_key || Pitch(surface.key) == 0 || surface.drawn_after || surface.sampled_after) {
+          changed |= !surface.kept;
+          surface.kept = true;
+          surface.reduced = false;
+        } else if (surface.drawn_before && !surface.kept && ++surface.frames_before >= kFramesToReduce) {
+          surface.reduced = true;
+        }
+        changed |= surface.reduced != was_reduced;
+      }
+      surface.drawn_before = surface.drawn_after = surface.sampled_after = false;
+    }
+    return changed;
+  }
+  bool IsReduced(uint32_t key) const {
+    for (const Surface& surface : surfaces_) {
+      if (surface.key == key) {
+        return surface.reduced;
+      }
+    }
+    return false;
+  }
+  const std::vector<Surface>& surfaces() const { return surfaces_; }
+
+ private:
+  Surface* Find(uint32_t key, bool add) {
+    for (Surface& surface : surfaces_) {
+      if (surface.key == key) {
+        return &surface;
+      }
+    }
+    if (!add || surfaces_.size() >= kMaxSurfaces) {
+      return nullptr;
+    }
+    surfaces_.push_back({});
+    surfaces_.back().key = key;
+    return &surfaces_.back();
+  }
+
+  std::vector<Surface> surfaces_;
+};
