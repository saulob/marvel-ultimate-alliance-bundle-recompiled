+  if (scene_drawn_ && !other_resolves_.empty()) {
+    NoteSampledAfterScene(regs, vertex_shader);
+    if (pixel_shader) {
+      NoteSampledAfterScene(regs, *pixel_shader);
+    }
+  }
+  if (pre_scene_frame_ && pre_scene_targets_.IsReduced(key)) {
+    adjustment.scale_x = float(pre_scene_scale_x_) / float(resolution_scale_x_);
+    adjustment.scale_y = float(pre_scene_scale_y_) / float(resolution_scale_y_);
+  }
+}
+
+void SceneUpscaler::NoteSampledAfterScene(const RegisterFile& regs, const Shader& shader) {
+  for (const Shader::TextureBinding& binding : shader.texture_bindings()) {
+    const uint32_t address = (regs.GetTextureFetch(binding.fetch_constant).base_address << 12) & kPhysicalAddressMask;
+    for (const OtherResolve& resolve : other_resolves_) {
+      if (address >= resolve.address_begin && address < resolve.address_end) {
+        pre_scene_targets_.NoteSampledAfterScene(resolve.key);
+      }
+    }
+  }
+}
