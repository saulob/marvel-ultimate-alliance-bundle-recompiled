diff --git a/src/graphics/shaders/scene_edram_stretch.cs.hlsl b/src/graphics/shaders/scene_edram_stretch.cs.hlsl
new file mode 100644
index 0000000..12a7579
--- /dev/null
+++ b/src/graphics/shaders/scene_edram_stretch.cs.hlsl
@@ -0,0 +1,61 @@
+// Copies a resolve rectangle of a surface that draws filled at a smaller resolution scale from the EDRAM to a buffer
+// laid out like it, stretched to the full scale (each sample from the nearest smaller-scale pixel), at the same
+// addresses, for the resolve to copy from instead. From src/graphics/shaders, then without trailing spaces:
+//   fxc /nologo /T cs_5_1 /O3 /E main /Vn scene_edram_stretch_cs /Fh bytecode/d3d12_5_1/scene_edram_stretch_cs.h
+//       scene_edram_stretch.cs.hlsl
+
+#include "scene_upscaler.hlsli"
+
+cbuffer constants : register(b0) {
+  uint base_dwords;
+  uint pitch_dwords;
+  uint edram_size_dwords;
+  // 0: 32bpp color, 1: 64bpp color, 2: depth.
+  uint layout;
+
+  uint tile_width;
+  uint tile_height;
+  uint sample_count_log2_x;
+  uint sample_count_log2_y;
+
+  // Host pixels from the surface's origin.
+  uint2 rect_origin;
+  uint2 rect_size;
+
+  // Host pixels per guest pixel the draws used, and the resolution scale.
+  uint2 draw_scale;
+  uint2 output_scale;
+};
+
+ByteAddressBuffer edram : register(t0);
+RWByteAddressBuffer stretched : register(u0);
+
+uint SampleAddress(uint2 sample_position) {
+  uint offset = layout == 1u
+                    ? XeSceneEdram64bppSampleOffset(sample_position, tile_width, tile_height, pitch_dwords)
+                    : XeSceneEdramSampleOffset(sample_position, tile_width, tile_height, pitch_dwords, layout == 2u);
+  return XeSceneEdramWrap(base_dwords + offset, edram_size_dwords);
+}
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= rect_size)) {
+    return;
+  }
+  uint2 sample_count_log2 = uint2(sample_count_log2_x, sample_count_log2_y);
+  uint2 pixel = rect_origin + id.xy;
+  uint2 source_pixel = pixel * draw_scale / output_scale;
+  [unroll] for (uint i = 0u; i < 4u; ++i) {
+    uint2 sample_index = uint2(i & 1u, i >> 1u);
+    if (any(sample_index >= (1u << sample_count_log2))) {
+      continue;
+    }
+    uint dest = SampleAddress((pixel << sample_count_log2) + sample_index);
+    uint source = SampleAddress((source_pixel << sample_count_log2) + sample_index);
+    if (layout == 1u) {
+      stretched.Store2(dest << 2u, edram.Load2(source << 2u));
+    } else {
+      stretched.Store(dest << 2u, edram.Load(source << 2u));
+    }
+  }
+}
diff --git a/src/graphics/shaders/scene_upscaler.hlsli b/src/graphics/shaders/scene_upscaler.hlsli
index 60bbacd..cd5cab3 100644
--- a/src/graphics/shaders/scene_upscaler.hlsli
+++ b/src/graphics/shaders/scene_upscaler.hlsli
@@ -14,6 +14,15 @@ uint XeSceneEdramSampleOffset(uint2 sample_position, uint tile_width, uint tile_
   return tile.y * pitch_dwords + tile.x * (tile_width * tile_height) + in_tile.y * tile_width + in_tile.x;
 }
 
+// 64bpp color: tile_width x tile_height dwords hold 40 x 16 samples (times the resolution scale) of 2 dwords each, and
+// pitch_dwords is twice the 32bpp one.
+uint XeSceneEdram64bppSampleOffset(uint2 sample_position, uint tile_width, uint tile_height, uint pitch_dwords) {
+  uint2 half_tile = uint2(tile_width >> 1, tile_height);
+  uint2 tile = sample_position / half_tile;
+  uint2 in_tile = sample_position - tile * half_tile;
+  return tile.y * pitch_dwords + tile.x * (tile_width * tile_height) + in_tile.y * tile_width + in_tile.x * 2u;
+}
+
 uint XeSceneEdramWrap(uint address, uint edram_size_dwords) {
   return address >= edram_size_dwords ? address - edram_size_dwords : address;
 }
