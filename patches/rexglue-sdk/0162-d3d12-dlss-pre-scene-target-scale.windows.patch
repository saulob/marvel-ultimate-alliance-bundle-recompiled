+// A resolve into memory an earlier one of another surface wrote replaces that texture.
+void SceneUpscaler::NoteResolveDest(const RegisterFile& regs, const draw_util::ResolveInfo& resolve_info,
+                                    uint32_t key, bool other) {
+  OtherResolve resolve;
+  resolve.key = key;
+  resolve.address_begin =
+      std::min(regs[XE_GPU_REG_RB_COPY_DEST_BASE] & kPhysicalAddressMask, resolve_info.copy_dest_extent_start);
+  resolve.address_end = resolve_info.copy_dest_extent_start + resolve_info.copy_dest_extent_length;
+  std::erase_if(other_resolves_, [&](const OtherResolve& known) {
+    return known.key != key && known.address_begin < resolve.address_end &&
+           resolve.address_begin < known.address_end;
+  });
+  if (!other) {
+    return;
+  }
+  for (OtherResolve& known : other_resolves_) {
+    if (known.key == key && known.address_begin == resolve.address_begin) {
+      known.address_end = std::max(known.address_end, resolve.address_end);
+      return;
+    }
+  }
+  if (other_resolves_.size() < kMaxOtherResolves) {
+    other_resolves_.push_back(resolve);
+  } else {
+    other_resolves_[other_resolves_next_++ % kMaxOtherResolves] = resolve;
+  }
+}
