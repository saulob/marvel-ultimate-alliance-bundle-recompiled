+ID3D12Resource* SceneUpscaler::StretchPreSceneResolve(const draw_util::ResolveInfo& resolve_info) {
+  const bool depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info = depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const bool is_64bpp = !depth && edram_info.format_is_64bpp;
+  const uint32_t log2_x = uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k4X);
+  const uint32_t log2_y = uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  const scene::StretchLayout layout = scene::StretchLayoutFor(
+      edram_info.base_tiles, depth ? resolve_info.depth_original_base : resolve_info.color_original_base,
+      edram_info.pitch_tiles, depth, is_64bpp, log2_x, log2_y, resolve_info.coordinate_info.edram_offset_x_div_8,
+      resolve_info.coordinate_info.edram_offset_y_div_8, resolve_info.coordinate_info.width_div_8,
+      resolve_info.height_div_8, resolution_scale_x_, resolution_scale_y_);
+  StretchConstants constants = {};
+  constants.base_dwords = layout.base_dwords;
+  constants.pitch_dwords = layout.pitch_dwords;
+  constants.layout = layout.layout;
+  constants.tile_width = kEdramTileWidth * resolution_scale_x_;
+  constants.tile_height = kEdramTileHeight * resolution_scale_y_;
+  constants.edram_size_dwords = xenos::kEdramTileCount * constants.tile_width * constants.tile_height;
+  constants.sample_count_log2_x = log2_x;
+  constants.sample_count_log2_y = log2_y;
+  std::copy(std::begin(layout.rect_origin), std::end(layout.rect_origin), constants.rect_origin);
+  std::copy(std::begin(layout.rect_size), std::end(layout.rect_size), constants.rect_size);
+  constants.draw_scale[0] = pre_scene_scale_x_;
+  constants.draw_scale[1] = pre_scene_scale_y_;
+  constants.output_scale[0] = resolution_scale_x_;
+  constants.output_scale[1] = resolution_scale_y_;
+  render_target_cache_.PrepareEdramBufferForComputeRead();
+  Transition(staging_, staging_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  Dispatch(stretch_pipeline_, &constants, sizeof(constants) / sizeof(uint32_t), {nullptr, nullptr},
+           {DXGI_FORMAT_UNKNOWN, DXGI_FORMAT_UNKNOWN}, {staging_, nullptr}, {DXGI_FORMAT_UNKNOWN, DXGI_FORMAT_UNKNOWN},
+           constants.rect_size[0], constants.rect_size[1]);
+  Transition(staging_, staging_state_, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  return staging_;
+}
