+void SceneUpscaler::LogPreSceneTargets() const {
+  std::string reduced, kept;
+  for (const scene::PreSceneTargets::Surface& surface : pre_scene_targets_.surfaces()) {
+    if (surface.key == scene_key_ || !scene::PreSceneTargets::Pitch(surface.key) ||
+        (!surface.reduced && !surface.kept)) {
+      continue;
+    }
+    std::string& list = surface.reduced ? reduced : kept;
+    list += (list.empty() ? "" : ", ") + SurfaceText(surface.key);
+  }
+  REXGPU_INFO("DLSS: targets drawn before the scene at {}: {} | kept at {} (drawn into or sampled after the scene): {}",
+              ScaleText(pre_scene_scale_x_, pre_scene_scale_y_), reduced.empty() ? "none" : reduced,
+              ScaleText(resolution_scale_x_, resolution_scale_y_), kept.empty() ? "none" : kept);
+}
