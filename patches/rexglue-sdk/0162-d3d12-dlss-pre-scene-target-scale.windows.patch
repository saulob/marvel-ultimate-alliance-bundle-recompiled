+void SceneUpscaler::NoteOtherDraw(const RegisterFile& regs, const Shader& vertex_shader, const Shader* pixel_shader,
+                                  DrawAdjustment& adjustment) {
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const uint32_t key = scene::PreSceneTargets::Key(surface_info.surface_pitch, uint32_t(surface_info.msaa_samples));
