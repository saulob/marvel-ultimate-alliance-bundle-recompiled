+    if (!visible_) return;
+    ImGui::PopStyleVar();
+    ImGui::PopStyleColor();
+  }
+  PanelBorder(const PanelBorder&) = delete;
+  PanelBorder& operator=(const PanelBorder&) = delete;
+  ImGuiChildFlags flags() const { return visible_ ? ImGuiChildFlags_Borders : ImGuiChildFlags_None; }
+
+ private:
+  bool visible_;
+};
