+bool Launcher::PageVisible(int index) const {
+  const Page& page = config_.pages[size_t(index)];
+  return !page.visible || page.visible();
+}
+
+void Launcher::EnsureVisiblePage() {
+  if (config_.pages.empty() || PageVisible(page_)) return;
+  for (int i = 0; i < int(config_.pages.size()); ++i) {
+    if (!PageVisible(i)) continue;
+    page_ = i;
+    ui_.capturing_.clear();
+    return;
+  }
+}
