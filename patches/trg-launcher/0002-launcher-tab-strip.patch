+void Launcher::DrawTabStrip(ImVec2 origin, float width, float height) {
+  const Theme& t = config_.theme;
+  const TabStrip& strip = config_.tab_strip;
+  const int count = int(strip.tabs.size());
+  const int selected = strip.selected ? strip.selected() : 0;
+  const float gap = 8 * s_;
+  const float pad = 16 * s_;
+  const float tab_w = (width - gap * float(count - 1)) / float(count);
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  ImGui::PushFont(config_.fonts.semibold, 0.0f);
+  for (int i = 0; i < count; ++i) {
+    const Tab& tab = strip.tabs[size_t(i)];
+    const ImVec2 min(origin.x + float(i) * (tab_w + gap), origin.y);
+    const ImVec2 max(min.x + tab_w, min.y + height);
+    ImGui::PushID(i);
+    ImGui::SetCursorScreenPos(min);
+    const bool clicked = ImGui::InvisibleButton("##tab", ImVec2(tab_w, height));
+    const bool hot = ImGui::IsItemHovered();
+    ImGui::PopID();
+    const bool active = i == selected;
+    dl->AddRectFilled(min, max, Col(active ? t.accent : hot ? t.frame_hot : t.frame), 8 * s_);
+    const bool fits = ImGui::CalcTextSize(tab.label.c_str()).x + pad * 2 <= tab_w;
+    const std::string& label = fits || tab.short_label.empty() ? tab.label : tab.short_label;
+    const ImVec2 text = ImGui::CalcTextSize(label.c_str());
+    dl->PushClipRect(min, max, true);
+    dl->AddText(ImVec2(min.x + std::max(pad * 0.5f, (tab_w - text.x) * 0.5f), min.y + (height - text.y) * 0.5f),
+                Col(active ? t.on_accent : t.text), label.c_str());
+    dl->PopClipRect();
+    if (clicked && !active && strip.select) strip.select(i);
+  }
+  ImGui::PopFont();
+}
